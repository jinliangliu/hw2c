{#
    pid_ctrl_component.c.j2 - Generic process-variable PID control component
    (opt-in middleware)

    Consumes any I2C process-variable feedback (pressure / temperature / ...),
    runs a position-form PID (pid_math) and drives a PWM actuator:
      pwm_single: one channel, output 0..100% (solenoid duty / heater power)
      pwm_dual:   heat + cool channels, output -100..100 with deadband
    Stage machine: STANDBY -> RAMP_UP -> HOLD (+ FAULT interlocks).

    Component config:
        feedback.source: <sensor peripheral name>
        feedback.unit:   "kPa" | "degC" | ...
        feedback.topic:  optional pub/sub topic for the process value
        actuator.mode:   pwm_single | pwm_dual
        actuator.pwm / actuator.channel                 (single mode)
        actuator.heat_pwm / heat_channel / cool_pwm / cool_channel (dual)
        control.period_ms / hysteresis / stuck_reads /
        control.deadband_pct / control.target_min

    Runtime params (params.yaml; new names, old pressure names fall back):
        pid_kp / pid_ki / pid_kd
        pid_target        (old: target_pressure_kpa)
        pid_max_value     (old: pressure_max_kpa)
        pid_duty_min_pct / pid_duty_max_pct / pid_ramp_timeout_ms
#}
{% set fb_cfg = comp_config.get('feedback', {}) %}
{% set act_cfg = comp_config.get('actuator', {}) %}
{% set ctl_cfg = comp_config.get('control', {}) %}
{% set fb_peri = peripherals | selectattr('name', 'eq', fb_cfg.get('source', '')) | first %}
{% if not fb_peri %}
{% set fb_peri = peripherals | selectattr('type', 'eq', 'I2C_Pressure') | first %}
{% endif %}
{% set pwm_peri = peripherals | selectattr('type', 'eq', 'Internal_PWM') | first %}
{% set mode = act_cfg.get('mode', 'pwm_single') %}
{% set fb_unit = fb_cfg.get('unit', fb_peri.get('extra', {}).get('unit', 'kPa') if fb_peri else '') %}
{% set pub_topic = fb_cfg.get('topic', '') %}
{% set heat_pwm = act_cfg.get('heat_pwm', act_cfg.get('pwm', pwm_peri.name if pwm_peri else '')) %}
{% set cool_pwm = act_cfg.get('cool_pwm', '') %}
{% set heat_ch = act_cfg.get('heat_channel', act_cfg.get('channel', 1)) %}
{% set cool_ch = act_cfg.get('cool_channel', 2) %}
{% set control_period_ms = ctl_cfg.get('period_ms', comp_config.get('control_period_ms', 62)) %}
{% set hold_hyst = ctl_cfg.get('hysteresis', comp_config.get('hysteresis_kpa', 0.5)) %}
{% set stuck_reads = ctl_cfg.get('stuck_reads', comp_config.get('stuck_reads', 8)) %}
{% set deadband_pct = ctl_cfg.get('deadband_pct', 5) %}
{% set target_min = ctl_cfg.get('target_min', 0) %}
{% set reached_evt = events | selectattr('name', 'eq', 'TARGET_REACHED') | first %}
{% if not reached_evt %}
{% set reached_evt = events | selectattr('name', 'eq', 'PRESSURE_REACHED') | first %}
{% endif %}
{% set fault_evt = events | selectattr('name', 'eq', 'FAULT_TRIPPED') | first %}
{% set has_pub_topic = pub_topic and (topics | selectattr('name', 'eq', pub_topic) | list | length > 0) %}
{% set pub_topic_typed = pub_topic and (topics | selectattr('name', 'eq', pub_topic) | selectattr('value.type', 'defined') | list | length > 0) %}
{% set p_target = params | selectattr('name', 'eq', 'pid_target') | first %}
{% if not p_target %}
{% set p_target = params | selectattr('name', 'eq', 'target_pressure_kpa') | first %}
{% endif %}
{% set p_max = params | selectattr('name', 'eq', 'pid_max_value') | first %}
{% if not p_max %}
{% set p_max = params | selectattr('name', 'eq', 'pressure_max_kpa') | first %}
{% endif %}
{% set p_ramp = params | selectattr('name', 'eq', 'pid_ramp_timeout_ms') | first %}
{% if not p_ramp %}
{% set p_ramp = params | selectattr('name', 'eq', 'ramp_timeout_ms') | first %}
{% endif %}

#include "component_registry.h"
#include "pid_math.h"
#include "param_registry.h"
{% if fb_peri %}
#include "drv_{{ fb_peri.name }}.h"
{% endif %}
{% if heat_pwm %}
#include "drv_{{ heat_pwm }}.h"
{% endif %}
{% if cool_pwm %}
#include "drv_{{ cool_pwm }}.h"
{% endif %}
{% if has_pub_topic %}
#include "component_bus.h"
{% endif %}
{% if reached_evt or fault_evt %}
#include "event_mgr.h"
{% endif %}
#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#include "drv_log.h"
{% if reached_evt or fault_evt %}
#include "event_mgr.h"
{% endif %}
#endif
#include <stddef.h>

/* ---- Generic process-control stage machine ---- */
typedef enum {
    PID_STAGE_STANDBY = 0,
    PID_STAGE_RAMP_UP,
    PID_STAGE_HOLD,
    PID_STAGE_FAULT
} pid_stage_t;

/* ---- Fault codes (posted via FAULT_TRIPPED when the contract exists) ---- */
#define PID_FAULT_NONE         0u
#define PID_FAULT_OVP          1u   /* process value exceeded pid_max_value */
#define PID_FAULT_SENSOR       2u   /* repeated sensor read failures        */
#define PID_FAULT_RAMP_TIMEOUT 3u   /* target not reached in ramp_timeout   */

/* ---- Component-private context ---- */
struct {{ comp_name }}_ctx {
    uint8_t  initialized;
    pid_t    pid;
    pid_stage_t stage;
    uint32_t fault;
    float    process_value;
    float    setpoint;
    uint32_t heat_duty;
    uint32_t cool_duty;
    uint32_t ramp_start_ms;
    uint32_t read_failures;
    uint32_t ramp_timeout_ms;
    uint32_t duty_min;
    uint32_t duty_max;
    float    hold_hysteresis;
    uint32_t events;
};

static struct {{ comp_name }}_ctx g_pid_ctx;

/* ---- init: load params (P2 typed accessors), configure PID ---- */
int {{ comp_name }}_init(component_t *c, void *cfg)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    (void)cfg;

{% if params | selectattr('name', 'eq', 'pid_kp') %}
    float kp = param_pid_kp_get();
{% else %}
    float kp = 8.0f;
{% endif %}
{% if params | selectattr('name', 'eq', 'pid_ki') %}
    float ki = param_pid_ki_get();
{% else %}
    float ki = 0.8f;
{% endif %}
{% if params | selectattr('name', 'eq', 'pid_kd') %}
    float kd = param_pid_kd_get();
{% else %}
    float kd = 0.0f;
{% endif %}

{% if mode == 'pwm_dual' %}
    pid_init(&ctx->pid, kp, ki, kd,
             (float){{ control_period_ms }} / 1000.0f, -100.0f, 100.0f);
{% else %}
    pid_init(&ctx->pid, kp, ki, kd,
             (float){{ control_period_ms }} / 1000.0f, 0.0f, 100.0f);
{% endif %}
    ctx->pid.i_clamp = 60.0f;       /* extra integral clamp (percent) */
    ctx->pid.d_alpha = 0.35f;       /* derivative low-pass (noisy ADC) */
    ctx->pid.setpoint_rate = 20.0f; /* unit per second, anti-kick ramp   */

    ctx->stage           = PID_STAGE_STANDBY;
    ctx->fault           = PID_FAULT_NONE;
    ctx->process_value   = 0.0f;
    ctx->setpoint        = 0.0f;
    ctx->heat_duty       = 0;
    ctx->cool_duty       = 0;
    ctx->ramp_start_ms   = 0;
    ctx->read_failures   = 0;
    ctx->events          = 0;
    ctx->hold_hysteresis = {{ hold_hyst }}f;
{% if p_ramp %}
{% if p_ramp.name == 'pid_ramp_timeout_ms' %}
    ctx->ramp_timeout_ms = param_pid_ramp_timeout_ms_get();
{% else %}
    ctx->ramp_timeout_ms = param_ramp_timeout_ms_get();
{% endif %}
{% else %}
    ctx->ramp_timeout_ms = 30000U;
{% endif %}
{% if params | selectattr('name', 'eq', 'pid_duty_min_pct') %}
    ctx->duty_min = param_pid_duty_min_pct_get();
{% elif params | selectattr('name', 'eq', 'duty_min_pct') %}
    ctx->duty_min = param_duty_min_pct_get();
{% else %}
    ctx->duty_min = 5U;
{% endif %}
{% if params | selectattr('name', 'eq', 'pid_duty_max_pct') %}
    ctx->duty_max = param_pid_duty_max_pct_get();
{% elif params | selectattr('name', 'eq', 'duty_max_pct') %}
    ctx->duty_max = param_duty_max_pct_get();
{% else %}
    ctx->duty_max = 100U;
{% endif %}
    ctx->initialized = 1;
    c->ctx = ctx;
    return 0;
}

/* ---- feedback adapter: read the process variable from the configured
 *      sensor (generated per peripheral type) ---- */
static int pid_feedback_read(float *out)
{
{% if fb_peri and fb_peri.type in ('I2C_Pressure', 'I2C_TempSensor') %}
    {{ fb_peri.name }}_data_t s;
    if ({{ fb_peri.name }}_read(i2c_open("{{ fb_peri.bus }}", NULL),
                                {{ fb_peri.address }}, &s) != 0) {
        return -1;
    }
    *out = s.process_value;
    return 0;
{% elif fb_peri and fb_peri.type == 'NTC_TempSensor' %}
    {{ fb_peri.name }}_data_t s;
    if ({{ fb_peri.name }}_read(&s) != 0) {
        return -1;
    }
    *out = s.temp_c;
    return 0;
{% else %}
    (void)out;
    return -1;   /* pid_ctrl: unsupported feedback source type */
{% endif %}
}

/* ---- actuator adapter: map PID output to PWM duty ---- */
static void pid_apply_output(float u)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
{% if mode == 'pwm_dual' %}
    /* u in [-100,100]: heat = +u, cool = -u, deadband around zero */
    if (u > (float){{ deadband_pct }}) {
        ctx->heat_duty = (u > (float)ctx->duty_max) ? ctx->duty_max
                                                    : (uint32_t)u;
        ctx->cool_duty = 0;
    } else if (u < -(float){{ deadband_pct }}) {
        ctx->heat_duty = 0;
        ctx->cool_duty = (-u > (float)ctx->duty_max) ? ctx->duty_max
                                                     : (uint32_t)(-u);
    } else {
        ctx->heat_duty = 0;
        ctx->cool_duty = 0;
    }
    (void){{ heat_pwm }}_set_duty((uint8_t){{ heat_ch }}, ctx->heat_duty);
    (void){{ cool_pwm }}_set_duty((uint8_t){{ cool_ch }}, ctx->cool_duty);
{% else %}
    uint32_t duty = (u < (float)ctx->duty_min) ? 0u
                  : (u > (float)ctx->duty_max) ? ctx->duty_max
                                               : (uint32_t)u;
    ctx->heat_duty = duty;
    ctx->cool_duty = 0;
    (void){{ heat_pwm }}_set_duty((uint8_t){{ heat_ch }}, duty);
{% endif %}
}

/* ---- public control API (used by CLI / state machine) ---- */
int {{ comp_name }}_set_setpoint(float value)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    if (!ctx->initialized) return -1;
{% if p_max %}
{% if p_max.name == 'pid_max_value' %}
    if (value < {{ target_min | float }}f || value > param_pid_max_value_get()) {
{% else %}
    if (value < {{ target_min | float }}f || value > param_pressure_max_kpa_get()) {
{% endif %}
        return -1;                       /* reject out-of-range target */
    }
{% else %}
    if (value < {{ target_min | float }}f || value > 1000.0f) {
        return -1;
    }
{% endif %}
    ctx->setpoint = value;
    pid_reset(&ctx->pid);
    ctx->stage = PID_STAGE_RAMP_UP;
    ctx->ramp_start_ms = HAL_GetTick();
    return 0;
}

int {{ comp_name }}_start(void)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    if (!ctx->initialized || ctx->fault != PID_FAULT_NONE) return -1;
{% if p_target and p_target.name == 'pid_target' %}
    return {{ comp_name }}_set_setpoint(param_pid_target_get());
{% elif p_target %}
    return {{ comp_name }}_set_setpoint(param_target_pressure_kpa_get());
{% else %}
    return {{ comp_name }}_set_setpoint(100.0f);
{% endif %}
}

int {{ comp_name }}_stop(void)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    if (!ctx->initialized) return -1;
    ctx->stage = PID_STAGE_STANDBY;
    ctx->heat_duty = 0;
    ctx->cool_duty = 0;
    return 0;
}

int {{ comp_name }}_vent(void)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    if (!ctx->initialized) return -1;
    /* vent = close the actuator (valve domain naming kept for CLI) */
    ctx->stage = PID_STAGE_STANDBY;
    ctx->heat_duty = 0;
    ctx->cool_duty = 0;
    return 0;
}

int {{ comp_name }}_reset_fault(void)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    if (!ctx->initialized) return -1;
    ctx->fault = PID_FAULT_NONE;
    ctx->read_failures = 0;
    if (ctx->stage == PID_STAGE_FAULT) {
        ctx->stage = PID_STAGE_STANDBY;
    }
    return 0;
}

/* ---- getters for CLI / telemetry ---- */
int {{ comp_name }}_get_status(float *process, float *setpoint,
                              uint32_t *duty, uint32_t *stage,
                              uint32_t *fault)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    if (!ctx->initialized) return -1;
    if (process)  *process  = ctx->process_value;
    if (setpoint) *setpoint = ctx->setpoint;
    if (duty)     *duty     = ctx->heat_duty;
    if (stage)    *stage    = (uint32_t)ctx->stage;
    if (fault)    *fault    = ctx->fault;
    return 0;
}

const char *{{ comp_name }}_stage_name(void)
{
    switch (g_pid_ctx.stage) {
    case PID_STAGE_STANDBY:   return "STANDBY";
    case PID_STAGE_RAMP_UP:   return "RAMP_UP";
    case PID_STAGE_HOLD:      return "HOLD";
    case PID_STAGE_FAULT:     return "FAULT";
    default:                  return "UNKNOWN";
    }
}

/* ---- interlock: tripped faults force the actuator fully off ---- */
static void pid_trip_fault(struct {{ comp_name }}_ctx *ctx, uint32_t code)
{
    if (ctx->fault != PID_FAULT_NONE) {
        return;                          /* first fault wins, latched */
    }
    ctx->fault = code;
    ctx->stage = PID_STAGE_FAULT;
    ctx->heat_duty = 0;
    ctx->cool_duty = 0;
{% if fault_evt and fault_evt.payload and fault_evt.payload.type == 'uint32' %}
    ctx->events++;
    event_post_fault_tripped(code);
{% else %}
    ctx->events++;
{% endif %}
#ifndef TEST
    log_error("PID FAULT %lu: value=%.1f %s", (unsigned long)code,
              (double)ctx->process_value, "{{ fb_unit }}");
#endif
}

/* ---- step: sample, interlock, stage machine, apply PWM duty ---- */
void {{ comp_name }}_step(component_t *c)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    float pv;
    uint32_t now;
    (void)c;

    if (!ctx->initialized) {
        return;
    }
    now = HAL_GetTick();

    /* 1) sample process feedback */
    if (pid_feedback_read(&pv) != 0) {
        ctx->read_failures++;
        if (ctx->read_failures >= {{ stuck_reads }}) {
            pid_trip_fault(ctx, PID_FAULT_SENSOR);
        }
        return;                      /* keep last duty until next sample */
    }
    ctx->read_failures = 0;
    ctx->process_value = pv;

    /* 2) over-limit interlock */
{% if p_max and p_max.name == 'pid_max_value' %}
    if (ctx->process_value > param_pid_max_value_get()) {
        pid_trip_fault(ctx, PID_FAULT_OVP);
    }
{% elif p_max %}
    if (ctx->process_value > param_pressure_max_kpa_get()) {
        pid_trip_fault(ctx, PID_FAULT_OVP);
    }
{% endif %}

    /* 3) stage machine */
    switch (ctx->stage) {
    case PID_STAGE_STANDBY:
        pid_apply_output(0.0f);
        break;

    case PID_STAGE_RAMP_UP:
        if (ctx->process_value >= ctx->setpoint - ctx->hold_hysteresis) {
            ctx->stage = PID_STAGE_HOLD;
{% if reached_evt and reached_evt.payload and reached_evt.payload.type == 'float' %}
            ctx->events++;
{% if reached_evt.name == 'TARGET_REACHED' %}
            event_post_target_reached(ctx->process_value);
{% else %}
            event_post_pressure_reached(ctx->process_value);
{% endif %}
{% else %}
            ctx->events++;
{% endif %}
#ifndef TEST
            log_info("PID HOLD: value %.1f %s", (double)ctx->process_value,
                     "{{ fb_unit }}");
#endif
        } else {
            pid_apply_output(pid_update(&ctx->pid,
                                        ctx->setpoint,
                                        ctx->process_value));
        }
        if (now - ctx->ramp_start_ms > ctx->ramp_timeout_ms) {
            pid_trip_fault(ctx, PID_FAULT_RAMP_TIMEOUT);
        }
        break;

    case PID_STAGE_HOLD:
        pid_apply_output(pid_update(&ctx->pid,
                                    ctx->setpoint,
                                    ctx->process_value));
        break;

    case PID_STAGE_FAULT:
        pid_apply_output(0.0f);
        break;
    }

    /* 4) publish process value to the configured topic (if any) */
{% if has_pub_topic and pub_topic_typed %}
    bus_publish_{{ pub_topic }}((int32_t)(ctx->process_value * 10.0f));
{% elif has_pub_topic %}
    bus_publish(TOPIC_{{ pub_topic | upper }},
                (uint32_t)(int32_t)(ctx->process_value * 10.0f));
{% endif %}
}

void {{ comp_name }}_terminate(component_t *c)
{
    struct {{ comp_name }}_ctx *ctx = &g_pid_ctx;
    if (ctx == NULL) return;
    ctx->heat_duty = 0;
    ctx->cool_duty = 0;
    ctx->initialized = 0;
    (void)c;
}
