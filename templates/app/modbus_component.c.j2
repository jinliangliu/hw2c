{#
    modbus_component.c.j2 - Modbus RTU component (slave or master)

    Wraps the Modbus protocol driver (drv_modbus) as a framework component.
    The UART transport always goes through uart_api.  RS485 half-duplex is
    a UART feature: when the UART peripheral declares extra.rs485_de_pin,
    uart_api asserts/releases the DE pin around writes automatically.

    Component config:
        uart: usart1           # UART peripheral name
        role: slave|master     # default: slave (from peripheral extra.role)

    Slave: holds an internal register table; incoming FC03/06/16 requests
           are answered in step(); a "temperature" pub/sub topic is mirrored
           into the register whose name contains "temperature".

    Master: step() periodically polls a remote slave's holding registers
           (config: target_slave / poll_interval_ms / poll_addr / poll_count)
           and logs the result.
#}
{% set modbus_list = peripherals | selectattr('type', 'eq', 'Protocol_Modbus') | list %}
{% set rs485_list  = peripherals | selectattr('type', 'eq', 'RS485') | list %}
{% set mb = modbus_list[0] if modbus_list else none %}
{% set mb_extra = mb.get('extra', {}) if mb else {} %}
{% set regs = mb_extra.get('registers', []) if mb else [] %}
{% set slave_id = mb_extra.get('slave_id', 1) if mb else 1 %}
{% set rs = rs485_list[0] if rs485_list else none %}
{% set rs_extra = rs.get('extra', {}) if rs else {} %}
{% set mb_uart = comp_config.get('uart', '') if comp_config.get('uart') else (rs_extra.get('uart', '') if rs else '') %}
{% set role = comp_config.get('role', mb_extra.get('role', 'slave')) %}
{% set target_slave = comp_config.get('target_slave', 1) %}
{% set poll_interval_ms = comp_config.get('poll_interval_ms', 2000) %}
{% set poll_addr = comp_config.get('poll_addr', 0) %}
{% set poll_count = comp_config.get('poll_count', 1) %}
{% set write_addr = comp_config.get('write_addr') %}
{% set write_value = comp_config.get('write_value') %}
{% set write_values = comp_config.get('write_values', []) %}
{% set write_interval_ms = comp_config.get('write_interval_ms', 2000) %}
{% set do_write = (write_addr is not none) and (write_value is not none or write_values | length > 0) %}
{% set reg_count = (regs | map(attribute='addr') | max | int) + 1 if regs else 0 %}
{% set temp_reg = regs | selectattr('name', 'in', ['temperature', 'temperature_x10', 'temp']) | first %}
{% set has_temp_topic = topics | selectattr('name', 'eq', 'temperature') | list | length > 0 %}
{% set use_temp_mapping = has_temp_topic and temp_reg is defined and temp_reg and reg_count > 0 %}

#include "component_registry.h"
#ifndef TEST
#include "uart_api.h"
#include "gpio_api.h"
#endif
#include "drv_{{ mb.name }}.h"
#include "component_bus.h"
#include <string.h>
#ifndef TEST
#include "stm32g0xx_hal.h"
#include "drv_log.h"
#endif

/* ---- Component-private context ---- */
struct {{ comp_name }}_ctx {
    uint8_t  initialized;
};

static struct {{ comp_name }}_ctx g_{{ comp_name }}_ctx;
static uart_handle_t g_uart_handle;

/* ---- UART transport: ISR ring buffer (both master and slave) ----
 * RX uses the USART1 RXNE interrupt; STM32G0 USART has no hardware FIFO,
 * so interrupt-driven buffering avoids losing bytes to task preemption. */
static uint8_t  g_rx_buf[256];
static volatile uint16_t g_rx_head = 0;
static volatile uint16_t g_rx_tail = 0;

#define MODBUS_RX_BUF_SIZE (sizeof(g_rx_buf))

/* Called from USART1_IRQHandler (see stm32g0xx_it.c) */
void modbus_component_uart_isr(void)
{
#ifndef TEST
    uint32_t isr = USART1->ISR;
    if (isr & USART_ISR_RXNE_RXFNE) {
        uint8_t ch = (uint8_t)(USART1->RDR & 0xFF);
        uint16_t next = (uint16_t)((g_rx_head + 1) % MODBUS_RX_BUF_SIZE);
        if (next != g_rx_tail) {
            g_rx_buf[g_rx_head] = ch;
            g_rx_head = next;
        }
    }
    if (isr & (USART_ISR_ORE | USART_ISR_FE | USART_ISR_NE)) {
        USART1->ICR = USART_ICR_ORECF | USART_ICR_FECF | USART_ICR_NECF;
    }
#endif
}

static uint8_t modbus_comp_tx(uint8_t *data, uint16_t len)
{
#ifndef TEST
    return (uart_write(g_uart_handle, data, len) > 0) ? 1 : 0;
#else
    (void)data; (void)len;
    return 1;  /* mock transport accepts all writes */
#endif
}

static uint8_t modbus_comp_rx(uint8_t *buf, uint16_t len, uint32_t timeout)
{
#ifndef TEST
    /* Pull bytes from the ISR-filled ring buffer; wait up to timeout for
     * the first byte (modbus_process / master exchange reads byte-by-byte). */
    uint32_t start = HAL_GetTick();
    uint16_t got = 0;
    for (;;) {
        while (g_rx_tail != g_rx_head && got < len) {
            buf[got++] = g_rx_buf[g_rx_tail];
            g_rx_tail = (uint16_t)((g_rx_tail + 1) % MODBUS_RX_BUF_SIZE);
        }
        if (got > 0) {
            break;
        }
        if (HAL_GetTick() - start >= timeout) {
            break;
        }
        __NOP();
    }
    return (got > 0) ? 1 : 0;
#else
    (void)buf; (void)len; (void)timeout;
    return 0;  /* no hardware ISR ring buffer in host/SIL tests */
#endif
}


{% if role != 'master' and reg_count > 0 %}
/* ---- Modbus holding registers (index = Modbus address) ---- */
static uint16_t g_modbus_regs[{{ reg_count }}];

static void modbus_comp_read_reg(uint16_t addr, uint16_t *val)
{
    if (addr < {{ reg_count }} && val) {
        *val = g_modbus_regs[addr];
    }
}

static void modbus_comp_write_reg(uint16_t addr, uint16_t val)
{
    if (addr < {{ reg_count }}) {
        g_modbus_regs[addr] = val;
    }
}
{% endif %}

{% if role != 'master' and use_temp_mapping %}
/* Mirror the pub/sub temperature topic into the temperature register. */
static void modbus_comp_on_temperature(topic_id_t topic, uint32_t value, void *ctx)
{
    (void)topic;
    (void)ctx;
    if ({{ temp_reg.addr }} < {{ reg_count }}) {
        g_modbus_regs[{{ temp_reg.addr }}] = (uint16_t)value;
    }
}
{% endif %}

/* ---- Component lifecycle ---- */
int {{ comp_name }}_init(component_t *c, void *cfg)
{
    (void)cfg;
#ifndef TEST
    g_uart_handle = uart_open("{{ mb_uart }}", NULL);
    if (g_uart_handle == NULL) {
        return -1;
    }

    /* Enable USART1 RXNE interrupt for ring-buffer reception. */
    USART1->CR1 |= USART_CR1_RXNEIE_RXFNEIE;
    NVIC_EnableIRQ(USART1_IRQn);

{% if role == 'master' %}
    /* Master: no register table; tx/rx callbacks used by the client API. */
    modbus_init(0, 0,
                (void *)modbus_comp_tx, (void *)modbus_comp_rx,
                NULL, NULL);
{% else %}
#if {{ reg_count }} > 0
    memset(g_modbus_regs, 0, sizeof(g_modbus_regs));
{% for r in regs %}
    if ({{ r.addr }} < {{ reg_count }}) g_modbus_regs[{{ r.addr }}] = {{ r.get('default', 0) }};
{% endfor %}
#endif

    modbus_init({{ slave_id }}, {{ reg_count }},
                (void *)modbus_comp_tx, (void *)modbus_comp_rx,
                (void *)modbus_comp_read_reg, (void *)modbus_comp_write_reg);

{% if use_temp_mapping %}
    bus_subscribe(TOPIC_TEMPERATURE, modbus_comp_on_temperature, NULL);
{% endif %}
{% endif %}
#else
    (void)0;
#endif

    g_{{ comp_name }}_ctx.initialized = 1;
    c->ctx = &g_{{ comp_name }}_ctx;
    return 0;
}

void {{ comp_name }}_step(component_t *c)
{
    struct {{ comp_name }}_ctx *ctx = (struct {{ comp_name }}_ctx *)c->ctx;
    if (ctx == NULL || !ctx->initialized) {
        return;
    }
#ifndef TEST
{% if role == 'master' %}
    {
        static uint32_t last_poll = 0;
{% if do_write %}
        static uint32_t last_write = 0;
{% endif %}
        uint32_t now = HAL_GetTick();
        if (now - last_poll >= {{ poll_interval_ms }}) {
            uint16_t vals[{{ poll_count }}];
            int rc = modbus_master_read_regs({{ target_slave }}, {{ poll_addr }},
                                             {{ poll_count }}, vals, 100);
            if (rc == 0) {
                log_info("MB master: slave %u reg[%u..%u] = %u",
                         (unsigned){{ target_slave }}, (unsigned){{ poll_addr }},
                         (unsigned)({{ poll_addr }} + {{ poll_count }} - 1),
                         (unsigned)vals[0]);
            } else {
                log_info("MB master: poll failed rc=%d", rc);
            }
            last_poll = now;
        }
{% if do_write %}
        if (now - last_write >= {{ write_interval_ms }}) {
{% if write_values | length > 0 %}
            uint16_t wvals[{{ write_values | length }}] = { {% for v in write_values %}{{ v }}{{ ', ' if not loop.last }}{% endfor %} };
            int rc = modbus_master_write_multiple({{ target_slave }}, {{ write_addr }},
                                                  wvals, {{ write_values | length }}, 100);
            log_info("MB master: write reg[%u..%u] rc=%d",
                     (unsigned){{ write_addr }},
                     (unsigned)({{ write_addr }} + {{ write_values | length }} - 1), rc);
{% else %}
            int rc = modbus_master_write_single({{ target_slave }}, {{ write_addr }},
                                                {{ write_value }}, 100);
            log_info("MB master: write reg[%u]=%u rc=%d",
                     (unsigned){{ write_addr }}, (unsigned){{ write_value }}, rc);
{% endif %}
            last_write = now;
        }
{% endif %}
    }
{% else %}
    modbus_process();
{% endif %}
#else
    (void)0;
#endif
}

void {{ comp_name }}_terminate(component_t *c)
{
    struct {{ comp_name }}_ctx *ctx = (struct {{ comp_name }}_ctx *)c->ctx;
    if (ctx == NULL) return;
    ctx->initialized = 0;
}
