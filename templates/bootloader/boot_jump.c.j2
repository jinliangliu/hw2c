/**
 * @file    boot_jump.c
 * @brief   Bootloader 安全跳转到 App 的实现
 *          遵循 ARM Cortex-M 跳转最佳实践。
 */

#include "boot_jump.h"
#ifdef TEST
/* 主机单测：mock_hal.h 提供 NVIC/SCB/SysTick/IWDG 寄存器模型与
 * __disable_irq/__set_MSP/__DSB/__ISB 空实现（见 test/mock_hal.h）。 */
#include "mock_hal.h"
#else
#include "stm32g0xx.h"
#endif

/**
 * @brief  跳转到应用程序
 * @param  app_addr : App 向量表起始地址（含 SP 和 Reset_Handler）
 * @note   跳转前关闭所有中断、复位外设、清除挂起中断
 */
void boot_jump_to_app(uint32_t app_addr)
{
    /* 应用入口地址结构:
     *   app_addr + 0x00 : 初始主堆栈指针 (MSP)
     *   app_addr + 0x04 : Reset_Handler 入口地址
     */
    uint32_t app_stack = ((uint32_t *)app_addr)[0];
    uint32_t app_entry = ((uint32_t *)app_addr)[1];

    /* —— 安全检查 —— */
    /* STM32G0B1RE: 144KB SRAM (0x20000000 ~ 0x20024000), SP 初始指向 RAM 顶部 */
    if (app_stack < 0x20000000 || app_stack > 0x20024000) {
        /* SP 不在 RAM 地址范围内，跳转不安全 */
        return;
    }
    if ((app_entry & 0xFFE00000) != 0x08000000) {
        /* Reset_Handler 不在 Flash 范围内，跳转不安全 */
        return;
    }

    /* —— 关闭所有外设中断 —— */
    __disable_irq();

    /* 复位 SysTick */
    SysTick->CTRL  = 0;
    SysTick->LOAD  = 0;
    SysTick->VAL   = 0;

    /* 清除所有挂起中断 */
    for (uint32_t i = 0; i < (sizeof(NVIC->ICER) / sizeof(NVIC->ICER[0])); i++) {
        NVIC->ICER[i] = 0xFFFFFFFF;
        NVIC->ICPR[i] = 0xFFFFFFFF;
    }
{% if has_iwdg %}
    /* 刷新 IWDG 防止跳转期间复位。
     * App 必须在 SystemInit() 或 main() 首条指令中重新初始化 IWDG，
     * 否则 App 初始化耗时超过看门狗超时会导致系统复位。 */
    IWDG->KR = 0xAAAA;
{% endif %}
    /* 设置向量表偏移到 App */
    SCB->VTOR = app_addr;

    /* —— 加载 MSP + 跳转 —— */
    __set_MSP(app_stack);
    __DSB();
    __ISB();

    /* 跳转到 App 的 Reset_Handler（永不返回） */
    void (*app_reset_handler)(void) = (void (*)(void))app_entry;
    app_reset_handler();

    /* Unreachable */
}
