/**
 * @file    boot_main.c
 * @brief   Bootloader 主入口
 *          上电 → 读取启动标志 → CRC 校验 → 跳转 App 或 回退到备用槽位。
 *          不依赖 HAL，仅用 CMSIS 寄存器操作。
 *          Auto-generated by Hardware2Code
 */

#include "boot_nvm.h"
#include "boot_crc.h"
#include "boot_jump.h"
#include "stm32g0xx.h"
{% if has_fota %}
/* FOTA 元数据（**与 App 共用同一个 .c**，见 fota_meta.h）。
 * 引导器用它编译时定义 FOTA_META_READ_ONLY：只编出读路径，
 * 所以这里不会引入 HAL 的任何依赖。 */
#include "drv_fota_meta.h"
{% endif %}

/* ========== App 槽位地址 ========== */
#define APP_A_START     {{ boot_config._app_a_start }}UL
#define APP_A_SIZE      {{ boot_config._app_a_size }}UL
#define APP_B_START     {{ boot_config._app_b_start }}UL
#define APP_B_SIZE      {{ boot_config._app_b_size }}UL

/* ========== 指示灯配置（{{ boot_led_port }} pin {{ boot_led_pin_num }}, 低电平点亮） ========== */
#define BOOT_LED_PORT   {{ boot_led_port }}
#define BOOT_LED_PIN    (1UL << {{ boot_led_pin_num }})
#define BOOT_LED_ON()   (BOOT_LED_PORT->BRR = BOOT_LED_PIN)
#define BOOT_LED_OFF()  (BOOT_LED_PORT->BSRR = BOOT_LED_PIN)

/* ========== 简易延时（阻塞循环，约 1ms @ 16MHz HSI） ========== */
static void delay_ms(uint32_t ms)
{
    for (uint32_t i = 0; i < ms; i++) {
        for (volatile uint32_t j = 0; j < 2000; j++) { }
    }
}

/* ========== LED 错误闪烁（SOS 模式：3 短 + 3 长 + 3 短，然后长灭） ========== */
static void led_error_blink(void)
{
    const uint32_t short_ms = 200;
    const uint32_t long_ms  = 600;
    const uint32_t gap_ms   = 200;
    const uint32_t pause_ms = 2000;

    for (uint32_t cycle = 0; ; cycle++) {
        /* 3 短闪 */
        for (int i = 0; i < 3; i++) {
            BOOT_LED_ON();  delay_ms(short_ms);
            BOOT_LED_OFF(); delay_ms(gap_ms);
        }
        delay_ms(gap_ms);

        /* 3 长闪 */
        for (int i = 0; i < 3; i++) {
            BOOT_LED_ON();  delay_ms(long_ms);
            BOOT_LED_OFF(); delay_ms(gap_ms);
        }
        delay_ms(gap_ms);

        /* 3 短闪 */
        for (int i = 0; i < 3; i++) {
            BOOT_LED_ON();  delay_ms(short_ms);
            BOOT_LED_OFF(); delay_ms(gap_ms);
        }

        delay_ms(pause_ms);
    }
}

/* ========== 简易时钟初始化（HSI 16MHz，仅配置必要时钟） ========== */
static void clock_init(void)
{
    /* 使能 LED 所在 GPIO 时钟 */
    RCC->IOPENR |= {{ boot_led_rcc_enable }};
}

/* ========== GPIO 初始化（LED {{ boot_led_port }} pin {{ boot_led_pin_num }} 推挽输出） ========== */
static void gpio_init(void)
{
    BOOT_LED_PORT->MODER   = (BOOT_LED_PORT->MODER & ~(3UL << ({{ boot_led_pin_num }} * 2))) | (1UL << ({{ boot_led_pin_num }} * 2));
    BOOT_LED_PORT->OTYPER &= ~BOOT_LED_PIN;
    BOOT_LED_PORT->OSPEEDR = (BOOT_LED_PORT->OSPEEDR & ~(3UL << ({{ boot_led_pin_num }} * 2))) | (0UL << ({{ boot_led_pin_num }} * 2));
    BOOT_LED_PORT->PUPDR  &= ~(3UL << ({{ boot_led_pin_num }} * 2));
    BOOT_LED_OFF();
}

/* ========== 系统复位 ========== */
static void soft_reset(void)
{
    __DSB();
    SCB->AIRCR = (0x5FAUL << SCB_AIRCR_VECTKEY_Pos) | SCB_AIRCR_SYSRESETREQ_Msk;
    __DSB();
    while (1) { }
}

/* ========== 诊断 LED 闪烁（Bootloader 存活信号，3 次慢闪） ========== */
static void led_heartbeat(void)
{
    for (int i = 0; i < 3; i++) {
        BOOT_LED_ON();  delay_ms(200);
        BOOT_LED_OFF(); delay_ms(200);
    }
}

/* ========== 主入口 ========== */
int main(void)
{
    /* --- 阶段 1: 硬件初始化 --- */
    clock_init();
    gpio_init();

    /* 诊断：Bootloader 存活信号（3 次慢闪，约 1.2 秒）
       如果能看到此闪烁 → Bootloader 启动正常，问题在后续阶段
       如果看不到 → Bootloader 未执行到此处（向量表/时钟问题） */
    led_heartbeat();

    boot_nvm_init();

    /* --- 阶段 2: 读取持久化状态 --- */
    bool was_boot_ok  = boot_nvm_is_boot_ok();
    uint32_t attempt  = boot_nvm_get_attempt_count();
    uint32_t slot     = boot_nvm_get_active_slot();

    /* 检查 IWDG 复位源：如果上次复位由 IWDG 引起，说明 App 死锁，计为启动失败 */
    if (RCC->CSR & RCC_CSR_IWDGRSTF) {
        was_boot_ok = false;
    }

    /* 清除所有复位标志（为下次复位检测做准备） */
    RCC->CSR |= RCC_CSR_RMVF;

    /* --- 阶段 3: 根据上次启动结果更新计数器 --- */
    if (was_boot_ok) {
        /* 上次启动成功 → 计数归零 */
        boot_nvm_clear_attempt_count();
        attempt = 0;
    } else {
        /* 上次启动失败（或首次上电） → 计数 +1 并持久化 */
        boot_nvm_inc_attempt_count();
        attempt = boot_nvm_get_attempt_count();
    }

    /* 清除 boot_ok 标志（新一轮启动开始） */
    boot_nvm_clear_boot_ok();

    /* --- 阶段 4: 检查是否超过最大重试次数 --- */
    if (attempt > BOOT_MAX_RETRIES) {
        /* 切换到备用槽位 */
        boot_nvm_swap_active_slot();
        slot = boot_nvm_get_active_slot();
        attempt = 0;

        /* 短闪 2 次表示槽位切换 */
        for (int i = 0; i < 2; i++) {
            BOOT_LED_ON();  delay_ms(100);
            BOOT_LED_OFF(); delay_ms(100);
        }

        soft_reset();   /* 软复位，重入 Bootloader */
    }

{% if has_fota %}
    /* --- 阶段 4.5: 差分补丁落地检测 ---------------------------------------
     *
     * 读**FOTA 元数据页**里最新的一条记录（`fota_meta_load`），而不是
     * TAMP 的 `BKP4R` —— 后者所在的方案基于"G0 的 TAMP 有 32 个备份寄存器"
     * 这个错误前提（实际只有 5 个，且已被 boot_nvm 与旧 FOTA 标志占满），
     * 详见 fota_meta.h 的开头。
     *
     * `state == DONE` 表示"App 已经把补丁应用到了 `slot` 指向的那个槽"。
     * 引导器**只读**这份记录（`FOTA_META_READ_ONLY`），消费它（写一条 IDLE）
     * 由 App 在确认自己跑起来之后做 —— 于是引导器完全不需要 HAL、不需要
     * tick 时基，也不需要在"擦写 Flash 到一半掉电"上做任何设计。
     *
     * ⚠️ **只在目标槽通过 CRC 时才切过去**。这一条是"引导器只读"能成立的
     * 前提：引导器没有清掉记录的能力，若不加这个闸门，"切过去 → CRC 失败
     * → 退回旧槽 → 再切过去"就是死循环。加了闸门之后最坏情况只是每次复位
     * 多验一次目标槽的 CRC（几十毫秒），而设备始终跑在能跑的那一版上。
     */
    {
        fota_meta_t rec;

        if (fota_meta_load(&rec) == 0
            && rec.state == FOTA_META_STATE_DONE
            && rec.slot != FOTA_META_SLOT_NONE) {
            uint32_t target = (rec.slot == FOTA_META_SLOT_B) ? BOOT_SLOT_B
                                                             : BOOT_SLOT_A;
            uint32_t taddr  = (target == BOOT_SLOT_B) ? APP_B_START : APP_A_START;
            uint32_t tsize  = (target == BOOT_SLOT_B) ? APP_B_SIZE  : APP_A_SIZE;

            if (target != slot && boot_crc_verify(taddr, tsize)) {
                boot_nvm_swap_active_slot();
                slot = boot_nvm_get_active_slot();

                /* 快速闪烁 3 次: 差分补丁落地 */
                for (int i = 0; i < 3; i++) {
                    BOOT_LED_ON();  delay_ms(50);
                    BOOT_LED_OFF(); delay_ms(50);
                }
            }
        }
    }
{% endif %}

    /* --- 阶段 5: 校验当前槽位固件 --- */
    uint32_t app_addr;
    uint32_t app_size;

    if (slot == BOOT_SLOT_A) {
        app_addr = APP_A_START;
        app_size = APP_A_SIZE;
    } else {
        app_addr = APP_B_START;
        app_size = APP_B_SIZE;
    }

    bool crc_ok = boot_crc_verify(app_addr, app_size);

    /* --- 阶段 6: 启动 App 或进入恢复模式 --- */
    if (crc_ok) {
        /* 固件完整 — 长闪 LED 1 次表示即将跳转 */
        BOOT_LED_ON();  delay_ms(300);
        BOOT_LED_OFF(); delay_ms(300);

        /* 跳转 App */
        boot_jump_to_app(app_addr);
        /* 跳转失败不应到达此处 */
    }

    /* 固件校验失败 */
    /* CRC 损坏说明固件写入不完整或 Flash 故障，直接切换槽位 */
    boot_nvm_swap_active_slot();

    /* 如果两个槽位都已尝试过且仍失败 → Recovery */
    if ((slot == BOOT_SLOT_A && boot_nvm_get_active_slot() == BOOT_SLOT_A) ||
        (slot == BOOT_SLOT_B && boot_nvm_get_active_slot() == BOOT_SLOT_B)) {
        /* 已经切换过一次又回到原来的槽位 → 两个槽位都有问题 */
        led_error_blink();  /* SOS 信号，死循环 */
    }

    /* 切换后软复位，尝试另一个槽位 */
    soft_reset();
}
