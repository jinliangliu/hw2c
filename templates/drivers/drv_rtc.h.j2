#ifndef __DRV_{{ peripheral.name | upper }}_H
#define __DRV_{{ peripheral.name | upper }}_H

/* <stdbool.h> must be included explicitly: this module exposes and uses
 * "bool".  Relying on another header to pull it in only worked by accident
 * under C23 (where "bool" is a keyword) and broke under -std=c99. */
#include <stdbool.h>

#ifndef TEST
#include "stm32g0xx_hal.h"
#endif

/* ---------- timer handle and callback types ---------- */
typedef void * rtc_timer_handle_t;
typedef void (*rtc_timer_cb_t)(void *arg);

/* ---------- timer modes ---------- */
#define RTC_TIMER_MODE_ONE_SHOT          0   /* fire once, auto-delete                     */
#define RTC_TIMER_MODE_PERIODIC_SEC      1   /* every N seconds (period_sec = interval)     */
#define RTC_TIMER_MODE_PERIODIC_MINUTE   2   /* every minute at specified second (0-59)     */
#define RTC_TIMER_MODE_PERIODIC_HOUR     3   /* every hour at MM:SS (param = min*60+sec)   */
#define RTC_TIMER_MODE_PERIODIC_DAY      4   /* every day at HH:MM:SS (param = h*3600+m*60+s) */
#define RTC_TIMER_MODE_ONE_SHOT_MS       5   /* fire once after N milliseconds (RTC SSR)   */

/* ---------- RTC time struct ---------- */
typedef struct {
    uint8_t  hour;
    uint8_t  min;
    uint8_t  sec;
    uint8_t  day;
    uint8_t  month;
    uint8_t  year;
    uint16_t ssr;   /* sub-second register value from HAL_RTC_GetTime */
} rtc_time_t;

/* ---------- public API ---------- */
void RTC_Init(void);
void RTC_Start(void);
void RTC_GetTime(rtc_time_t *time);
void RTC_SetTime(rtc_time_t *time);
void RTC_AdjustDrift(int16_t ppm);

extern RTC_HandleTypeDef hrtc;

rtc_timer_handle_t RTC_TimerCreate(uint32_t period_sec, uint8_t mode,
                                   rtc_timer_cb_t callback, void *arg);
rtc_timer_handle_t RTC_TimerCreateMs(uint32_t delay_ms,
                                     rtc_timer_cb_t callback, void *arg);
void RTC_TimerStart(rtc_timer_handle_t handle);
void RTC_TimerStop(rtc_timer_handle_t handle);
void RTC_TimerDelete(rtc_timer_handle_t handle);
void RTC_TimerDeleteMs(rtc_timer_handle_t handle);
void RTC_ProcessTimers(void);        /* no-op, kept for backward compat */
void RTC_SetWakeUpCounter(uint32_t wake_up_counter);
void RTC_RestoreTickConfig(void);

/* Monotonic uptime in milliseconds (RTC sub-second based; keeps running
 * through STOP since it is derived from the LSE RTC). */
uint32_t rtc_get_uptime_ms(void);

/* Wall-clock milliseconds since midnight from the RTC calendar + SSR.
 * Keeps counting through SLEEP/STOP0/STOP1 (LSE) — used to measure
 * elapsed time across low-power wakeups. */
uint32_t rtc_get_time_ms(void);

#endif /* __DRV_{{ peripheral.name | upper }}_H */
