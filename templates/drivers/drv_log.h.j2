/**
 * @file    drv_log.h
 * @brief   Lightweight logging interface for STM32G0B1
 *
 *          Based on rxi/log.c design principles:
 *          - Callback-driven output (decoupled from UART)
 *          - Compile-time level filtering
 *          - ISR-safe via ring buffer + interrupt-driven TX
 *          - Zero dynamic allocation, C99 compatible
 *
 *          Output: UART (pinout from hardware.yaml) @ 115200-8-N-1
 *          Protocol: printf-style via ring buffer + TXE interrupt
 *
 *          Reference: https://github.com/rxi/log.c (MIT License)
 */

#ifndef DRV_LOG_H
#define DRV_LOG_H

#include <stdint.h>
#include "lwrb.h"

/* ================================================================
 * Log Level Definitions
 * ================================================================ */
#define LOG_LEVEL_TRACE  0
#define LOG_LEVEL_DEBUG  1
#define LOG_LEVEL_INFO   2
#define LOG_LEVEL_WARN   3
#define LOG_LEVEL_ERROR  4
#define LOG_LEVEL_FATAL  5
#define LOG_LEVEL_NONE   6

/* Compile-time log level threshold — set via build flag or define here */
#ifndef LOG_LEVEL
#define LOG_LEVEL  LOG_LEVEL_INFO
#endif

/* ================================================================
 * Ring Buffer Configuration
 * ================================================================ */
#define LOG_RING_BUF_SIZE  {{ log_ring_buf_size }}

/* ================================================================
 * Public API
 * ================================================================ */

/**
 * @brief  Initialize the log subsystem
 * @note   Configures UART (pinout from hardware.yaml), ring buffer, and TXE interrupt.
 *         Must be called after HAL_Init() and GPIO clock enable.
 */
void log_init(void);

/**
 * @brief  Set runtime log level threshold
 * @param  level : minimum level to output (LOG_TRACE .. LOG_NONE)
 */
void log_set_level(int level);

/**
 * @brief  Core log output function (printf-style)
 * @param  level : log level of this message
 * @param  file  : source file name (use __FILE__)
 * @param  line  : source line number (use __LINE__)
 * @param  fmt   : printf format string
 * @param  ...   : format arguments
 * @note   ISR-safe: writes to ring buffer, actual TX happens in UART IRQ.
 *         Messages exceeding ring buffer space are silently dropped.
 */
void log_output(int level, const char *file, int line, const char *fmt, ...);

/**
 * @brief  Print system information banner
 * @note   Outputs MCU type, clock freq, firmware version, FreeRTOS config.
 *         Call once after log_init() and SystemClock_Config().
 */
void log_system_info(void);

/**
 * @brief  Flush ring buffer (blocking, for critical shutdown)
 */
void log_flush(void);

/**
 * @brief  Report whether the log ring buffer is usable yet.
 *
 *        故障处置路径（hw2c_fault / hw2c_diag）在复位前想留一句话，但故障
 *        完全可能发生在 log_init() **之前**（时钟配置失败、外设初始化失败
 *        都在那里）。那时 log_ringbuf 还没 lwrb_init()，往里写字节是往
 *        NULL 指针写 —— 二次 HardFault，连"记录"这一步都做不成。
 *
 *        所以调用方必须先问一句：不可用就只写 .noinit、不打日志（FR-15.7）。
 *
 * @return 非 0 = 环形缓冲已就绪，可以 log_output()/log_flush()。
 */
int log_ready(void);

/**
 * @brief  Return the UART handle used by the log subsystem.
 *
 *          The CLI shell shares the same UART as the log output.
 *          Callers can pass this handle to cli_init() to avoid
 *          duplicating HAL_UART_Init (which would clear TXEIE).
 *
 * @return Pointer to the initialized UART_HandleTypeDef.
 */
void *log_get_huart(void);

/**
 * @brief  Enable UART STOP-mode wakeup (start-bit detection).
 *
 *          Must be called BEFORE the MCU enters STOP mode.
 *          Configures HSI16 as UART clock with HSI keeper enabled
 *          so the UART can detect a falling edge (start bit) and
 *          wake the CPU from STOP0/STOP1.
 *
 * @note   Call log_stop_wakeup_clear() after waking from STOP.
 */
void log_uart_stop_wakeup_enable(void);

/**
 * @brief  Clear UART STOP wakeup flag and restore normal operation.
 *
 *          Must be called AFTER the MCU wakes from STOP mode.
 */
void log_uart_stop_wakeup_clear(void);

/**
 * @brief  Re-initialize UART hardware registers after STOP mode exit.
 *
 *          STOP mode powers down the USART peripheral, losing register
 *          configuration (baud rate, mode, CR1/CR2/CR3). This function
 *          restores all USART register settings without touching the
 *          ring buffer, preserving any pending log data queued before
 *          entering STOP.
 *
 * @note   Call after SystemClock_Config() and log_uart_stop_wakeup_clear().
 */
void log_uart_reinit(void);

/* ================================================================
 * Convenience Macros
 * ================================================================ */

#if LOG_LEVEL <= LOG_LEVEL_TRACE
#define log_trace(...) log_output(LOG_LEVEL_TRACE, __FILE__, __LINE__, __VA_ARGS__)
#else
#define log_trace(...) ((void)0)
#endif

#if LOG_LEVEL <= LOG_LEVEL_DEBUG
#define log_debug(...) log_output(LOG_LEVEL_DEBUG, __FILE__, __LINE__, __VA_ARGS__)
#else
#define log_debug(...) ((void)0)
#endif

#if LOG_LEVEL <= LOG_LEVEL_INFO
#define log_info(...)  log_output(LOG_LEVEL_INFO,  __FILE__, __LINE__, __VA_ARGS__)
#else
#define log_info(...)  ((void)0)
#endif

#if LOG_LEVEL <= LOG_LEVEL_WARN
#define log_warn(...)  log_output(LOG_LEVEL_WARN,  __FILE__, __LINE__, __VA_ARGS__)
#else
#define log_warn(...)  ((void)0)
#endif

#if LOG_LEVEL <= LOG_LEVEL_ERROR
#define log_error(...) log_output(LOG_LEVEL_ERROR, __FILE__, __LINE__, __VA_ARGS__)
#else
#define log_error(...) ((void)0)
#endif

#if LOG_LEVEL <= LOG_LEVEL_FATAL
#define log_fatal(...) log_output(LOG_LEVEL_FATAL, __FILE__, __LINE__, __VA_ARGS__)
#else
#define log_fatal(...) ((void)0)
#endif

/* Push one character into the log ring (CLI TX shares the ISR drain). */
void log_putc(char c);

/* Print a multi-line block with a single timestamp header (telemetry,
 * power status, etc.). The text may contain embedded CRLF line breaks. */
void log_block(int level, const char *text);

/* Print a raw multi-line block without timestamp/level prefix
 * (boot ASCII logo and similar banners). */
void log_raw(const char *text);

#endif /* DRV_LOG_H */
