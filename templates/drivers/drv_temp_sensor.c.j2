{#
    drv_temp_sensor.c.j2 - STM32G0 on-chip temperature sensor driver

    The temperature sensor is connected to ADC VIN[12] (RM0444: "The TSEN
    bit must be set to enable the conversion of ADC VIN[12] (temperature
    sensor) and the VREFEN bit must be set to enable the conversion of
    ADC VIN[13] (VREFINT)").  The STM32G0B1 datasheet specifies factory
    calibration at 30 degC and 130 degC stored in system memory at
    TS_CAL1 (0x1FFF75A8) and TS_CAL2 (0x1FFF75CA).

    VREFINT compensation corrects for VDDA deviation from the factory
    calibration voltage (3.0 V).  Without it, a VDDA of 3.3 V causes
    ~10 % error in the computed temperature.

    Temperature conversion uses the official ST HAL helpers:
        VDDA  = __LL_ADC_CALC_VREFANALOG_VOLTAGE(VREFINT_meas, 12b)
        Temp  = __LL_ADC_CALC_TEMPERATURE(VDDA, TS_DATA_raw, 12b)
    which is equivalent to the hand-written formula
        TS_DATA_cal = TS_DATA_raw * VREFINT_CAL / VREFINT_meas
        Temp = TS_CAL1_TEMP + (TS_CAL2_TEMP - TS_CAL1_TEMP) *
              (TS_DATA_cal - TS_CAL1) / (TS_CAL2 - TS_CAL1)

    Cold-start note: the very first conversion after power-up is biased
    high on this MCU, so the first read discards one conversion pair.

    The result is scaled by 10 (fixed-point, unit 0.1 degC) and returned as
    int16_t.  Conversion uses 32-bit intermediate arithmetic to avoid
    overflow on 12-bit ADC values.

    Note: RM0444 requires disabling the temperature sensor and internal
    voltage reference (clear TSEN/VREFEN) before entering any Stop mode.
#}
#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#endif

#include "drv_{{ peripheral.name }}.h"
#include "hw2c_fault.h"

#include "stm32g0xx_ll_adc.h"

/*
 * STM32G0B1 factory calibration values in system memory.
 * These are factory-programmed and valid for VDDA = 3.0 V.
 */
#ifndef TS_CAL1_ADDR
#define TS_CAL1_ADDR      ((uint16_t *)0x1FFF75A8U)
#endif
#ifndef VREFINT_CAL_ADDR
#define VREFINT_CAL_ADDR  ((uint16_t *)0x1FFF75AAU)
#endif
#ifndef TS_CAL2_ADDR
#define TS_CAL2_ADDR      ((uint16_t *)0x1FFF75CAU)
#endif
#define TS_CAL1_TEMP   30   /* degC at TS_CAL1 */
#define TS_CAL2_TEMP   130  /* degC at TS_CAL2 */

/* Private handle - shared with drv_adc if both are present */
#ifndef TEST
static ADC_HandleTypeDef htsens_adc;
static int initialized = 0;
static int first_read_pending = 1;
#endif

/*
 * Ensure the ADC is fully disabled (ADEN=0, ADDIS=0).  RM0444 makes
 * CFGR1/CHSELR writable only while ADEN=0, so every reconfiguration of
 * the sequencer mode or channel selection must start from this state.
 */
static void temp_sensor_adc_disable(void)
{
#ifndef TEST
    if (READ_BIT(htsens_adc.Instance->CR, ADC_CR_ADEN)) {
        SET_BIT(htsens_adc.Instance->CR, ADC_CR_ADDIS);
        while (READ_BIT(htsens_adc.Instance->CR,
                        ADC_CR_ADEN | ADC_CR_ADDIS)) {
        }
    }
#endif
}

void temp_sensor_init(void)
{
#ifndef TEST
    uint32_t wait_loops;

    /* ADC1 clock may already be enabled by system init or drv_adc */
    __HAL_RCC_ADC_CLK_ENABLE();

    htsens_adc.Instance = ADC1;
    htsens_adc.Init.ClockPrescaler        = ADC_CLOCK_SYNC_PCLK_DIV2;
    htsens_adc.Init.Resolution            = ADC_RESOLUTION_12B;
    htsens_adc.Init.DataAlign             = ADC_DATAALIGN_RIGHT;
    htsens_adc.Init.ScanConvMode          = ADC_SCAN_DISABLE;
    htsens_adc.Init.EOCSelection          = ADC_EOC_SINGLE_CONV;
    htsens_adc.Init.LowPowerAutoWait      = DISABLE;
    htsens_adc.Init.LowPowerAutoPowerOff  = DISABLE;
    htsens_adc.Init.ContinuousConvMode    = DISABLE;
    htsens_adc.Init.NbrOfConversion       = 1;
    htsens_adc.Init.DiscontinuousConvMode = DISABLE;
    htsens_adc.Init.ExternalTrigConv      = ADC_SOFTWARE_START;
    htsens_adc.Init.ExternalTrigConvEdge  = ADC_EXTERNALTRIGCONVEDGE_NONE;
    htsens_adc.Init.DMAContinuousRequests = DISABLE;
    htsens_adc.Init.Overrun               = ADC_OVR_DATA_PRESERVED;

    if (HAL_ADC_Init(&htsens_adc) != HAL_OK) {
        hw2c_fault_trap(HW2C_FAULT_PERIPH_INIT);
    }

    /*
     * Run ADC self-calibration (RM0444).  Calibration compensates
     * offset/gain errors; skipping it causes several LSBs of error that
     * become significant for the temperature sensor's narrow slope.
     */
    if (HAL_ADCEx_Calibration_Start(&htsens_adc) != HAL_OK) {
        /* An uncalibrated sensor is not a usable feedback path. */
        hw2c_fault_trap(HW2C_FAULT_PERIPH_INIT);
    }

    /*
     * Sampling time: STM32G0 SMPR has two global sampling times
     * (SMP1/SMP2); each channel selects one via a 1-bit SMPSELx field.
     * Channels default to SMPSELx=0 (use SMP1) after reset, so setting
     * SMP1 covers every channel used here.  160.5 ADC cycles ~= 20 us at
     * 8 MHz, above the temperature-sensor minimum specified in the
     * datasheet.
     */
    temp_sensor_adc_disable();
    MODIFY_REG(htsens_adc.Instance->SMPR,
               ADC_SMPR_SMP1,
               (LL_ADC_SAMPLINGTIME_160CYCLES_5 << ADC_SMPR_SMP1_Pos));

    /* Enable temperature sensor (VIN12) and VREFINT (VIN13) paths */
    SET_BIT(ADC1_COMMON->CCR, ADC_CCR_TSEN);
    SET_BIT(ADC1_COMMON->CCR, ADC_CCR_VREFEN);

    /*
     * Wait for temperature sensor startup (datasheet: tSTART max 10 us);
     * keep a margin (~100 us at 16 MHz).
     */
    for (wait_loops = 0; wait_loops < 1600U; wait_loops++) {
        __NOP();
    }

    initialized = 1;
#endif
}

/* Select one channel in bitmap mode; ADC must be disabled. */
static void temp_sensor_select_channel(uint32_t chsel_bit)
{
#ifndef TEST
    temp_sensor_adc_disable();
    /*
     * HAL_ADC_Init sets CFGR1.CHSELRMOD = 1 (fully configurable
     * sequencer), in which CHSELR bits are rank fields rather than a
     * channel bitmap and channels > 15 cannot be selected.  Force bitmap
     * mode (CHSELRMOD = 0) so each CHSELR bit directly enables one
     * channel (VIN12 = temperature sensor, VIN13 = VREFINT).
     */
    CLEAR_BIT(htsens_adc.Instance->CFGR1, ADC_CFGR1_CHSELRMOD);
    htsens_adc.Instance->CHSELR = chsel_bit;
#endif
}

/* Discard the first conversion after power-up (observed bias). */
static void temp_sensor_warmup(void)
{
#ifndef TEST
    if (first_read_pending) {
        uint16_t dummy;
        temp_sensor_select_channel(ADC_CHSELR_CHSEL12);
        HAL_ADC_Start(&htsens_adc);
        if (HAL_ADC_PollForConversion(&htsens_adc, 10) == HAL_OK) {
            dummy = (uint16_t)HAL_ADC_GetValue(&htsens_adc);
            (void)dummy;
        }
        HAL_ADC_Stop(&htsens_adc);
        first_read_pending = 0;
    }
#endif
}

int16_t temp_sensor_read_celsius(void)
{
#ifndef TEST
    uint16_t ts_data_raw;
    uint16_t vrefint_meas;
    uint32_t vdda_mv;
    int32_t temp;

    if (!initialized) {
        return 0;
    }

    temp_sensor_warmup();

    /*
     * Step 1: Read VREFINT (VIN13) to measure actual VDDA.
     * VREFINT is a stable ~1.2 V bandgap reference.
     */
    temp_sensor_select_channel(ADC_CHSELR_CHSEL13);
    HAL_ADC_Start(&htsens_adc);
    if (HAL_ADC_PollForConversion(&htsens_adc, 10) != HAL_OK) {
        HAL_ADC_Stop(&htsens_adc);
        return 0;
    }
    vrefint_meas = (uint16_t)HAL_ADC_GetValue(&htsens_adc);
    HAL_ADC_Stop(&htsens_adc);

    if (vrefint_meas == 0) {
        return 0;  /* corrupted reading */
    }

    /*
     * Step 2: Read temperature sensor on VIN12 (CHSELR bit 12).
     * RM0444: TSEN must be set (done in init) to enable this channel.
     */
    temp_sensor_select_channel(ADC_CHSELR_CHSEL12);
    HAL_ADC_Start(&htsens_adc);
    if (HAL_ADC_PollForConversion(&htsens_adc, 10) != HAL_OK) {
        HAL_ADC_Stop(&htsens_adc);
        return 0;
    }
    ts_data_raw = (uint16_t)HAL_ADC_GetValue(&htsens_adc);
    HAL_ADC_Stop(&htsens_adc);

    /* Step 3: VDDA from VREFINT, then official HAL temperature macro.
     * Returns temperature in degC; scale to 0.1 degC fixed-point. */
    vdda_mv = __LL_ADC_CALC_VREFANALOG_VOLTAGE(vrefint_meas,
                                               LL_ADC_RESOLUTION_12B);
    temp = __LL_ADC_CALC_TEMPERATURE(vdda_mv, ts_data_raw,
                                     LL_ADC_RESOLUTION_12B);
    if (temp == LL_ADC_TEMPERATURE_CALC_ERROR) {
        return 0;  /* corrupted calibration */
    }
    return (int16_t)(temp * 10);
#else
    (void)0;
    return 250;  /* 25.0 degC for test mocks */
#endif
}
