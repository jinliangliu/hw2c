/**
 * @file    drv_log.c
 * @brief   Lightweight logging implementation for STM32G0B1
 *
 *          Architecture:
 *          1. Ring buffer (power-of-2, lock-free single-producer single-consumer)
 *          2. UART TXE interrupt drains ring buffer byte-by-byte
 *          3. log_output() formats message into ring buffer (ISR-safe)
 *          4. Output format: "[YYYY-MM-DD HH:MM:SS.mmm] [LEVEL] message\r\n"
 *
 *          Reference: https://github.com/rxi/log.c (MIT License)
 */

#include <stdarg.h>
#include <stdio.h>
#include <string.h>
#include "stm32g0xx_hal.h"
#include "FreeRTOS.h"
#include "task.h"
#include "drv_log.h"
{% if has_rtc %}
#include "drv_rtc.h"
{% endif %}

/* ================================================================
 * Local Constants — derived from hardware.yaml via context builder
 * ================================================================ */
#define LOG_BAUDRATE          {{ usart2_baudrate | default(115200) }}
#define LOG_MSG_BUF_SIZE         128     /* max formatted message length */
#define LOG_LINE_END             "\r\n"

/* CLI/log UART pinout — resolved from pins in hardware.yaml */
#define LOG_USART                {{ log_uart.instance }}
#define LOG_USART_IRQn           {{ log_uart.irqn }}
#define LOG_GPIO_PORT            {{ log_uart.tx_port }}
#define LOG_GPIO_TX_PIN          {{ log_uart.tx_pin }}
#define LOG_GPIO_RX_PIN          {{ log_uart.rx_pin }}
#define LOG_GPIO_AF              {{ log_uart.tx_af }}

/* ================================================================
 * Level string table
 * ================================================================ */
static const char *level_strings[] = {
    "TRC", "DBG", "INF", "WRN", "ERR", "FTL"
};

/* ================================================================
 * Ring Buffer — powered by LwRB (third-party, MIT)
 * Single-producer (log_output), single-consumer (TXE ISR).
 * ================================================================ */
static lwrb_t   log_ringbuf;
static uint8_t  log_ringbuf_data[LOG_RING_BUF_SIZE];

/*
 * 环形缓冲是否可用（FR-15.7）。log_ringbuf 在 log_init() 之前是**未初始化**
 * 的（里面的 buff 指针是 NULL），此时任何 lwrb_write() 都是往 NULL 写。
 * 故障处置路径必须先问 log_ready()：不可用就只留 .noinit 记录，不打日志。
 */
static int log_ringbuf_ready = 0;

int log_ready(void)
{
    return log_ringbuf_ready;
}

/* ================================================================
 * UART handle — shared between init and ISR
 * ================================================================ */
static UART_HandleTypeDef log_huart;

/* Forward declaration for STOP-mode re-initialization */
static void log_uart_init(void);
static void log_uart_init(void)
{
    GPIO_InitTypeDef gpio_init = {0};

    /* Enable clocks */
    {{ log_uart.rcc_gpio_clk }}();
    {{ log_uart.rcc_usart_clk }}();

    /*
     * Select HSI16 as USART kernel clock source.
     * When SYSCLK = HSI16 (default in this project), HSI and SYSCLK
     * are the same frequency, but the independent HSI source keeps
     * USART clocked during STOP mode when HSIKERON is set.
     */
    MODIFY_REG(RCC->CCIPR, {{ log_uart.ccipr_sel_msk }},
               {{ log_uart.ccipr_hsi_src }});

    /* TX pin (Alternate Function, Push-Pull) */
    gpio_init.Pin       = LOG_GPIO_TX_PIN;
    gpio_init.Mode      = GPIO_MODE_AF_PP;
    gpio_init.Pull      = GPIO_PULLUP;
    gpio_init.Speed     = GPIO_SPEED_FREQ_LOW;
    gpio_init.Alternate = LOG_GPIO_AF;
    HAL_GPIO_Init(LOG_GPIO_PORT, &gpio_init);

    /* RX pin (Alternate Function, Push-Pull) */
    gpio_init.Pin       = LOG_GPIO_RX_PIN;
    gpio_init.Mode      = GPIO_MODE_AF_PP;
    gpio_init.Pull      = GPIO_PULLUP;
    gpio_init.Speed     = GPIO_SPEED_FREQ_LOW;
    gpio_init.Alternate = LOG_GPIO_AF;
    HAL_GPIO_Init(LOG_GPIO_PORT, &gpio_init);

    /* Configure UART */
    log_huart.Instance          = LOG_USART;
    log_huart.Init.BaudRate     = LOG_BAUDRATE;
    log_huart.Init.WordLength   = UART_WORDLENGTH_8B;
    log_huart.Init.StopBits     = UART_STOPBITS_1;
    log_huart.Init.Parity       = UART_PARITY_NONE;
    log_huart.Init.Mode         = UART_MODE_TX_RX;
    log_huart.Init.HwFlowCtl    = UART_HWCONTROL_NONE;
    log_huart.Init.OverSampling = UART_OVERSAMPLING_16;
    HAL_UART_Init(&log_huart);

    /* Enable TXE interrupt (transmit data register empty) */
    __HAL_UART_ENABLE_IT(&log_huart, UART_IT_TXE);

    /* Enable UART IRQ in NVIC */
    HAL_NVIC_SetPriority(LOG_USART_IRQn, 7, 0);
    HAL_NVIC_EnableIRQ(LOG_USART_IRQn);
}

/* ================================================================
 * UART Interrupt Handler
 *
 * TXE interrupt: pop byte from ring buffer → push to USART DR.
 * When ring buffer is empty, disable TXE interrupt to stop IRQ storm.
 * ================================================================ */
void log_uart_irq_handler(void)
{
    uint8_t byte;

    /* Check if TXE (Transmit Data Register Empty) interrupt */
    if (__HAL_UART_GET_FLAG(&log_huart, UART_FLAG_TXE) != RESET) {
        if (lwrb_read(&log_ringbuf, &byte, 1) > 0) {
            LOG_USART->TDR = byte;
        } else {
            /* Ring empty — disable TXEIT to stop IRQ storm.
             * log_output() will re-enable TXEIT when new data is pushed.
             * On Cortex-M0+ the ISR runs atomically (no same-priority
             * preemption), so there is no race between lwrb_write+enable
             * in task context and lwrb_read+disable in ISR. */
            __HAL_UART_DISABLE_IT(&log_huart, UART_IT_TXE);
        }
    }
}

/* Push one character into the log ring and arm the TXE drain.
 * Used by the CLI so all UART TX (log + CLI) shares one ISR-driven path
 * and never races the TDR register. */
void log_putc(char c)
{
    if (lwrb_write(&log_ringbuf, (uint8_t *)&c, 1) == 1) {
        __HAL_UART_ENABLE_IT(&log_huart, UART_IT_TXE);
    }
}

/* ================================================================
 * Runtime log level
 * ================================================================ */
static int current_log_level = LOG_LEVEL;

void log_set_level(int level)
{
    current_log_level = level;
}

/* ================================================================
 * Timestamp prefix helper
 * ================================================================ */
static int log_format_prefix(char *buf, int size, int level)
{
{% if has_rtc %}
    rtc_time_t now;
    uint32_t   ms;

    RTC_GetTime(&now);
    ms = (({{ rtc_sync_prediv }} - now.ssr) * 1000U) / ({{ rtc_sync_prediv }} + 1U);

    /* "[YYYY-MM-DD HH:MM:SS.mmm] [LEVEL] " */
    return snprintf(buf, (size_t)size,
                    "[%04u-%02u-%02u %02u:%02u:%02u.%03u] [%s] ",
                    2000U + now.year, now.month, now.day,
                    now.hour, now.min, now.sec, (unsigned int)ms,
                    level_strings[level]);
{% else %}
    (void)buf;
    (void)size;
    return 0;
{% endif %}
}

/* ================================================================
 * Core log_output
 * ================================================================ */
void log_output(int level, const char *file, int line, const char *fmt, ...)
{
    /* Compile-time + runtime level filter */
    if (level < current_log_level) {
        return;
    }

    char msg_buf[LOG_MSG_BUF_SIZE];
    int  msg_len;

    msg_len = log_format_prefix(msg_buf, (int)sizeof(msg_buf), level);

    if (msg_len < 0 || (size_t)msg_len >= sizeof(msg_buf)) {
        return;   /* overflow, safe to drop */
    }

    /* Append user message */
    va_list args;
    va_start(args, fmt);
    int user_len = vsnprintf(msg_buf + msg_len,
                             sizeof(msg_buf) - msg_len - 2,  /* reserve for \r\n */
                             fmt, args);
    va_end(args);

    if (user_len < 0) {
        return;
    }
    msg_len += user_len;
    if ((size_t)msg_len >= sizeof(msg_buf) - 2) {
        msg_len = (int)sizeof(msg_buf) - 3;   /* truncate, leave room for \r\n */
    }

    /* Append line ending */
    msg_buf[msg_len++] = '\r';
    msg_buf[msg_len++] = '\n';

    /* Push entire message to ring buffer */
    int pushed = 0;
    for (int i = 0; i < msg_len; i++) {
        if (lwrb_write(&log_ringbuf, &msg_buf[i], 1) != 1) {
            break;   /* ring full, drop remaining bytes */
        }
        pushed++;
    }

    /* Ensure TXE interrupt is enabled so the ISR drains the ring.
     * TXEIT is never disabled, so the ISR will pick up new data
     * automatically — no manual first-byte priming needed. */
    if (pushed > 0) {
        __HAL_UART_ENABLE_IT(&log_huart, UART_IT_TXE);
    }
}

/* ================================================================
 * log_block — one timestamp + multi-line body (single ring push)
 *
 * Used for consolidated reports (telemetry snapshot, power status)
 * so only the first line carries "[YYYY-...] [LEVEL] ".
 * ================================================================ */
void log_block(int level, const char *text)
{
    char   prefix[LOG_MSG_BUF_SIZE];
    int    plen;
    size_t tlen;

    if (level < current_log_level) {
        return;
    }

    plen = log_format_prefix(prefix, (int)sizeof(prefix), level);
    if (plen < 0) {
        return;
    }
    tlen = strlen(text);
    if (tlen == 0) {
        return;
    }

    for (int i = 0; i < plen; i++) {
        if (lwrb_write(&log_ringbuf, (uint8_t *)&prefix[i], 1) != 1) break;
    }
    for (size_t i = 0; i < tlen; i++) {
        if (lwrb_write(&log_ringbuf, (uint8_t *)&text[i], 1) != 1) break;
    }
    lwrb_write(&log_ringbuf, (uint8_t *)"\r\n", 2);

    __HAL_UART_ENABLE_IT(&log_huart, UART_IT_TXE);
}

/* ================================================================
 * log_raw — raw multi-line block without timestamp/level prefix
 *
 * Used for the boot ASCII logo and similar banners.
 * ================================================================ */
void log_raw(const char *text)
{
    size_t tlen = strlen(text);

    if (tlen == 0) {
        return;
    }
    for (size_t i = 0; i < tlen; i++) {
        if (lwrb_write(&log_ringbuf, (uint8_t *)&text[i], 1) != 1) break;
    }
    lwrb_write(&log_ringbuf, (uint8_t *)"\r\n", 2);

    __HAL_UART_ENABLE_IT(&log_huart, UART_IT_TXE);
}

/* ================================================================
 * Flush — actively drain ring buffer (blocking, bypasses ISR)
 *
 * On Cortex-M0+ the TXE ISR may not fire promptly during early init
 * (e.g. before HAL tick or when NVIC priorities are being set up).
 * To guarantee the banner and log messages are transmitted before
 * proceeding, the flush routine polls the ring buffer and writes
 * each byte directly to the USART TDR.
 * ================================================================ */
void log_flush(void)
{
    uint8_t byte;

    /* Disable TXE interrupt to prevent ISR from racing with
     * lwrb_read() → TDR write sequence. On Cortex-M0+, the ISR
     * can preempt this function and consume bytes from the ring,
     * causing data corruption. */
    __HAL_UART_DISABLE_IT(&log_huart, UART_IT_TXE);

    /* Actively drain ring buffer: read each byte and transmit */
    while (lwrb_read(&log_ringbuf, &byte, 1) > 0) {
        /* Wait for TXE (Transmit Data Register Empty) */
        while (!__HAL_UART_GET_FLAG(&log_huart, UART_FLAG_TXE)) {
            /* Spin — on STM32G0 at 16-64 MHz this is ~10 us per byte */
        }
        LOG_USART->TDR = byte;
    }

    /* Wait for last byte to finish shifting out of shift register */
    while (!(LOG_USART->ISR & USART_ISR_TC)) {
        /* Spin until Transmission Complete */
    }

    /* Re-enable TXE interrupt for normal interrupt-driven TX */
    __HAL_UART_ENABLE_IT(&log_huart, UART_IT_TXE);
}

/* ================================================================
 * Initialize
 * ================================================================ */
void log_init(void)
{
    lwrb_init(&log_ringbuf, log_ringbuf_data, LOG_RING_BUF_SIZE);
    log_ringbuf_ready = 1;

    log_uart_init();

    log_flush();
}

void *log_get_huart(void)
{
    return (void *)&log_huart;
}

void log_uart_stop_wakeup_enable(void)
{
    /* Select HSI16 as USART kernel clock — HSI stays alive in STOP */
    MODIFY_REG(RCC->CCIPR, {{ log_uart.ccipr_sel_msk }},
               {{ log_uart.ccipr_hsi_src }});
    /* Keep HSI16 oscillator running during STOP mode */
    SET_BIT(RCC->CR, RCC_CR_HSIKERON);

    /* Enable USART in Stop Mode (UESM=1).
     * WUS was preset to start-bit detection during init, so no
     * UART disable/re-enable needed here — the active RX interrupt
     * stays intact. */
    SET_BIT(log_huart.Instance->CR1, USART_CR1_UESM);
}

void log_uart_stop_wakeup_clear(void)
{
    /* Disable USART Stop Mode */
    HAL_UARTEx_DisableStopMode(&log_huart);

    /* Clear wakeup flag */
    WRITE_REG(log_huart.Instance->ICR, USART_ICR_WUCF);
}

void log_uart_reinit(void)
{
    /*
     * Re-initialize UART hardware after STOP mode exit.
     * STOP mode powers down the USART peripheral, losing register
     * configuration. This writes USART registers directly (no
     * HAL_UART_Init, which would re-trigger MspInit and reconfigure
     * GPIO/NVIC/clocks unnecessarily).
     *
     * Ring buffer content is preserved in SRAM (main regulator ON).
     */
    {{ log_uart.rcc_usart_clk }}();

    /* UE must be 0 when writing USART registers */
    CLEAR_BIT(log_huart.Instance->CR1, USART_CR1_UE);

    /* BRR = f_ck / BaudRate.
     * UART clock = HSI16 = {{ usart2_clock_freq_hz }} Hz (set via CCIPR). */
    log_huart.Instance->BRR = ({{ usart2_clock_freq_hz }}UL + LOG_BAUDRATE / 2U)
                              / LOG_BAUDRATE;

    /* Re-apply 8N1, TX+RX from saved Init structure */
    log_huart.Instance->CR1 = USART_CR1_TE | USART_CR1_RE;
    log_huart.Instance->CR2 = 0x00000000U;
    log_huart.Instance->CR3 = 0x00000000U;

    /* Re-enable USART */
    SET_BIT(log_huart.Instance->CR1, USART_CR1_UE);

    /* Re-enable TXE interrupt for interrupt-driven TX and RXNE for CLI RX
     * (both are cleared by the CR1 rewrite above). */
    __HAL_UART_ENABLE_IT(&log_huart, UART_IT_TXE);
    __HAL_UART_ENABLE_IT(&log_huart, UART_IT_RXNE);
}
