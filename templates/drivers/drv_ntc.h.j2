/**
 * @file  drv_{{ peripheral.name }}.h
 * @brief NTC thermistor temperature driver header (generated by hw2c)
 *
 * Reads an NTC voltage divider through the POSIX adc_api and converts the
 * divider midpoint to temperature with the B-parameter equation
 * (1/T = 1/T0 + ln(R/R0)/B).  Defaults suit a 1% 100K / B=3950 thermistor;
 * divider values are configured in hardware.yaml extra.
 */
{% set ntc = peripheral.get('extra', {}) %}
{% set channel = ntc.get('channel', model.get('extra_schema', {}).get('channel', {}).get('default', 0)) %}
{% set r_fixed = ntc.get('r_fixed_ohm', model.get('extra_schema', {}).get('r_fixed_ohm', {}).get('default', 100000.0)) %}
{% set r0 = ntc.get('r0_ohm', model.get('extra_schema', {}).get('r0_ohm', {}).get('default', 100000.0)) %}
{% set t0 = ntc.get('t0_c', model.get('extra_schema', {}).get('t0_c', {}).get('default', 25.0)) %}
{% set beta = ntc.get('b_value', model.get('extra_schema', {}).get('b_value', {}).get('default', 3950.0)) %}
{% set vref = ntc.get('vref_mv', model.get('extra_schema', {}).get('vref_mv', {}).get('default', 3300.0)) %}
{% set ntc_high = ntc.get('ntc_high', model.get('extra_schema', {}).get('ntc_high', {}).get('default', True)) %}

#ifndef __DRV_{{ peripheral.name | upper }}_H
#define __DRV_{{ peripheral.name | upper }}_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

/* ---- NTC configuration (from hardware.yaml extra) ---- */
#define {{ peripheral.name | upper }}_ADC_CHANNEL {{ channel }}
#define {{ peripheral.name | upper }}_R_FIXED_OHM {{ r_fixed }}f
#define {{ peripheral.name | upper }}_R0_OHM      {{ r0 }}f
#define {{ peripheral.name | upper }}_T0_C        {{ t0 }}f
#define {{ peripheral.name | upper }}_B_VALUE     {{ beta }}f
#define {{ peripheral.name | upper }}_VREF_MV     {{ vref }}f
#define {{ peripheral.name | upper }}_NTC_HIGH    {{ '1' if ntc_high else '0' }}

/* ---- Data output ---- */
typedef struct {
    uint32_t raw_mv;        /* divider midpoint voltage in mV */
    float    resistance_ohm;/* derived thermistor resistance  */
    float    temp_c;        /* temperature in degC            */
    int      last_error;    /* 0 = ok, <0 = read failure      */
} {{ peripheral.name }}_data_t;

/* Opens the ADC handle once and keeps it.  Returns 0 on success. */
int {{ peripheral.name }}_init(void);

/* Reads one temperature sample.  Returns 0 on success, -1 on error. */
int {{ peripheral.name }}_read({{ peripheral.name }}_data_t *out);

#ifdef __cplusplus
}
#endif

#endif /* __DRV_{{ peripheral.name | upper }}_H */
