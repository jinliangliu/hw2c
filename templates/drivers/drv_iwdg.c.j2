{#
    drv_iwdg.c.j2 - Independent Watchdog driver
    Uses HAL_IWDG_Init() interface for STM32Cube compatibility.
    Guards: requires has_bootloader context variable to be true.
#}
#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#endif

#include "drv_iwdg.h"

/* Private handle */
static IWDG_HandleTypeDef hiwdg;

/**
 * @brief   Initialize the IWDG with the configured timeout
 * @note    HAL_IWDG_Init() configures prescaler and reload value internally.
 *          The IWDG starts counting immediately after init.
 */
void IWDG_Init(void)
{
    hiwdg.Instance = IWDG;

    /*
     * Prescaler = /256 (IWDG_PRESCALER_256).
     * LSI ~32 kHz → tick period = 256 / 32000 = 8 ms.
     * Reload = IWDG_TIMEOUT_MS / 8, clamped to 12-bit range [1, 4095].
     */
    hiwdg.Init.Prescaler = IWDG_PRESCALER_256;

    /* IWDG_RELOAD_VALUE is generated in drv_iwdg.h from the same timeout, so
     * the published IWDG_TIMEOUT_MS and the programmed countdown agree. */
    hiwdg.Init.Reload = IWDG_RELOAD_VALUE;

    /*
     * Window option disabled — the refresh window is the full countdown range,
     * so the application can feed the watchdog at any time before timeout.
     */
    hiwdg.Init.Window = IWDG_WINDOW_DISABLE;

    if (HAL_IWDG_Init(&hiwdg) != HAL_OK) {
        /*
         * The watchdog is the last line of defence: if it cannot be armed the
         * system must not keep running an actuator with no supervision.
         * Reset immediately rather than spin here — a spin would hold the
         * outputs at their current (possibly energised) state forever.
         */
        NVIC_SystemReset();
    }
}

/**
 * @brief   Feed the IWDG to prevent a system reset
 */
void IWDG_Refresh(void)
{
    HAL_IWDG_Refresh(&hiwdg);
}
