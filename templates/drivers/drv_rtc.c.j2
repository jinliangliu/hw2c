/* ---------- private globals ---------- */
RTC_HandleTypeDef hrtc;
static bool      rtc_ready            = false;
uint32_t  rtc_uptime_sec       = 0;      /* monotonic, increment in WakeUp 1s ISR */
static uint32_t  rtc_init_sec_of_day  = 0;      /* RTC sec-of-day when uptime was 0 */

/* ---------- sorted timer list (ASC by deadline_sec) ---------- */
typedef struct rtc_timer {
    uint32_t            deadline_sec;   /* absolute uptime second              */
    uint32_t            deadline_ms;    /* ONE_SHOT_MS: absolute uptime ms     */
    uint32_t            period_sec;     /* meaning depends on mode (see .h)    */
    uint8_t             mode;           /* ONE_SHOT / PERIODIC_*               */
    rtc_timer_cb_t      callback;
    void               *arg;
    struct rtc_timer   *next;           /* sorted ASC by deadline_sec          */
} rtc_timer_t;

static rtc_timer_t *timer_head = NULL;
static rtc_timer_t *ms_timer_head = NULL;   /* ONE_SHOT_MS, sorted by deadline_ms */
extern QueueHandle_t event_queue;

/* Monotonic uptime in milliseconds, derived from the LSE RTC sub-second
 * counter (SSR).  Keeps counting through STOP since the RTC runs on LSE. */
#ifndef TEST
uint32_t rtc_get_uptime_ms(void)
{
    uint32_t ssr = RTC->SSR & 0x3FFFU;
    uint32_t elapsed_ticks = 32767U - ssr;              /* ticks since last second */
    uint32_t ms = (elapsed_ticks * 1000U) / 32768U;     /* PREDIV_S + 1 = 32768 */
    /* Reading SSR/TR locks the higher-order calendar shadow registers on
     * STM32G0 until DR is read — unlock so later TR reads stay current. */
    (void)RTC->DR;
    return rtc_uptime_sec * 1000U + ms;
}

/* Wall-clock milliseconds since midnight, read directly from the RTC
 * calendar + SSR (no HAL_GetTick dependency).  The RTC keeps counting on
 * LSE through SLEEP/STOP0/STOP1, so this stays monotonic across low-power
 * wakeups and can be used to measure elapsed time while the MCU slept. */
uint32_t rtc_get_time_ms(void)
{
    RTC_TimeTypeDef sTime = {0};
    uint32_t ms;

    /* Raw register read (SSR + TR); no WaitForSynchro needed here. */
    HAL_RTC_GetTime(&hrtc, &sTime, RTC_FORMAT_BIN);
    /* Unlock the calendar shadow registers (SSR/TR lock until DR is read). */
    (void)RTC->DR;
    ms = (({{ rtc_sync_prediv }} - (uint32_t)sTime.SubSeconds) * 1000U)
         / ({{ rtc_sync_prediv }} + 1U);
    return ((uint32_t)sTime.Hours * 3600U
            + (uint32_t)sTime.Minutes * 60U
            + (uint32_t)sTime.Seconds) * 1000U + ms;
}
#endif

/* ---------- built-in callback stubs ---------- */
/* Timer callbacks run from the RTC ISR (WakeUp/Alarm).  Events are only
 * posted once the scheduler is running - the RTC interrupts are enabled
 * during init, before vTaskStartScheduler(), and posting to a FreeRTOS
 * queue before the scheduler starts is undefined. */
static void rtc_timer_post_event(uint32_t evt_id)
{
    BaseType_t xHPW = pdFALSE;
#ifndef TEST
    if (xTaskGetSchedulerState() == taskSCHEDULER_NOT_STARTED) {
        return;
    }
#endif
    event_t evt = { .id = evt_id, .param = 0 };
    xQueueSendFromISR(event_queue, &evt, &xHPW);
    portYIELD_FROM_ISR(xHPW);
}

static void minute_timer_cb(void *arg) {
    (void)arg;
    rtc_timer_post_event(EVENT_MINUTE_TICK);
}
static void hour_timer_cb(void *arg) {
    (void)arg;
    rtc_timer_post_event(EVENT_HOUR_TICK);
}
{% for alarm in rtc_alarms %}
static void alarm_{{ alarm.event | lower }}_cb(void *arg) {
    (void)arg;
    rtc_timer_post_event(EVENT_{{ alarm.event }});
}
{% endfor %}

