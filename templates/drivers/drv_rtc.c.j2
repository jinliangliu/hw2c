/* ========================================================================
 *  软件定时器 API（测试和非测试共享）
 * ======================================================================== */

/*
 * Insert timer into sorted list by deadline_sec (ASC).
 * Re-arms Alarm A afterward.
 */
#ifndef TEST
static void timer_insert_sorted(rtc_timer_t *t)
{
    taskENTER_CRITICAL();
    t->next = NULL;

    if (!timer_head || t->deadline_sec <= timer_head->deadline_sec) {
        t->next = timer_head;
        timer_head = t;
    } else {
        rtc_timer_t *p = timer_head;
        while (p->next && p->next->deadline_sec < t->deadline_sec)
            p = p->next;
        t->next = p->next;
        p->next = t;
    }

    rtc_arm_alarm_a();
    taskEXIT_CRITICAL();
}
#else
static void timer_insert_sorted(rtc_timer_t *t)
{
    t->next = NULL;
    if (!timer_head || t->deadline_sec <= timer_head->deadline_sec) {
        t->next = timer_head;
        timer_head = t;
    } else {
        rtc_timer_t *p = timer_head;
        while (p->next && p->next->deadline_sec < t->deadline_sec)
            p = p->next;
        t->next = p->next;
        p->next = t;
    }
}
#endif

/* ---------- public timer API ---------- */

#ifndef TEST
rtc_timer_handle_t RTC_TimerCreate(uint32_t period_sec, uint8_t mode,
                                    rtc_timer_cb_t callback, void *arg)
{
    rtc_timer_t *t =
#ifndef TEST
        pvPortMalloc(sizeof(rtc_timer_t));
#else
        NULL;  /* test uses pool below */
#endif
    if (!t) return NULL;

    t->period_sec = period_sec;
    t->mode       = mode;
    t->callback   = callback;
    t->arg        = arg;
    t->next       = NULL;

    /* compute initial deadline based on mode */
    switch (mode) {
    case RTC_TIMER_MODE_ONE_SHOT:
    case RTC_TIMER_MODE_PERIODIC_SEC:
        t->deadline_sec = rtc_uptime_sec + period_sec;
        break;
    case RTC_TIMER_MODE_PERIODIC_MINUTE:
    case RTC_TIMER_MODE_PERIODIC_HOUR:
    case RTC_TIMER_MODE_PERIODIC_DAY:
        t->deadline_sec = rtc_calc_next_cyclic(period_sec, mode);
        break;
    default:
        break;
    }

    timer_insert_sorted(t);
    return (rtc_timer_handle_t)t;
}
#endif

void RTC_TimerStart(rtc_timer_handle_t handle)
{
    rtc_timer_t *t = (rtc_timer_t *)handle;
    if (t->mode == RTC_TIMER_MODE_ONE_SHOT_MS) {
        /* ms timers live in ms_timer_head and are armed at creation via
         * rtc_arm_alarm_b(); nothing to do here. */
        return;
    }
    /* remove from list first, recalc deadline, re-insert sorted */
#ifndef TEST
    taskENTER_CRITICAL();
#endif
    if (timer_head == t) {
        timer_head = t->next;
    } else {
        rtc_timer_t *p = timer_head;
        while (p && p->next != t) p = p->next;
        if (p) p->next = t->next;
    }
#ifndef TEST
    taskEXIT_CRITICAL();
#endif

    switch (t->mode) {
    case RTC_TIMER_MODE_ONE_SHOT:
    case RTC_TIMER_MODE_PERIODIC_SEC:
        t->deadline_sec = rtc_uptime_sec + t->period_sec;
        break;
    default:
        t->deadline_sec = rtc_calc_next_cyclic(t->period_sec, t->mode);
        break;
    }

    timer_insert_sorted(t);
}

void RTC_TimerStop(rtc_timer_handle_t handle)
{
    rtc_timer_t *t = (rtc_timer_t *)handle;
#ifndef TEST
    taskENTER_CRITICAL();
    t->deadline_sec = 0xFFFFFFFF;  /* push to end, effectively disabled */
    /* re-sort: remove and reinsert at tail */
    if (timer_head == t) {
        timer_head = t->next;
    } else {
        rtc_timer_t *p = timer_head;
        while (p && p->next != t) p = p->next;
        if (p) p->next = t->next;
    }
    t->next = NULL;
    rtc_arm_alarm_a();
    taskEXIT_CRITICAL();
#else
    t->deadline_sec = 0xFFFFFFFF;
#endif
}

void RTC_TimerDelete(rtc_timer_handle_t handle)
{
    rtc_timer_t *t = (rtc_timer_t *)handle;
#ifndef TEST
    taskENTER_CRITICAL();
#endif
    if (timer_head == t) {
        timer_head = t->next;
    } else {
        rtc_timer_t *p = timer_head;
        while (p && p->next != t) p = p->next;
        if (p) p->next = t->next;
    }
#ifndef TEST
    rtc_arm_alarm_a();
    taskEXIT_CRITICAL();
    vPortFree(t);
#else
    (void)t;
#endif
}

/* backward compat: no-op, timers are ISR-driven now */
void RTC_ProcessTimers(void) {}

/* ========================================================================
 *  RTC calendar time read/write
 * ======================================================================== */

void RTC_GetTime(rtc_time_t *time)
{
    if (!rtc_ready) {
        time->sec   = 0; time->min  = 0; time->hour = 0;
        time->day   = 0; time->month= 0; time->year = 0;
        time->ssr   = 0;
        return;
    }

    RTC_TimeTypeDef sTime = {0};
    RTC_DateTypeDef sDate = {0};

    HAL_RTC_WaitForSynchro(&hrtc);
    HAL_RTC_GetTime(&hrtc, &sTime, RTC_FORMAT_BIN);
    HAL_RTC_GetDate(&hrtc, &sDate, RTC_FORMAT_BIN);

    time->sec   = sTime.Seconds;
    time->min   = sTime.Minutes;
    time->hour  = sTime.Hours;
    time->day   = sDate.Date;
    time->month = sDate.Month;
    time->year  = sDate.Year;
    time->ssr   = (uint16_t)sTime.SubSeconds;
}

void RTC_SetTime(rtc_time_t *time)
{
    RTC_TimeTypeDef sTime = {0};
    RTC_DateTypeDef sDate = {0};
    sTime.Seconds = time->sec;
    sTime.Minutes = time->min;
    sTime.Hours   = time->hour;
    sDate.Date    = time->day;
    sDate.Month   = time->month;
    sDate.Year    = time->year;
    HAL_RTC_SetTime(&hrtc, &sTime, RTC_FORMAT_BIN);
    HAL_RTC_SetDate(&hrtc, &sDate, RTC_FORMAT_BIN);

#ifndef TEST
    /* Capture old ms epoch before uptime is reset (for ms-timer rebase) */
    uint32_t old_uptime_ms = rtc_get_uptime_ms();
#endif

    /* keep uptime consistent with new calendar time */
    rtc_init_sec_of_day = time->hour * 3600 + time->min * 60 + time->sec;
    rtc_uptime_sec = 0;

    /*
     * Rebuild the second-granularity timer list against the new epoch.
     * Deadlines must be recomputed AND the list re-sorted: updating
     * deadlines in place leaves entries buried behind later deadlines,
     * so they would never be reached by rtc_fire_expired().
     */
#ifndef TEST
    taskENTER_CRITICAL();
#endif
    {
        rtc_timer_t *t = timer_head;
        timer_head = NULL;
        while (t) {
            rtc_timer_t *next = t->next;
            switch (t->mode) {
            case RTC_TIMER_MODE_ONE_SHOT:
            case RTC_TIMER_MODE_PERIODIC_SEC:
                t->deadline_sec = t->period_sec;  /* now + period */
                break;
            default:
                t->deadline_sec = rtc_calc_next_cyclic(t->period_sec, t->mode);
                break;
            }
            t->next = NULL;
            /* sorted insert (ASC by deadline_sec) */
            if (!timer_head || t->deadline_sec <= timer_head->deadline_sec) {
                t->next = timer_head;
                timer_head = t;
            } else {
                rtc_timer_t *p = timer_head;
                while (p->next && p->next->deadline_sec < t->deadline_sec)
                    p = p->next;
                t->next = p->next;
                p->next = t;
            }
            t = next;
        }
        rtc_arm_alarm_a();
    }
#ifndef TEST
    taskEXIT_CRITICAL();
#endif

#ifndef TEST
    /* Rebase ms one-shot timers: keep each timer's remaining delay. */
    {
        rtc_timer_t *mt = ms_timer_head;
        while (mt) {
            mt->deadline_ms = (mt->deadline_ms > old_uptime_ms)
                              ? (mt->deadline_ms - old_uptime_ms)
                              : 0U;
            mt = mt->next;
        }
        rtc_arm_alarm_b();
    }
#endif
}

void RTC_AdjustDrift(int16_t ppm)
{
    HAL_RTCEx_SetSmoothCalib(&hrtc,
                            RTC_SMOOTHCALIB_PERIOD_32SEC,
                            RTC_SMOOTHCALIB_PLUSPULSES_RESET,
                            (uint32_t)ppm);
}

/* ========================================================================
 *  Millisecond one-shot timers (RTC sub-second / Alarm B)
 * ======================================================================== */
#ifndef TEST
static void ms_timer_insert(rtc_timer_t *t)
{
    taskENTER_CRITICAL();
    t->next = NULL;
    if (!ms_timer_head || t->deadline_ms <= ms_timer_head->deadline_ms) {
        t->next = ms_timer_head;
        ms_timer_head = t;
    } else {
        rtc_timer_t *p = ms_timer_head;
        while (p->next && p->next->deadline_ms < t->deadline_ms)
            p = p->next;
        t->next = p->next;
        p->next = t;
    }
    taskEXIT_CRITICAL();
}

/* Program Alarm B with the earliest ms timer's sub-second target. */
static void rtc_arm_alarm_b(void)
{
    RTC_AlarmTypeDef sAlarm = {0};
    uint32_t target_ms, target_sod, ms_in_sec, ssr;

    if (!ms_timer_head) {
        HAL_RTC_DeactivateAlarm(&hrtc, RTC_ALARM_B);
        return;
    }
    target_ms   = ms_timer_head->deadline_ms;
    target_sod  = (rtc_init_sec_of_day + target_ms / 1000U) % 86400U;
    ms_in_sec   = target_ms % 1000U;
    /* SSR counts down from 32767; target sub-second value for ms_in_sec */
    ssr = 32767U - (ms_in_sec * 32767U) / 1000U;

    sAlarm.AlarmTime.Hours          = (target_sod / 3600U) % 24U;
    sAlarm.AlarmTime.Minutes        = (target_sod / 60U) % 60U;
    sAlarm.AlarmTime.Seconds        = target_sod % 60U;
    sAlarm.AlarmTime.SubSeconds     = ssr;
    sAlarm.AlarmTime.DayLightSaving = RTC_DAYLIGHTSAVING_NONE;
    sAlarm.AlarmTime.StoreOperation = RTC_STOREOPERATION_RESET;
    /* Mask off the low 7 SSR bits (~1.9 ms granularity) for robustness */
    sAlarm.AlarmSubSecondMask       = RTC_ALARMSUBSECONDMASK_SS14_7;
    sAlarm.AlarmMask                = RTC_ALARMMASK_DATEWEEKDAY;
    sAlarm.AlarmDateWeekDaySel      = RTC_ALARMDATEWEEKDAYSEL_DATE;
    sAlarm.AlarmDateWeekDay         = 1;
    sAlarm.Alarm                    = RTC_ALARM_B;
    HAL_RTC_SetAlarm_IT(&hrtc, &sAlarm, RTC_FORMAT_BIN);
}

rtc_timer_handle_t RTC_TimerCreateMs(uint32_t delay_ms,
                                     rtc_timer_cb_t callback, void *arg)
{
    rtc_timer_t *t = pvPortMalloc(sizeof(rtc_timer_t));
    if (!t) return NULL;
    t->period_sec   = 0;
    t->mode         = RTC_TIMER_MODE_ONE_SHOT_MS;
    t->callback     = callback;
    t->arg          = arg;
    t->next         = NULL;
    t->deadline_ms  = rtc_get_uptime_ms() + delay_ms;
    ms_timer_insert(t);
    rtc_arm_alarm_b();
    return (rtc_timer_handle_t)t;
}

void RTC_TimerDeleteMs(rtc_timer_handle_t handle)
{
    rtc_timer_t *t = (rtc_timer_t *)handle;
    taskENTER_CRITICAL();
    if (ms_timer_head == t) {
        ms_timer_head = t->next;
    } else {
        rtc_timer_t *p = ms_timer_head;
        while (p && p->next != t) p = p->next;
        if (p) p->next = t->next;
    }
    taskEXIT_CRITICAL();
    vPortFree(t);
    rtc_arm_alarm_b();
}

/* Alarm B fires at the earliest ms timer target (single shot). */
void HAL_RTCEx_AlarmBEventCallback(RTC_HandleTypeDef *hrtc)
{
    (void)hrtc;
    uint32_t now_ms = rtc_get_uptime_ms();
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    while (ms_timer_head && ms_timer_head->deadline_ms <= now_ms) {
        rtc_timer_t *t = ms_timer_head;
        ms_timer_head = t->next;
        if (t->callback) t->callback(t->arg);
        vPortFree(t);
    }
    rtc_arm_alarm_b();
    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}
