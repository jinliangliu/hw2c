/**
 * @file  drv_{{ peripheral.name }}.h
 * @brief Generic I2C pressure sensor driver header (generated by hw2c)
 *
 * Reads a raw 24-bit ADC word from the sensor and converts it linearly to
 * pressure in kPa (raw * scale + offset).  Wiring/transport goes through
 * i2c_api, so the same driver works for any I2C pressure sensor whose
 * register map matches this model (adjust extra.reg_start / scale / offset
 * in hardware.yaml for the actual part).
 */
{% set prs = peripheral.get('extra', {}) %}
{% set reg_start = prs.get('reg_start', model.get('extra_schema', {}).get('reg_start', {}).get('default', 0)) %}
{% set scale = prs.get('scale_per_lsb', prs.get('scale_kpa_per_lsb', model.get('extra_schema', {}).get('scale_per_lsb', {}).get('default', model.get('extra_schema', {}).get('scale_kpa_per_lsb', {}).get('default', 0.001)))) %}
{% set offset = prs.get('offset', prs.get('offset_kpa', model.get('extra_schema', {}).get('offset', {}).get('default', model.get('extra_schema', {}).get('offset_kpa', {}).get('default', 0.0)))) %}
{% set unit = prs.get('unit', model.get('extra_schema', {}).get('unit', {}).get('default', 'kPa')) %}
{% set width = prs.get('data_width', model.get('extra_schema', {}).get('data_width', {}).get('default', 24)) %}

#ifndef __DRV_{{ peripheral.name | upper }}_H
#define __DRV_{{ peripheral.name | upper }}_H

#include <stdint.h>
#include "i2c_api.h"

#ifdef __cplusplus
extern "C" {
#endif

/* ---- Sensor configuration (from hardware.yaml extra) ---- */
#define {{ peripheral.name | upper }}_REG_START      {{ reg_start }}
#define {{ peripheral.name | upper }}_SCALE_PER_LSB {{ scale }}f
#define {{ peripheral.name | upper }}_OFFSET        {{ offset }}f
#define {{ peripheral.name | upper }}_UNIT          "{{ unit }}"

/* ---- Data output ---- */
typedef struct {
    uint32_t raw;           /* raw 24-bit ADC word               */
    float    process_value; /* converted process variable (unit)   */
    int      last_error;    /* 0 = ok, <0 = read failure         */
} {{ peripheral.name }}_data_t;

/* Opens the shared I2C bus and verifies the handle.  Returns 0 on
 * success, -1 if the bus handle is invalid. */
int {{ peripheral.name }}_init(i2c_handle_t bus, uint8_t dev_addr);

/* Reads one pressure sample.  Returns 0 on success, -1 on bus error. */
int {{ peripheral.name }}_read(i2c_handle_t bus, uint8_t dev_addr,
                               {{ peripheral.name }}_data_t *out);

#ifdef __cplusplus
}
#endif

#endif /* __DRV_{{ peripheral.name | upper }}_H */
