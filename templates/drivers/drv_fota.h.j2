#ifndef __DRV_{{ peripheral.name | upper }}_H
#define __DRV_{{ peripheral.name | upper }}_H

/*
 * FOTA 接收侧（规划 P3）：帧解析 + 尾仓暂存 + 元数据 + 应用编排。
 *
 * 与 `fota_delta.{c,h}` 的分工
 * ---------------------------
 *   · `fota_delta`  = **纯算法**：把一条补丁流解成新镜像，I/O 全靠注入。
 *                     它不知道 UART、不知道 TAMP、也不知道"尾仓"是什么。
 *   · `drv_fota`    = **传输与持久化**：收帧、暂存、记元数据、置安全态、
 *                     然后把暂存区当作补丁流交给 `fota_delta_apply()`。
 *
 * 这条分界是刻意的：算法那一半可以原样编到主机上（L6 掉电注入就是这么做
 * 的），传输这一半只在有 UART 与备份域的目标上才有意义。
 *
 * 帧约定**全部**来自 `generator/data/fota_format.json` 的 `transport` 段。
 * 本文件里不允许出现字面量帧标记或长度 —— 主机侧发送端读同一份真源，
 * 两侧各写一份正是 A3 类缺陷（编译与单测全绿、链路静默失效）的成因。
 */

#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#include <stdbool.h>
#endif

#include <stdint.h>

/* ⚠️ 文件名是 `drv_fota_delta.h`（模板 `fota_delta.h.j2` 的输出名由驱动名
 * 决定，不是模板名）。早先这里写的是 `"fota_delta.h"` —— 而这条 include
 * 直到 P3（`has_fota_receive` 第一次为真）才真的被编译，之前一直是"看着
 * 像对的"字面量。凡是只在某个分支成立时才被编译的东西，都要有闸门兜着。 */
#include "drv_fota_delta.h"

/* 元数据存储 + 共用的 Flash 原语（CRC16 / 页号换算）。
 * 引导器读的也是这一份 —— 两侧对布局的理解必须逐字节一致。 */
#include "drv_fota_meta.h"

/* ---- 帧约定（真源 → 常量）--------------------------------------------- */

#define FOTA_FRAME_START          {{ "0x%02XU" | format(fota_transport.frame_start) }}
#define FOTA_FRAME_DATA           {{ "0x%02XU" | format(fota_transport.frame_data) }}
#define FOTA_FRAME_FINISH         {{ "0x%02XU" | format(fota_transport.frame_finish) }}
#define FOTA_PROTOCOL_ACK         {{ "0x%02XU" | format(fota_transport.ack) }}
#define FOTA_PROTOCOL_NAK         {{ "0x%02XU" | format(fota_transport.nak) }}

/* DATA 帧一次能携带的最大字节数 */
#define FOTA_CHUNK_SIZE           {{ fota_transport.chunk_size }}U

/* 停等协议的空闲超时：超过这个时间没有收到任何字节就放弃本次接收，
 * 把 UART 交还给 CLI。**不清元数据** —— 暂存的补丁还在，主机可以接着发。 */
#define FOTA_ACK_TIMEOUT_MS       {{ fota_transport.ack_timeout_ms }}U

/* START 帧长度：标记(1) + 信封(48) + CRC16(2) */
#define FOTA_START_FRAME_SIZE     {{ fota_transport.start_total }}U
/* FINISH 帧长度：标记(1) + patch_crc32(4) */
#define FOTA_FINISH_FRAME_SIZE    {{ fota_transport.finish_total }}U
/* ACK / NAK 帧长度：标记(1) + next/want_seq(2) */
#define FOTA_RESP_FRAME_SIZE      {{ fota_transport.ack_total }}U
/* DATA 帧的定长开销：标记(1) + seq(2) + len(2) + crc16(2) */
#define FOTA_DATA_OVERHEAD        (1U + {{ fota_transport.data_hdr_size }}U \
                                   + {{ fota_transport.data_crc16_size }}U)
/* 接收缓冲要能装下最长的一帧（DATA） */
#define FOTA_MAX_FRAME            {{ fota_transport.max_frame }}U

/* ---- 槽位 ---------------------------------------------------------------
 * `FOTA_SLOT_A_BASE` / `FOTA_SLOT_B_BASE` / `_SIZE` 由 `drv_fota_delta.h` 从同一
 * 份 `boot_config` 产出，本文件直接复用 —— 不再写第二份，"两个槽的地址
 * 各写一遍"正是跨槽读写错槽那类缺陷的来源。 */

/* ---- 持久元数据 ---------------------------------------------------------
 *
 * 状态与槽位编号（`FOTA_META_STATE_*` / `FOTA_META_SLOT_*`）以及记录布局，
 * 现在都定义在 `fota_meta.h` 里 —— 因为**引导器也要读同一份记录**，两侧
 * 各写一遍就等于给"悄悄分叉"留了门。
 *
 * 这里原先还有一组 `FOTA_META_REG_BKPnR` 宏。它们指向的 BKP5R..BKP9R 在
 * STM32G0B1 上**并不存在**（TAMP 只有 BKP0R..BKP4R，且已被 boot_nvm 与
 * boot_main 占满），所以整块被搬到了 Flash 页。见 `fota_meta.h` 的说明。
 */


/* ---- 状态 --------------------------------------------------------------
 *
 * ⚠️ 必须保持 `0..FOTA_STATE_ERROR` 连续且 ERROR 在最后：CLI 的 `fota status`
 * 直接拿状态值当下标取名字（`(state <= FOTA_STATE_ERROR) ? names[state] : "UNKNOWN"`）。
 * 插入新状态只能追加到 ERROR 之前，并同步更新 CLI 的名字表。
 */
typedef enum {
    FOTA_STATE_IDLE = {{ fota_meta.st_idle }},
    FOTA_STATE_RECEIVING = {{ fota_meta.st_receiving }},
    FOTA_STATE_READY = {{ fota_meta.st_ready }},
    FOTA_STATE_APPLYING = {{ fota_meta.st_applying }},
    FOTA_STATE_DONE = {{ fota_meta.st_done }},
    FOTA_STATE_ERROR = {{ fota_meta.st_error }}
} fota_state_t;

/* 校验失败 / 协议错误。与 fota_delta_err_t 分开编号，避免两套错误码撞号：
 * 负数是 fota_delta 的（直接透传），正数是本层的。 */
#define FOTA_E_NONE              0
#define FOTA_E_NO_CLI            101   /* 没接上 CLI 的字节流 */
#define FOTA_E_BUSY              102   /* 非 IDLE 却要求进入接收 */
#define FOTA_E_NOT_READY         103   /* 还没收齐就要求应用 */
#define FOTA_E_STAGING_FULL      104   /* 准入不通过（槽装不下） */
#define FOTA_E_PATCH_CRC         105   /* FINISH 的 CRC 与暂存区不符 */
#define FOTA_E_SHORT             106   /* 收齐的字节数少于信封声明 */
#define FOTA_E_FLASH             107   /* 暂存区编程失败 */
#define FOTA_E_IO                108   /* 协议层错误（帧头/长度/序号异常已处理）*/
#define FOTA_E_ROLLBACK          109   /* 补丁应用成功但新槽没能起来，已回退旧槽 */
#define FOTA_E_STAGING_LOST      110   /* 记录说"已收齐"，但暂存区里的信封读不回来/对不上 */
#define FOTA_E_LENGTH            111   /* 主机声明的长度与信封不符，或实际收到的字节数超出声明 */
#define FOTA_E_ABORTED           112   /* 传输被中止（主机发 CAN，或本侧重试耗尽后主动放弃） */

/* ---- 传输方式 -----------------------------------------------------------
 *
 * 为什么必须有这个类型，而不是"看哪个回调被装上"：
 * `fota_process()` 里有两件**互斥**的周期性工作 —— 帧协议的空闲超时要
 * `fota_receive_abort()`，YMODEM 的握手要周期发 'C' 并处理块超时。两者的
 * 时基都由 `g_last_activity_ms` 折算，若不区分传输方式，一次 YMODEM 传输
 * 会被帧协议的空闲超时判定为"主机静默"而中途中止（而且是在 2 s 之后，
 * 表现为"YMODEM 传到一半设备自己放弃了"）。
 *
 * ⚠️ 定义必须在这里（不是 drv_fota.c）：`fota_transport_begin()` 的形参
 * 用的就是它，而 `drv_shell.c` / `main.c` / `event_mgr.c` 只 include 本头
 * 文件 —— 类型留在 .c 里，这些翻译单元会以 `unknown type name` 失败。
 */
typedef enum {
    FOTA_TP_NONE = 0,     /* 没有正在进行的接收 */
    FOTA_TP_FRAME,        /* 帧协议（fota recv） */
    FOTA_TP_YMODEM        /* YMODEM（fota ymodem） */
} fota_transport_t;

/* ---- API ---------------------------------------------------------------- */

/**
 * @brief 初始化：读回元数据、校验自校验字，必要时把状态复位。
 *
 * 冷启动时备份域是随机值，所以先校验 `BKP9R`；不通过就整块重置为 IDLE，
 * **而不是**按里面看起来像什么就去做什么 —— 一个"看起来处于 APPLYING"的
 * 随机值会导致刚上电就开始擦 Flash。
 */
void fota_init(void);

/**
 * @brief 周期处理（由 `fota_task` 以 10 ms 周期调用）。
 *
 * 负责三件事：接收空闲超时、把 UART 交还 CLI、执行待办的应用任务。
 * 应用（擦 + 解码 + 校验）在本函数里**同步跑完**，不拆成分片 ——
 * 规划 §5.3 的结论：把并发问题消掉，而不是加锁。
 *
 * 这里也是**传输层**的节拍来源：帧协议的空闲超时与 YMODEM 的握手重发
 * 都由本函数按当前生效的传输方式分别驱动（见下面的 `g_transport`）。
 */
void fota_process(void);

fota_state_t fota_get_state(void);

/** 进度百分比 0..100（应用阶段的 dst_pos/new_size；接收阶段按已收字节数折算）。 */
uint32_t fota_get_progress(void);

/** 最近一次失败的详细错误码（正数 = 本层，负数 = fota_delta 的 fota_delta_err_t）。 */
int fota_get_last_error(void);

/** 暂存区已提交的字节数（含 48 B 信封）。可断点续传的依据。 */
uint32_t fota_get_staged_bytes(void);

/** 待启动槽（FOTA_META_SLOT_A / _B / _NONE）。 */
uint32_t fota_get_pending_slot(void);

/**
 * @brief 进入接收模式：接管 CLI 的 UART 字节流，等待主机发 START 帧。
 *
 * **为什么由 CLI 命令触发，而不是"上电就等 START"**（与规划 §10.1 的措辞
 * 略有出入，实施时定的）：UART 字节流在 App 里只有一个消费者（CLI 的行编辑器），
 * 让 FOTA 常驻监听就得与它抢字节或者给每个字节加一层分派。更实际的是，
 * "只有被明确要求时才接受固件"本身也是**安全属性**：一颗误码或一段
 * 无关的串口数据不再可能触发一次 Flash 擦写。
 *
 * @param msg     失败时写入原因（可为 NULL）
 * @param msg_len 缓冲区长度
 * @return 0 成功进入接收；非 0 = 拒绝，原因已写进 msg
 */
int fota_receive_begin(char *msg, uint32_t msg_len);

/**
 * @brief 放弃本次接收：交还 UART、把状态退回 IDLE。
 * @note   **不擦除暂存区** —— 主机可以重发 START 继续（若身份一致会续传）。
 */
void fota_receive_abort(void);

/**
 * @brief 由 `cli_task` 在接管状态下调用，喂入收到的字节。
 * @note   在 CLI 任务的上下文里执行（不是 ISR）。内部不阻塞。
 */
void fota_rx_bytes(const uint8_t *data, uint16_t len);

/**
 * @brief 请求应用暂存区里的补丁（`fota recv` 收齐后自动置位，也可手动触发）。
 * @return 0 已受理；非 0 = 当前状态不允许
 */
int fota_apply_request(void);

/**
 * @brief 擦除目标槽（含尾仓暂存区），放弃本次升级并把元数据清回 IDLE。
 * @return 0 成功
 */
int fota_erase_target(void);

/* ===========================================================================
 * 暂存会话（session）—— 两条传输通道共用
 *
 * 为什么要有这一层
 * ----------------
 * 帧协议（`fota_rx_bytes`）与 YMODEM（`drv_fota_ymodem.c`）**唯一的差别**是
 * "字节怎么进来"：前者是定长分片 + 显式序号 + 停等 ACK，后者是 128/1024 字节
 * 块 + 16 位 CRC。而字节进来**之后**的一切必须逐字节相同 ——
 *
 *   · 容量准入公式（`align_up(new_size, page) + align_up(48 + patch_size, 8)`）
 *   · 暂存区几何（`staging_base = slot_base + slot_size - align_up(record, 8)`）
 *   · 续传判定（记录状态 + 槽 + 进度区间 + 信封逐字节相同）
 *   · 信封先落盘、双字对齐攒批、`0xFF` 补尾
 *   · 收尾的"从 Flash 回读整条记录复算 CRC32"
 *   · 提交 READY 与元数据追加的先后
 *
 * 各写一份的结局不是"代码重复"，而是**两份准入公式**——而"边界少算一页、
 * 应用期把暂存区首页擦掉"这类缺陷的全部难点就在于它只在一小段边界上出现，
 * 两份实现里总会有一份没被那条边界测到。所以本文件把这部分收敛成下面这组
 * 接口，两条传输都只经由它落盘。
 *
 * ⚠️ 本组接口是**模块内部契约**（`drv_fota` ↔ `drv_fota_ymodem`），
 * 应用代码不应当直接调用。
 * =========================================================================== */

/**
 * 传输层的字节流从记录的哪个位置开始 —— 由传输层**声明事实**，
 * 会话据此决定要不要重放复核已提交的前缀。
 */
typedef enum {
    /**
     * 帧协议：主机按 ACK 里携带的 `next_seq` 续传，所以它只会发"断点之后"
     * 的字节。此时流里的第一个字节就是记录的第 `fota_session_stream_start()`
     * 个字节，已提交的前缀**不会再出现**。
     */
    FOTA_STREAM_FROM_COMMIT_POINT = 0,

    /**
     * YMODEM：协议里没有"部分续传"，主机**恒从文件字节 0 开始重发**。
     * 此时会话把已提交的前缀当作"要复核的重放"：逐字节与 Flash 里的内容
     * 比对，不一致立刻失败（**fail-fast**）。
     *
     * 为什么必须比对而不是直接跳过：跳过也能保证最终正确（收尾那次
     * 回读 CRC32 覆盖整条记录），但校验失败要等到全部传完才报出来 ——
     * 操作员会为一个 3 秒就能发现的问题多等一次完整传输。
     *
     * 顺带这也是"YMODEM 侧能续传"的全部实现：主机不知道断点在哪，
     * 设备也不需要知道 —— 它只要一边复核一边等流追上断点。
     */
    FOTA_STREAM_FROM_RECORD_START = 1
} fota_stream_origin_t;

/**
 * @brief 打开一次暂存会话：校验信封 → 准入 → 定几何 → 判续传 → 落信封。
 *
 * @param env_bytes   来帧携带的 48 B 信封（传输层负责取出来）
 * @param record_size 整条记录长度。
 *                    **0 = 由信封里的 `patch_size` 推出**（帧协议的 START 帧
 *                    没有长度字段，信封是唯一来源）；
 *                    YMODEM 侧必须传块 0 声明的真实长度 —— 于是这里同时成为
 *                    "主机声明长度"与"信封声明长度"的**唯一交叉核对点**。
 * @param origin      流起点语义（见 `fota_stream_origin_t`）
 * @return 0 成功；非 0 失败，`fota_get_last_error()` 已置成具体错误码
 */
int fota_session_open(const uint8_t *env_bytes, uint32_t record_size,
                      fota_stream_origin_t origin);

/** 会话本次的流在记录里的起始偏移（`fota_session_open` 成功之后才有意义）。 */
uint32_t fota_session_stream_start(void);

/**
 * @brief 喂入记录字节（信封也走这里）。内部处理续传前缀的复核。
 * @return 0 成功；-1 = 越界、复核不符或 Flash 编程失败（已置错误码）
 */
int fota_session_feed(const uint8_t *data, uint32_t len);

/* `fota_session_finish()` 的返回值。
 *
 * 刻意把"还能救"与"必须停"分开，因为两条传输对同一个失败的反应**不同**：
 * 帧协议可以在主机补发之后重试 FINISH（NAK 里带断点），YMODEM 只能重传整个
 * 文件。若统一返回 -1，调用方就只能一律进终态 —— 那是把"缺一片"升级成
 * "必须重新开始"。 */
#define FOTA_SESSION_OK       0
#define FOTA_SESSION_SHORT    1    /* 长度不符：可由主机补发 / 重传后重试 */
#define FOTA_SESSION_FAILED  (-1)  /* 已置 ERROR，暂存区内容不可信 */

/**
 * @brief 收尾：落盘 → 从 Flash 回读复算 CRC32 → 与期望值比对 → 交叉核对长度
 *        → 提交 READY 并请求应用。
 *
 * @param expected_crc32 整条记录 CRC-32/ISO-HDLC 的期望值。
 *        帧协议侧来自主机 FINISH 帧（主机算的）；YMODEM 侧由设备在接收过程中
 *        自己累加（YMODEM 协议本身没有全文件校验，见 drv_fota_ymodem.c 的说明）。
 * @return `FOTA_SESSION_*`
 */
int fota_session_finish(uint32_t expected_crc32);

/**
 * @brief 提交当前进度（"掉电最多退回一块/一帧"的粒度）。
 *
 * 两条传输都调它，**实现只有一份** —— 于是"要不要按新进展门控、什么时候
 * 可以跳过"这类策略只在一个地方。详见 drv_fota.c 里的说明。
 */
void fota_session_commit_progress(void);

/**
 * @brief 放弃会话：交还 UART、清传输方式、状态退回 IDLE。
 * @note   **不擦除暂存区、不动元数据** —— 主机可以接着续传。
 */
void fota_session_abort(void);

/**
 * @brief "现在能不能开始接收"的**唯一**判定（两条传输共用）。
 *
 * @param msg     失败时写入原因（可为 NULL）
 * @param msg_len 缓冲区长度
 * @return 0 可以；非 0 = 拒绝，原因已写进 msg，错误码已置
 *
 * 抽成独立函数是因为"哪些状态允许进入接收"是一条**安全策略**
 * （READY / DONE 下暂存区里有一条已校验通过的补丁，允许进入就等于允许
 * 静默丢弃它）。两个入口各判一次，迟早会有一个漏掉某个状态。
 */
int fota_receive_ready(char *msg, uint32_t msg_len);

/**
 * @brief 记录一次**传输层**失败的原因（不改状态机状态）。
 *
 * 为什么与"置 ERROR"分开：传输层的失败（握手超时、重试耗尽、主机 CAN 中止）
 * **没有破坏已经落盘的东西** —— 元数据里的 RECEIVING 记录仍然有效，主机重发
 * 就能续传。把它升格成 ERROR 会让 `fota status` 显示一个需要人工介入的终态
 * （`fota recv` 虽然仍可用，但操作员会先去敲 `fota erase`），而实际上再试一次
 * 就行。真正的 ERROR 只留给"已落盘内容不可信"那几种（Flash 编程失败、
 * 回读 CRC32 不符）。
 */
void fota_note_error(int code);

/**
 * @brief 由传输层在接管 UART 之后声明自己是哪一种。
 *
 * `fota_process()` 据此决定驱动哪一套周期性工作（帧协议的空闲超时 /
 * YMODEM 的握手与块超时）。两者互斥，见 drv_fota.c 里 `g_transport` 的说明。
 */
void fota_transport_begin(fota_transport_t tp);

#endif /* __DRV_{{ peripheral.name | upper }}_H */
