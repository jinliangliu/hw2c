/**
 * @file  spi_api.c
 * @brief POSIX-style SPI bus driver implementation (generated by hw2c)
 *
 * Wraps STM32 HAL SPI behind an opaque bus handle.  CS is a software GPIO
 * (gpio_api) so the bus layer stays independent of how many devices and
 * which pins are attached; every call names the CS of the target device.
 *
 * Auto-generated — do not edit manually.
 */

