/* ---- Bus instance (one per physical SPI peripheral) ---- */
struct spi_dev {
    const char       *name;
    SPI_HandleTypeDef *hspi;
    uint32_t          default_timeout_ms;
    uint8_t           is_open;
};

{% set spi_buses = [] %}
{% for p in peripherals if 'SPI' in p.model.interface %}
{% if p.bus not in spi_buses %}
{% set _ = spi_buses.append(p.bus) %}
{% endif %}
{% endfor %}

{% if spi_buses | length > 0 %}
/* Declared in main.c as hspi<n> */
{% for bus in spi_buses %}
extern SPI_HandleTypeDef hspi{{ bus[-1] }};
{% endfor %}

static struct spi_dev g_spi_buses[] = {
{% for bus in spi_buses %}
    { .name = "{{ bus | lower }}", .hspi = &hspi{{ bus[-1] }},
      .default_timeout_ms = 100, .is_open = 0 },
{% endfor %}
};

static const uint32_t g_spi_bus_count = {{ spi_buses | length }};
{% else %}
static struct spi_dev g_spi_buses[1];
static const uint32_t g_spi_bus_count = 0;
{% endif %}

/* ---- CS helper: lazy gpio_api handle per device pin ---- */
static gpio_handle_t spi_cs_open(const char *cs_name)
{
    if (cs_name == NULL) {
        return NULL;
    }
    return gpio_open(cs_name, NULL);
}

/* ---- bus name comparison (case-insensitive, see i2c_api.c) ---- */
static int spi_bus_name_eq(const char *a, const char *b)
{
    if (a == NULL || b == NULL) {
        return 0;
    }
    while (*a != '\0' && *b != '\0') {
        unsigned char ca = (unsigned char)*a;
        unsigned char cb = (unsigned char)*b;
        if ((ca >= (unsigned char)'A') && (ca <= (unsigned char)'Z')) {
            ca = (unsigned char)(ca + 32U);
        }
        if ((cb >= (unsigned char)'A') && (cb <= (unsigned char)'Z')) {
            cb = (unsigned char)(cb + 32U);
        }
        if (ca != cb) {
            return 0;
        }
        a++;
        b++;
    }
    return (*a == *b) ? 1 : 0;
}

/* ---- spi_open (idempotent: a bus is a shared resource) ---- */
spi_handle_t spi_open(const char *bus_name, const spi_cfg_t *cfg)
{
    if (bus_name == NULL) {
        return NULL;
    }

    for (uint32_t i = 0; i < g_spi_bus_count; i++) {
        if (spi_bus_name_eq(g_spi_buses[i].name, bus_name) != 0) {
            if (!g_spi_buses[i].is_open) {
                if (cfg != NULL && cfg->timeout_ms > 0) {
                    g_spi_buses[i].default_timeout_ms = cfg->timeout_ms;
                }
                g_spi_buses[i].is_open = 1;
            }
            return (spi_handle_t)&g_spi_buses[i];
        }
    }
    return NULL;   /* bus not present in this build */
}

const char *spi_name(spi_handle_t h)
{
    return (h == NULL) ? NULL : h->name;
}

static uint32_t spi_timeout(spi_handle_t h, uint32_t timeout_ms)
{
    return (timeout_ms == 0) ? h->default_timeout_ms : timeout_ms;
}

static int32_t spi_status(int32_t rc)
{
    return (rc == HAL_OK) ? 0 : -rc;
}

/* ---- transfer length limit ----
 * This API takes a uint32_t length, but HAL_SPI_* take a uint16_t Size.
 * Truncating silently would report success for a transfer that moved the
 * wrong number of bytes. */
#define SPI_API_MAX_XFER_BYTES  0xFFFFU

/* ---- raw transfer with CS framing ---- */
int32_t spi_transfer(spi_handle_t h, const char *cs_name,
                     const uint8_t *tx, uint8_t *rx, uint32_t len,
                     uint32_t timeout_ms)
{
    gpio_handle_t cs;
    int32_t rc;

    if (h == NULL || tx == NULL || rx == NULL || len == 0) {
        return -5;
    }
    if (len > SPI_API_MAX_XFER_BYTES) {
        return -7;   /* would be truncated by the HAL uint16_t Size */
    }
    cs = spi_cs_open(cs_name);
    if (cs == NULL) {
        return -5;
    }

    gpio_write(cs, 0);   /* CS active low */
    rc = spi_status(HAL_SPI_TransmitReceive(h->hspi, (uint8_t *)tx,
                                            rx, len,
                                            spi_timeout(h, timeout_ms)));
    gpio_write(cs, 1);
    return rc;
}

