/* ---- register access (MPU6500 style: addr[7]=R/W, addr[6:0]=reg) ---- */
int32_t spi_read_reg(spi_handle_t h, const char *cs_name, uint8_t reg,
                     uint8_t *buf, uint32_t len, uint32_t timeout_ms)
{
    uint8_t tx[2 + 32];
    uint8_t rx[2 + 32];
    gpio_handle_t cs;
    int32_t rc;

    if (h == NULL || buf == NULL || len == 0 || len > 32) {
        return -5;
    }
    cs = spi_cs_open(cs_name);
    if (cs == NULL) {
        return -5;
    }

    tx[0] = (uint8_t)(reg | 0x80U);   /* read bit */
    memset(&tx[1], 0x00, len);

    gpio_write(cs, 0);
    rc = spi_status(HAL_SPI_TransmitReceive(h->hspi, tx, rx, len + 1,
                                            spi_timeout(h, timeout_ms)));
    gpio_write(cs, 1);
    if (rc != 0) {
        return rc;
    }
    memcpy(buf, &rx[1], len);   /* first byte is a dummy */
    return 0;
}

int32_t spi_write_reg(spi_handle_t h, const char *cs_name, uint8_t reg,
                      const uint8_t *buf, uint32_t len, uint32_t timeout_ms)
{
    uint8_t tx[1 + 32];
    uint8_t rx[1 + 32];
    gpio_handle_t cs;
    int32_t rc;

    if (h == NULL || buf == NULL || len == 0 || len > 32) {
        return -5;
    }
    cs = spi_cs_open(cs_name);
    if (cs == NULL) {
        return -5;
    }

    tx[0] = (uint8_t)(reg & 0x7FU);   /* write bit clear */
    memcpy(&tx[1], buf, len);

    gpio_write(cs, 0);
    rc = spi_status(HAL_SPI_TransmitReceive(h->hspi, tx, rx, len + 1,
                                            spi_timeout(h, timeout_ms)));
    gpio_write(cs, 1);
    return rc;
}
