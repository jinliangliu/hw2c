/**
 * @file  i2c_api.c
 * @brief POSIX-style I2C bus driver implementation (generated by hw2c)
 *
 * Wraps STM32 HAL I2C behind an opaque bus handle.  All devices on the
 * same physical bus share the handle and are addressed per call, so the
 * bus layer itself never needs to know how many devices are attached.
 *
 * Auto-generated — do not edit manually.
 */

#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#endif

#include "i2c_api.h"
#include <string.h>

/* ---- Bus instance (one per physical I2C peripheral) ---- */
struct i2c_dev {
    const char          *name;
    I2C_HandleTypeDef   *hi2c;
    uint32_t             default_timeout_ms;
    uint8_t              is_open;
};

{% set i2c_buses = [] %}
{% for p in peripherals if 'I2C' in p.model.interface %}
{% if p.bus not in i2c_buses %}
{% set _ = i2c_buses.append(p.bus) %}
{% endif %}
{% endfor %}

{% if i2c_buses | length > 0 %}
/* Declared in main.c as hi2c<n> */
{% for bus in i2c_buses %}
extern I2C_HandleTypeDef hi2c{{ bus[-1] }};
{% endfor %}

static struct i2c_dev g_i2c_buses[] = {
{% for bus in i2c_buses %}
    { .name = "{{ bus | lower }}", .hi2c = &hi2c{{ bus[-1] }},
      .default_timeout_ms = 100, .is_open = 0 },
{% endfor %}
};

static const uint32_t g_i2c_bus_count = {{ i2c_buses | length }};
{% else %}
static struct i2c_dev g_i2c_buses[1];
static const uint32_t g_i2c_bus_count = 0;
{% endif %}

/* ---- bus name comparison ----
 * Names are normalised to lower case at registration, but callers may pass the
 * original hardware spelling from the configuration (e.g. "I2C1").  Compare
 * case-insensitively so a bus can never be "missing" merely because of the
 * letter case used at the call site.  Avoids <ctype.h>/tolower() on purpose:
 * those are locale dependent and MISRA Rule 21.13 flagged. */
static int i2c_bus_name_eq(const char *a, const char *b)
{
    if (a == NULL || b == NULL) {
        return 0;
    }
    while (*a != '\0' && *b != '\0') {
        unsigned char ca = (unsigned char)*a;
        unsigned char cb = (unsigned char)*b;
        if ((ca >= (unsigned char)'A') && (ca <= (unsigned char)'Z')) {
            ca = (unsigned char)(ca + 32U);
        }
        if ((cb >= (unsigned char)'A') && (cb <= (unsigned char)'Z')) {
            cb = (unsigned char)(cb + 32U);
        }
        if (ca != cb) {
            return 0;
        }
        a++;
        b++;
    }
    return (*a == *b) ? 1 : 0;
}

/* ---- i2c_open (idempotent: a bus is a shared resource) ---- */
i2c_handle_t i2c_open(const char *bus_name, const i2c_cfg_t *cfg)
{
    if (bus_name == NULL) {
        return NULL;
    }

    for (uint32_t i = 0; i < g_i2c_bus_count; i++) {
        if (i2c_bus_name_eq(g_i2c_buses[i].name, bus_name) != 0) {
            if (!g_i2c_buses[i].is_open) {
                if (cfg != NULL && cfg->timeout_ms > 0) {
                    g_i2c_buses[i].default_timeout_ms = cfg->timeout_ms;
                }
                g_i2c_buses[i].is_open = 1;
            }
            return (i2c_handle_t)&g_i2c_buses[i];
        }
    }
    return NULL;   /* bus not present in this build */
}

const char *i2c_name(i2c_handle_t h)
{
    if (h == NULL) {
        return NULL;
    }
    return h->name;
}

/* ---- transfer length limit ----
 * This API takes a uint32_t length, but the HAL "Size" parameter of every
 * HAL_I2C_* transfer is uint16_t.  Passing a longer buffer used to be
 * truncated silently to its low 16 bits (65536 -> 0), i.e. the caller got a
 * success code for a transfer that moved the wrong number of bytes.  Reject
 * an over-long request instead of pretending it worked. */
#define I2C_API_MAX_XFER_BYTES  0xFFFFU

/* ---- helpers ---- */
static uint32_t i2c_timeout(i2c_handle_t h, uint32_t timeout_ms)
{
    return (timeout_ms == 0) ? h->default_timeout_ms : timeout_ms;
}

static int32_t i2c_status(int32_t rc)
{
    /* HAL_StatusTypeDef: 0=OK, 1=ERROR, 2=BUSY, 3=TIMEOUT */
    return (rc == HAL_OK) ? 0 : -rc;
}

/* ---- target-only bus guard ----
 * STM32 HAL's polling I2C error path can spin forever on a stuck/floating
 * bus (STOPF never sets).  Before any transaction we bound the BUSY wait
 * and cycle the peripheral if it is stuck, so a missing device can never
 * hang the system.
 *
 * The bound is expressed in *milliseconds*, not loop iterations: an iteration
 * count has no defined duration (it changes with -O level, clock frequency and
 * flash wait states), so it cannot be reasoned about against a control-loop
 * period or a watchdog timeout.  HAL_GetTick() is the same time base the
 * caller's own timeouts use.
 *
 * The iteration cap is a secondary guard for the pre-scheduler window, where
 * the tick may legitimately not advance yet; it is far longer than the
 * millisecond bound would ever need. */
#define I2C_BUS_READY_TIMEOUT_MS  5U
#define I2C_BUS_READY_SPIN_CAP    20000U

#ifndef TEST
static int32_t i2c_bus_ensure_ready(struct i2c_dev *h)
{
    uint32_t start = HAL_GetTick();
    uint32_t spin  = 0U;

    while (__HAL_I2C_GET_FLAG(h->hi2c, I2C_FLAG_BUSY) != RESET) {
        if ((HAL_GetTick() - start) >= I2C_BUS_READY_TIMEOUT_MS) {
            break;
        }
        spin++;
        if (spin >= I2C_BUS_READY_SPIN_CAP) {
            break;      /* tick frozen (early boot): fall back to the spin cap */
        }
    }

    if (__HAL_I2C_GET_FLAG(h->hi2c, I2C_FLAG_BUSY) != RESET) {
        /* Stuck bus: cycle PE to reset the peripheral state machine. */
        __HAL_I2C_DISABLE(h->hi2c);
        __HAL_I2C_ENABLE(h->hi2c);
        if (__HAL_I2C_GET_FLAG(h->hi2c, I2C_FLAG_BUSY) != RESET) {
            return -6;
        }
    }
    return 0;
}
#endif

/* ---- register access ---- */
int32_t i2c_read_reg(i2c_handle_t h, uint8_t dev_addr, uint8_t reg,
                     uint8_t *buf, uint32_t len, uint32_t timeout_ms)
{
    return i2c_mem_read(h, dev_addr, reg, I2C_MEMADDR_SIZE_8BIT,
                        buf, len, timeout_ms);
}

int32_t i2c_write_reg(i2c_handle_t h, uint8_t dev_addr, uint8_t reg,
                      const uint8_t *buf, uint32_t len, uint32_t timeout_ms)
{
    return i2c_mem_write(h, dev_addr, reg, I2C_MEMADDR_SIZE_8BIT,
                         buf, len, timeout_ms);
}

/* ---- memory access ---- */
int32_t i2c_mem_read(i2c_handle_t h, uint8_t dev_addr, uint16_t mem_addr,
                     uint8_t mem_addr_size,
                     uint8_t *buf, uint32_t len, uint32_t timeout_ms)
{
    if (h == NULL || buf == NULL || len == 0) {
        return -5;
    }
    if (len > I2C_API_MAX_XFER_BYTES) {
        return -7;   /* would be truncated by the HAL uint16_t Size */
    }
#ifndef TEST
    if (i2c_bus_ensure_ready(h) != 0) {
        return -6;
    }
#endif
    if (mem_addr_size != I2C_MEMADDR_SIZE_8BIT &&
        mem_addr_size != I2C_MEMADDR_SIZE_16BIT) {
        return -5;
    }
    return i2c_status(HAL_I2C_Mem_Read(h->hi2c, (uint16_t)(dev_addr << 1),
                                       mem_addr, mem_addr_size,
                                       buf, len, i2c_timeout(h, timeout_ms)));
}

int32_t i2c_mem_write(i2c_handle_t h, uint8_t dev_addr, uint16_t mem_addr,
                      uint8_t mem_addr_size,
                      const uint8_t *buf, uint32_t len, uint32_t timeout_ms)
{
    if (h == NULL || buf == NULL || len == 0) {
        return -5;
    }
    if (len > I2C_API_MAX_XFER_BYTES) {
        return -7;   /* would be truncated by the HAL uint16_t Size */
    }
#ifndef TEST
    if (i2c_bus_ensure_ready(h) != 0) {
        return -6;
    }
#endif
    if (mem_addr_size != I2C_MEMADDR_SIZE_8BIT &&
        mem_addr_size != I2C_MEMADDR_SIZE_16BIT) {
        return -5;
    }
    return i2c_status(HAL_I2C_Mem_Write(h->hi2c, (uint16_t)(dev_addr << 1),
                                        mem_addr, mem_addr_size,
                                        (uint8_t *)buf, len,
                                        i2c_timeout(h, timeout_ms)));
}

