/* ---- device name comparison (case-insensitive, see i2c_api.c) ---- */
static int uart_name_eq(const char *a, const char *b)
{
    if (a == NULL || b == NULL) {
        return 0;
    }
    while (*a != '\0' && *b != '\0') {
        unsigned char ca = (unsigned char)*a;
        unsigned char cb = (unsigned char)*b;
        if ((ca >= (unsigned char)'A') && (ca <= (unsigned char)'Z')) {
            ca = (unsigned char)(ca + 32U);
        }
        if ((cb >= (unsigned char)'A') && (cb <= (unsigned char)'Z')) {
            cb = (unsigned char)(cb + 32U);
        }
        if (ca != cb) {
            return 0;
        }
        a++;
        b++;
    }
    return (*a == *b) ? 1 : 0;
}

/* ---- uart_open ---- */
uart_handle_t uart_open(const char *name, const uart_cfg_t *cfg)
{
    if (name == NULL) {
        return NULL;
    }

    for (uint32_t i = 0; i < g_uart_count; i++) {
        if (uart_name_eq(g_uart_devs[i].name, name) != 0) {
            if (g_uart_devs[i].is_open) {
                return NULL;  /* already opened */
            }
            /* Bind RS485 DE GPIO if the peripheral declares one */
            g_uart_devs[i].de_gpio = NULL;
            if (g_uart_devs[i].de_pin_name != NULL) {
                g_uart_devs[i].de_gpio = gpio_open(g_uart_devs[i].de_pin_name, NULL);
                if (g_uart_devs[i].de_gpio == NULL) {
                    return NULL;
                }
                /* RS485: start in receive mode (DE low) */
                gpio_write(g_uart_devs[i].de_gpio, 0);
            }
            g_uart_devs[i].is_open = 1;
            return (uart_handle_t)&g_uart_devs[i];
        }
    }
    return NULL;  /* not found */
}

/* ---- transfer length limit ----
 * This API takes a uint32_t length, but the HAL "Size" parameter of
 * HAL_UART_Transmit/Receive is uint16_t.  Truncating silently would report
 * success for a transfer that moved the wrong number of bytes. */
#define UART_API_MAX_XFER_BYTES  0xFFFFU

/* ---- uart_read ---- */
int32_t uart_read(uart_handle_t h, uint8_t *buf, uint32_t len, uint32_t timeout_ms)
{
    if (h == NULL || buf == NULL || len == 0) {
        return -1;
    }
    if (len > UART_API_MAX_XFER_BYTES) {
        return -1;   /* would be truncated by the HAL uint16_t Size */
    }
    struct uart_dev *dev = (struct uart_dev *)h;
    HAL_StatusTypeDef status = HAL_UART_Receive(dev->huart, buf, (uint16_t)len, timeout_ms);
    if (status == HAL_OK) {
        return (int32_t)len;
    }
    return -1;
}

/* ---- uart_write ---- */
int32_t uart_write(uart_handle_t h, const uint8_t *buf, uint32_t len)
{
    if (h == NULL || buf == NULL || len == 0) {
        return -1;
    }
    if (len > UART_API_MAX_XFER_BYTES) {
        return -1;   /* would be truncated by the HAL uint16_t Size */
    }
    struct uart_dev *dev = (struct uart_dev *)h;
    /* RS485 half-duplex: assert DE before transmitting, release after */
    if (dev->de_gpio != NULL) {
        gpio_write(dev->de_gpio, 1);
    }
    HAL_StatusTypeDef status = HAL_UART_Transmit(dev->huart, (uint8_t *)buf, (uint16_t)len, HAL_MAX_DELAY);
    if (dev->de_gpio != NULL) {
        gpio_write(dev->de_gpio, 0);
    }
    if (status == HAL_OK) {
        return (int32_t)len;
    }
    return -1;
}

/* ---- uart_ioctl ---- */
int32_t uart_ioctl(uart_handle_t h, uint32_t cmd, void *arg)
{
    if (h == NULL) {
        return -1;
    }
    struct uart_dev *dev = (struct uart_dev *)h;

    switch (cmd) {
    case UART_IOCTL_SET_BAUD: {
        if (arg == NULL) return -1;
        uint32_t baud = *(uint32_t *)arg;
        dev->huart->Init.BaudRate = baud;
        if (HAL_UART_Init(dev->huart) != HAL_OK) {
            return -1;
        }
        return 0;
    }
    case UART_IOCTL_GET_BAUD: {
        if (arg == NULL) return -1;
        *(uint32_t *)arg = dev->huart->Init.BaudRate;
        return 0;
    }
    case UART_IOCTL_FLUSH_TX: {
        /* Wait for TX complete */
        return 0;
    }
    case UART_IOCTL_SET_DIR: {
        /* RS485 direction: *(int*)arg = 0 (RX) or 1 (TX) */
        if (dev->de_gpio == NULL || arg == NULL) {
            return -1;
        }
        gpio_write(dev->de_gpio, (*(int *)arg) ? 1 : 0);
        return 0;
    }
    case UART_IOCTL_GET_DIR: {
        if (dev->de_gpio == NULL || arg == NULL) {
            return -1;
        }
        /* DE state mirrors direction (1=TX) */
        *(int *)arg = 0;
        return 0;
    }
    default:
        return -1;
    }
}

/* ---- uart_close ---- */
void uart_close(uart_handle_t h)
{
    if (h == NULL) {
        return;
    }
    struct uart_dev *dev = (struct uart_dev *)h;
    HAL_UART_DeInit(dev->huart);
    dev->is_open = 0;
}
