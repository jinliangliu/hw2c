{#
    fota_meta.c.j2 - FOTA 持久元数据（专用 Flash 页 + 日志式追加）

    被**引导器与 App 共用**：只生成一份，两边的 CMake 引用同一个文件
    （引导器用 ../src/drivers/fota_meta.c）。生成两份就等于允许两侧的
    布局理解悄悄分叉 —— 而"两侧不一致"正是本项目最贵的一类缺陷。

    ⚠️ 本文件**没有** `#ifdef TEST` 分支：主机侧跑的是同一份逻辑，
    只是 HAL 换成了 mock_hal 的替身（替身只打在 Flash 读写这个外部边界上）。

    ⚠️ 有 `FOTA_META_READ_ONLY` 分支：引导器**只读**这份记录（读路径不碰
    任何 Flash 控制器寄存器），用这个宏把写路径整段排除，于是引导器不需要
    HAL、不需要 tick 时基。"消费已处理的记录"由 App 做 —— 见下方第 3 节。

    掉电语义（为什么是日志式而不是两个槽乒乓）
    ------------------------------------------
    乒乓需要每轮擦一整页，而"擦掉旧槽"那段时间里**唯一**的有效记录正好在
    被擦的页上 —— 掉电即全丢。追加式把每次状态变更写成一条 24 B 新记录，
    页满（85 条）才擦一次；掉电最多毁掉**正在写的那一条**，扫描时 CRC16
    不过就被跳过，上一条仍然有效。
#}
#include "drv_{{ peripheral.name }}.h"

#include <string.h>

/* ===========================================================================
 * 1. 基础访问
 * =========================================================================== */

/* Flash 是**内存映射**的，读和读 RAM 一样；写必须走 HAL_FLASH_Program
 * （直接赋值不会触发编程，只会静默丢掉）。这一对不对称是本模块最容易
 * 写错的地方，所以只有这两个原语，别的都走它们。 */
static uint32_t fota_meta_rd32(uint32_t addr)
{
    /* 读法是 volatile 直取，与真机、与 mock 的内存映射实现都一致。
     * 需求是 4 字节对齐 —— 记录里的每个字段偏移都是 4 的倍数（记录本身
     * 8 字节对齐），由生成期的字段排布保证。 */
    return *(const volatile uint32_t *)(uintptr_t)addr;
}

uint16_t fota_crc16(const uint8_t *data, uint32_t len)
{
    /* CRC-16/CCITT-FALSE（初值 0xFFFF、不反射、无终值异或）。
     * 与帧尾 CRC、信封头 CRC、`drv_fota` 的元数据 CRC 同一个算法 ——
     * 本工程的 CRC16 只允许有一份实现放在这里，别处都调它。 */
    uint16_t crc = 0xFFFFU;
    uint32_t i;
    uint8_t  bit;

    for (i = 0U; i < len; i++) {
        crc ^= (uint16_t)((uint16_t)data[i] << 8);
        for (bit = 0U; bit < 8U; bit++) {
            crc = ((crc & 0x8000U) != 0U)
                    ? (uint16_t)((uint16_t)(crc << 1) ^ 0x1021U)
                    : (uint16_t)(crc << 1);
        }
    }
    return crc;
}

/* 记录自校验用同一个算法，只是换个更贴切的名字读起来顺 —— 刻意做成
 * 宏而不是第二个函数体，免得又出现"两份实现"。 */
#define fota_meta_crc16(data, len) fota_crc16((data), (len))

/* ===========================================================================
 * 2. 记录的校验与扫描（**只读**）
 * =========================================================================== */

/* 一条记录是否可信。**只信 CRC，不信"看起来对"**：
 * magic 命中（1/2^32）与 seq 落在合法范围都可能被上电随机值蒙对，
 * 而"校验字对了才认"把误判压到 2^-16 再乘以前两者。 */
static int fota_meta_rec_valid(uint32_t base, fota_meta_t *out)
{
    uint32_t seq;
    uint32_t stored;
    uint16_t calc;

    if (fota_meta_rd32(base + FOTA_META_OFF_MAGIC) != FOTA_META_MAGIC) {
        return 0;
    }
    seq = fota_meta_rd32(base + FOTA_META_OFF_SEQ);
    if (seq == 0U || seq == FOTA_META_SEQ_INVALID) {
        /* 0 = 未初始化；0xFFFFFFFF = 擦除态。两者都不是有效记录 ——
         * 少了这一条，"空白页"会被当成长度为 85 的 seq=0xFFFFFFFF 记录。 */
        return 0;
    }

    calc   = fota_meta_crc16((const uint8_t *)(uintptr_t)base, FOTA_META_CRC16_LEN);
    stored = fota_meta_rd32(base + FOTA_META_OFF_CRC16) & 0xFFFFU;
    if (calc != (uint16_t)stored) {
        return 0;
    }

    if (out != NULL) {
        out->seq    = seq;
        out->state  = fota_meta_rd32(base + FOTA_META_OFF_STATE);
        out->slot   = fota_meta_rd32(base + FOTA_META_OFF_SLOT);
        out->staged = fota_meta_rd32(base + FOTA_META_OFF_STAGED);
    }
    return 1;
}

int fota_meta_load(fota_meta_t *out)
{
    uint32_t i;
    uint32_t best_seq = 0U;
    int      found    = 0;
    fota_meta_t best;

    best.seq = 0U; best.state = FOTA_META_STATE_IDLE;
    best.slot = FOTA_META_SLOT_NONE; best.staged = 0U;

    for (i = 0U; i < FOTA_META_RECORD_COUNT; i++) {
        fota_meta_t rec;
        uint32_t    base = FOTA_META_PAGE_BASE + (i * FOTA_META_RECORD_SIZE);

        if (!fota_meta_rec_valid(base, &rec)) {
            continue;                     /* 写了一半 / 空槽 / 从未写过 */
        }
        if (!found || rec.seq > best_seq) {
            best     = rec;
            best_seq = rec.seq;
            found    = 1;
        }
    }

    if (!found) {
        return -1;                        /* **不修改** *out */
    }
    if (out != NULL) {
        *out = best;
    }
    return 0;
}

/* ===========================================================================
 * 3. 写路径 —— **引导器不需要**，用 `FOTA_META_READ_ONLY` 整段排除
 *
 * 引导器只做"读记录 → 决定启动哪个槽 → 跳转"，不写 Flash：
 *   · 消费一条已处理的记录（`fota_meta_consume`）由 App 在确认自己跑起来
 *     之后做 —— App 本来就要写 Flash，多这一条记录不增加任何依赖；
 *   · 引导器因此完全不需要 HAL、不需要 tick 时基、不需要链接 Flash 驱动
 *     （它连 HAL 都不进构建，见 bootloader_CMakeLists.txt）。
 *
 * 用宏显式排除，而不是指望 `--gc-sections` 碰巧把未调用的写函数扔掉 ——
 * 前者是约束，后者是运气。
 * =========================================================================== */
#ifndef FOTA_META_READ_ONLY

/* ---- Flash 锁状态的保存 / 恢复 ---------------------------------------------
 *
 * 锁状态是**可读的运行期状态**：`FLASH_CR` 的 LOCK 位（bit31），
 * `HAL_FLASH_Unlock()` 自己就是读它来决定要不要走密钥序列的。
 *
 * 本模块的写路径必须把锁状态**恢复成进来时的样子**。理由不是洁癖：
 * `drv_fota` 在整段传输期间保持解锁（每帧要写暂存区），中途调一次元数据
 * 写入若有副作用地上了锁，后续的暂存区编程就会以"Flash 被锁"告终 ——
 * 而症状只是一个 `FOTA_E_FLASH`，离根因（有人偷偷上了锁）很远。
 * L5 台架就是这么抓到的：第一条 DATA 只写进去 8 字节就报 Flash 错误。
 *
 * 另一种写法是"约定调用方自己 unlock/lock"，但那要求每个调用点都记得
 * 这件事 —— 而"记得"不是约束。让被调用方恢复原状，调用点就无需知情。
 */
static uint32_t fota_meta_lock_save(void)
{
    return ((FLASH->CR & FLASH_CR_LOCK) != 0U) ? 1U : 0U;
}

static void fota_meta_lock_restore(uint32_t was_locked)
{
    if (was_locked != 0U) {
        (void)HAL_FLASH_Lock();           /* 进来时是锁的 ⇒ 出去时也锁上 */
    }
    /* 进来时是解锁的 ⇒ **不上锁**，交还给调用方继续用 */
}

static void fota_meta_put32(uint8_t *buf, uint32_t off, uint32_t val)
{
    memcpy(&buf[off], &val, 4);
}

static void fota_meta_put16(uint8_t *buf, uint32_t off, uint16_t val)
{
    memcpy(&buf[off], &val, 2);
}

/* ===========================================================================
 * 2. 页号换算（drv_fota 也用它）
 *
 * 纯写路径：只有"擦除"需要页号，而引导器不擦任何东西。
 * =========================================================================== */

void fota_flash_locate(uint32_t abs_addr, uint32_t *page_no, uint32_t *bank)
{
    uint32_t total     = (uint32_t)FLASH_SIZE;
    /* ⚠️ 位号必须是真源里的 `FLASH_OPTR_DUAL_BANK`（bit21）。早先这里用的是
     * mock 自己发明的 `FLASH_OPTR_DBANK_BIT (1UL << 15)` —— 目标上编不过，
     * 主机上则永远读到 0（bit15 是保留位）⇒ 恒判单 bank。 */
    uint32_t dbank     = ((FLASH->OPTR & FLASH_OPTR_DUAL_BANK) != 0U) ? 1U : 0U;
    uint32_t bank_size = (dbank != 0U) ? (total / 2U) : total;
    uint32_t off       = abs_addr - (uint32_t)FLASH_BASE;
    uint32_t second    = ((dbank != 0U) && (off >= bank_size)) ? 1U : 0U;

    if (page_no != NULL) {
        /* 双 bank：bank 内页号；单 bank：全局页号。两者都能写成
         * `(off - second*bank_size) / page`。 */
        *page_no = (off - (second * bank_size)) / FOTA_FLASH_PAGE_SIZE;
    }
    if (bank != NULL) {
        *bank = (second != 0U) ? (uint32_t)FLASH_BANK_2 : (uint32_t)FLASH_BANK_1;
    }
}

static int fota_meta_erase_page(void)
{
    FLASH_EraseInitTypeDef ei;
    uint32_t page_error = 0U;

    ei.TypeErase = FLASH_TYPEERASE_PAGES;
    fota_flash_locate(FOTA_META_PAGE_BASE, &ei.Page, &ei.Banks);
    ei.NbPages   = 1U;

    if (HAL_FLASHEx_Erase(&ei, &page_error) != HAL_OK) {
        return -1;
    }
    return 0;
}

/* ===========================================================================
 * 4. 追加（唯一的写路径 = 提交点）
 * =========================================================================== */

int fota_meta_append(uint32_t state, uint32_t slot, uint32_t staged)
{
    uint32_t i;
    uint32_t free_idx = FOTA_META_SEQ_INVALID;   /* 0xFFFFFFFF = 没找到 */
    uint32_t max_seq  = 0U;
    uint32_t addr;
    uint32_t off;
    uint8_t  buf[FOTA_META_RECORD_SIZE];
    uint16_t crc;
    uint32_t was_locked = fota_meta_lock_save();

    /* 一次扫描同时拿到"第一个可写槽"与"当前最大 seq"。
     * 不能找到空槽就 break：被打断的记录占着非 0xFF 的首字，空槽之前
     * 可能还有一条**更早但有效**的记录，而 seq 必须从它继续。 */
    for (i = 0U; i < FOTA_META_RECORD_COUNT; i++) {
        fota_meta_t rec;
        uint32_t    base = FOTA_META_PAGE_BASE + (i * FOTA_META_RECORD_SIZE);

        if (fota_meta_rd32(base) == FOTA_META_SEQ_INVALID) {
            /* 首字是擦除值 ⇒ 整条都没被写过（Flash 只能 1→0）。 */
            if (free_idx == FOTA_META_SEQ_INVALID) {
                free_idx = i;
            }
            continue;
        }
        if (fota_meta_rec_valid(base, &rec) && rec.seq > max_seq) {
            max_seq = rec.seq;
        }
    }

    if (HAL_FLASH_Unlock() != HAL_OK) {
        return -1;
    }

    if (free_idx == FOTA_META_SEQ_INVALID) {
        /* 页满。擦页前 `max_seq` 已经在内存里，所以擦完仍能用 max_seq+1
         * 继续单调 —— 但如果**擦完立刻掉电**，页是空的，"没有记录"
         * 与"seq 回绕"是两件不同的事，扫描时不会混淆（空页 ⇒ load 返回 -1）。 */
        if (fota_meta_erase_page() != 0) {
            fota_meta_lock_restore(was_locked);
            return -1;
        }
        free_idx = 0U;
    }

    /* 组装。pad 保持 0xFF（擦除值），不参与 CRC。 */
    (void)memset(buf, 0xFF, sizeof(buf));
    fota_meta_put32(buf, FOTA_META_OFF_MAGIC,  FOTA_META_MAGIC);
    fota_meta_put32(buf, FOTA_META_OFF_SEQ,    max_seq + 1U);
    fota_meta_put32(buf, FOTA_META_OFF_STATE,  state);
    fota_meta_put32(buf, FOTA_META_OFF_SLOT,   slot);
    fota_meta_put32(buf, FOTA_META_OFF_STAGED, staged);
    crc = fota_meta_crc16(buf, FOTA_META_CRC16_LEN);
    fota_meta_put16(buf, FOTA_META_OFF_CRC16,  crc);

    /* 按双字顺序落盘。**校验值所在的第 3 个双字最后写** —— 这就是"提交点
     * 最后"：被打断时 magic 已就位而 CRC 还是 0xFF，于是新记录校验不过、
     * 被跳过，旧记录继续有效。反过来先写校验值就会留下"校验通过但内容是
     * 半截"的记录，那是最坏的一种状态。 */
    addr = FOTA_META_PAGE_BASE + (free_idx * FOTA_META_RECORD_SIZE);
    for (off = 0U; off < FOTA_META_RECORD_SIZE; off += 8U) {
        uint64_t dw;
        memcpy(&dw, &buf[off], 8);
        if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD,
                              addr + off, dw) != HAL_OK) {
            fota_meta_lock_restore(was_locked);
            return -1;                    /* 没有产生新记录，旧记录仍有效 */
        }
    }

    fota_meta_lock_restore(was_locked);
    return 0;
}

int fota_meta_consume(void)
{
    return fota_meta_append(FOTA_META_STATE_IDLE, FOTA_META_SLOT_NONE, 0U);
}

int fota_meta_reserve(uint32_t slots_needed, int *erased_out)
{
    uint32_t i;
    uint32_t free_slots = 0U;
    uint32_t was_locked = fota_meta_lock_save();

    if (erased_out != NULL) {
        *erased_out = 0;
    }

    for (i = 0U; i < FOTA_META_RECORD_COUNT; i++) {
        uint32_t base = FOTA_META_PAGE_BASE + (i * FOTA_META_RECORD_SIZE);
        /* 首字是擦除值 ⇒ 整条未写过（Flash 只能 1→0）。 */
        if (fota_meta_rd32(base) == FOTA_META_SEQ_INVALID) {
            free_slots++;
        }
    }

    if (free_slots >= slots_needed) {
        return 0;                          /* 够用，不动 Flash */
    }

    /* 不够：现在就擦，把"整页元数据同时消失"的窗口挪到安全时机。
     * 此刻调用方还没开始接收数据，丢掉记录最坏也只是让主机多传一遍
     * START —— 而不是在收了几百 KB 之后突然丢掉断点。 */
    if (HAL_FLASH_Unlock() != HAL_OK) {
        return -1;
    }
    if (fota_meta_erase_page() != 0) {
        fota_meta_lock_restore(was_locked);
        return -1;
    }
    fota_meta_lock_restore(was_locked);

    if (erased_out != NULL) {
        *erased_out = 1;
    }
    return 0;
}

#endif /* !FOTA_META_READ_ONLY */
