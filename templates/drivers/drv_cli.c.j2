        out("Heap        : %u / %u bytes (used / total)\r\n",
            (unsigned)used_heap, (unsigned)configTOTAL_HEAP_SIZE);
    }

    {
        unsigned long used_flash  = (unsigned long)&_etext - 0x08000000UL;
        unsigned long total_flash = {{ flash_kb }}UL * 1024UL;
        out("Flash       : %lu / %lu bytes (used / total)\r\n",
            used_flash, total_flash);
    }
