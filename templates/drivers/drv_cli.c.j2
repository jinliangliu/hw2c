{% if has_pid_ctrl %}
/* ---- Solenoid PID pressure control ---- */
int {{ pid_comp.name }}_set_setpoint(float kpa);
int {{ pid_comp.name }}_start(void);
int {{ pid_comp.name }}_stop(void);
int {{ pid_comp.name }}_vent(void);
int {{ pid_comp.name }}_reset_fault(void);
int {{ pid_comp.name }}_start_autotune(float target, int cycles);
int {{ pid_comp.name }}_get_autotune(int *active, const char **stage,
                                    float *target);
int {{ pid_comp.name }}_get_status(float *pressure, float *setpoint,
                                  uint32_t *duty, uint32_t *stage,
                                  uint32_t *fault);
const char *{{ pid_comp.name }}_stage_name(void);
static void cmd_solenoid(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) {
        out("Usage: solenoid start [val] | stop | vent | set <val> | "
            "tune <target> [cycles] | reset | status\r\n");
        return;
    }
    if (strcmp(argv[1], "start") == 0) {
        if (argc >= 3) {
            float kpa;
            if (sscanf(argv[2], "%f", &kpa) == 1) {
                out("solenoid: %s\r\n",
                    ({{ pid_comp.name }}_set_setpoint(kpa) == 0)
                        ? "ramp up started" : "rejected (range/fault)");
                return;
            }
        }
        out("solenoid: %s\r\n",
            ({{ pid_comp.name }}_start() == 0) ? "started" : "not ready/fault");
    } else if (strcmp(argv[1], "stop") == 0) {
        {{ pid_comp.name }}_stop();
        out("solenoid stopped\r\n");
    } else if (strcmp(argv[1], "vent") == 0) {
        {{ pid_comp.name }}_vent();
        out("solenoid venting\r\n");
    } else if (strcmp(argv[1], "set") == 0 && argc >= 3) {
        float kpa;
        if (sscanf(argv[2], "%f", &kpa) == 1) {
            out("solenoid: %s\r\n",
                ({{ pid_comp.name }}_set_setpoint(kpa) == 0)
                    ? "setpoint updated" : "rejected (range/fault)");
        } else {
            out("Usage: solenoid set <kpa>\r\n");
        }
    } else if (strcmp(argv[1], "reset") == 0) {
        {{ pid_comp.name }}_reset_fault();
        out("solenoid fault cleared\r\n");
    } else if (strcmp(argv[1], "tune") == 0 && argc >= 3) {
        float target;
        int cycles = 2;
        if (sscanf(argv[2], "%f", &target) != 1) {
            out("Usage: solenoid tune <target> [cycles]\r\n");
            return;
        }
        if (argc >= 4) {
            sscanf(argv[3], "%d", &cycles);
        }
        out("solenoid: %s\r\n",
            ({{ pid_comp.name }}_start_autotune(target, cycles) == 0)
                ? "autotune started" : "rejected (range/busy)");
    } else if (strcmp(argv[1], "status") == 0) {
        float p = 0.0f, sp = 0.0f;
        uint32_t duty = 0, stage = 0, fault = 0;
        int tune_active = 0;
        const char *tune_stage = "-";
        float tune_target = 0.0f;
        if ({{ pid_comp.name }}_get_status(&p, &sp, &duty, &stage, &fault) != 0) {
            out("solenoid not ready\r\n");
            return;
        }
        (void){{ pid_comp.name }}_get_autotune(&tune_active, &tune_stage,
                                               &tune_target);
        out("solenoid: stage=%s pressure=%.1fkPa setpoint=%.1fkPa "
            "duty=%lu%% fault=%lu tune=%s%s%s\r\n",
            {{ pid_comp.name }}_stage_name(), (double)p, (double)sp,
            (unsigned long)duty, (unsigned long)fault,
            tune_active ? "ACTIVE(" : "-", tune_stage,
            tune_active ? ")" : "");
    } else {
        out("Unknown solenoid subcommand: %s\r\n", argv[1]);
    }
}
{% endif %}

