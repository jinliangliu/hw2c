{% if has_led %}
static void cmd_led(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) { out("Usage: led on|off|toggle\r\n"); return; }
    /* Drive the LED component pattern instead of poking the GPIO: the
     * component step re-writes the pin every period, so a direct write
     * would be overwritten within 50 ms. */
    if (strcmp(argv[1], "on") == 0) {
        led_set_pattern_by_index(0, LED_PATTERN_ON);
        out("LED ON\r\n");
    } else if (strcmp(argv[1], "off") == 0) {
        led_set_pattern_by_index(0, LED_PATTERN_OFF);
        out("LED OFF\r\n");
    } else if (strcmp(argv[1], "toggle") == 0) {
        led_toggle_pattern(0);
        out("LED TOGGLED\r\n");
    } else {
        out("Usage: led on|off|toggle\r\n");
    }
}
{% endif %}

