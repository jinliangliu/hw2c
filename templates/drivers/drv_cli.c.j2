{% if has_pwm %}
/* ---- PWM: per-channel duty + frequency ---- */
{% set pwm_peri = peripherals | selectattr('type', 'eq', 'Internal_PWM') | first %}
static void cmd_pwm(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) {
        out("Usage: pwm list | pwm set <ch> <0-100> | pwm freq <hz>\r\n");
        return;
    }
    if (strcmp(argv[1], "list") == 0) {
        uint32_t ch;
        for (ch = 1; ch <= PWM_CHANNEL_COUNT; ch++) {
            uint32_t duty = {{ pwm_peri.name }}_get_duty((uint8_t)ch);
            out("CH%lu: %lu%%\r\n", (unsigned long)ch, (unsigned long)duty);
        }
    } else if (strcmp(argv[1], "set") == 0 && argc >= 4) {
        unsigned ch, pct;
        if (sscanf(argv[2], "%u", &ch) != 1 ||
            sscanf(argv[3], "%u", &pct) != 1) {
            out("Usage: pwm set <ch> <0-100>\r\n");
            return;
        }
        if ({{ pwm_peri.name }}_set_duty((uint8_t)ch, pct) == 0) {
            out("CH%u duty -> %u%%\r\n", ch, pct);
        } else {
            out("pwm set failed (channel or range)\r\n");
        }
    } else if (strcmp(argv[1], "freq") == 0 && argc >= 3) {
        unsigned hz;
        if (sscanf(argv[2], "%u", &hz) != 1) {
            out("Usage: pwm freq <hz>\r\n");
            return;
        }
        if ({{ pwm_peri.name }}_set_freq(hz) == 0) {
            out("PWM frequency -> %u Hz (duty preserved)\r\n", hz);
        } else {
            out("pwm freq failed (100..100000 Hz)\r\n");
        }
    } else {
        out("Usage: pwm list | pwm set <ch> <0-100> | pwm freq <hz>\r\n");
    }
}
{% endif %}

{% if has_i2c %}
/* ---- I2C bus tool: scan / read / write (multi-device aware) ---- */
{% set i2c_first = (peripherals | selectattr('model.interface', 'eq', 'I2C') | map(attribute='bus') | list)[0] %}
static i2c_handle_t cli_i2c_bus(void)
{
    static i2c_handle_t h = NULL;
    if (h == NULL) {
        h = i2c_open("{{ i2c_first | lower }}", NULL);
    }
    return h;
}

static void cmd_i2c(int argc, char *argv[], cli_output_fn out)
{
    i2c_handle_t h = cli_i2c_bus();
    if (h == NULL) {
        out("I2C bus unavailable\r\n");
        return;
    }
    if (argc < 2) {
        out("Usage: i2c scan | i2c rd <dev> <reg> [len] | i2c wr <dev> <reg> <b0> [b1..]\r\n");
        return;
    }
    if (strcmp(argv[1], "scan") == 0) {
        uint8_t found[16];
        int n = i2c_scan(h, found, sizeof(found), 3);
        out("I2C scan: %d device(s) on %s\r\n", n, i2c_name(h));
        for (int i = 0; i < n && i < (int)sizeof(found); i++) {
            out("  0x%02X\r\n", found[i]);
        }
    } else if (strcmp(argv[1], "rd") == 0 && argc >= 4) {
        unsigned dev = 0, reg = 0, len = 1;
        uint8_t buf[16];
        sscanf(argv[2], "%x", &dev);
        sscanf(argv[3], "%x", &reg);
        if (argc >= 5) {
            sscanf(argv[4], "%u", &len);
        }
        if (len > sizeof(buf)) {
            len = sizeof(buf);
        }
        if (i2c_read_reg(h, (uint8_t)dev, (uint8_t)reg, buf, len, 0) == 0) {
            out("0x%02X[0x%02X]:", (unsigned)dev, (unsigned)reg);
            for (unsigned i = 0; i < len; i++) {
                out(" %02X", buf[i]);
            }
            out("\r\n");
        } else {
            out("I2C read failed (dev 0x%02X)\r\n", (unsigned)dev);
        }
    } else if (strcmp(argv[1], "wr") == 0 && argc >= 5) {
        unsigned dev = 0, reg = 0, v;
        uint8_t buf[8];
        int n = 0;
        sscanf(argv[2], "%x", &dev);
        sscanf(argv[3], "%x", &reg);
        for (int i = 4; i < argc && n < (int)sizeof(buf); i++) {
            if (sscanf(argv[i], "%x", &v) == 1) {
                buf[n++] = (uint8_t)v;
            }
        }
        if (i2c_write_reg(h, (uint8_t)dev, (uint8_t)reg, buf, (uint32_t)n, 0) == 0) {
            out("Wrote %d byte(s) to 0x%02X[0x%02X]\r\n", n, (unsigned)dev, (unsigned)reg);
        } else {
            out("I2C write failed (dev 0x%02X)\r\n", (unsigned)dev);
        }
    } else {
        out("Usage: i2c scan | i2c rd <dev> <reg> [len] | i2c wr <dev> <reg> <b0> [b1..]\r\n");
    }
}
{% endif %}

