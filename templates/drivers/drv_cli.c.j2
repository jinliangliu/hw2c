{% if has_power_mgr %}
static void cmd_power(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) {
        out("Usage: power mode <RUN|SLEEP|STOP0|STOP1> | power sleep | power info\r\n");
        out("Current allowed: %s\r\n", power_mode_name(power_mgr_allowed_depth()));
        return;
    }
    if (strcmp(argv[1], "mode") == 0 && argc >= 3) {
        power_mode_t m = POWER_MODE_MAX;
        for (int i = POWER_MODE_RUN; i < POWER_MODE_MAX; i++) {
            if (cli_strcasecmp(argv[2], power_mode_name((power_mode_t)i)) == 0) {
                m = (power_mode_t)i;
                break;
            }
        }
        if (m == POWER_MODE_MAX || m > POWER_MODE_STOP1) {
            out("Unsupported mode: %s (use RUN/SLEEP/STOP0/STOP1)\r\n", argv[2]);
            return;
        }
        power_mgr_set_default(m);
        out("Power mode set to %s\r\n", power_mode_name(m));
    } else if (strcmp(argv[1], "sleep") == 0) {
        /* Explicit debug path: enter the mode selected with "power mode".
         * (The automatic tickless path uses power_mgr_allowed_depth().) */
        power_mode_t m = power_mgr_get_default();
        if (m == POWER_MODE_RUN) {
            out("Allowed depth is RUN - nothing to sleep into.\r\n");
            return;
        }
        out("Entering %s (wake by RTC 1s / UART RX / button)...\r\n",
            power_mode_name(m));
        uint32_t elapsed = power_sleep_now(m);
        /* Note: the RTC calendar (authoritative system time) and the HAL
         * tick are compensated inside power_sleep_now(). The FreeRTOS tick
         * is intentionally not stepped here (vTaskStepTick() is only valid
         * from the idle-task tickless path), so tasks simply resume after
         * the sleep with their delays extended. */
        out("Woke up after %lu ms, RTC keeps time, RAM intact.\r\n",
            (unsigned long)elapsed);
    } else if (strcmp(argv[1], "info") == 0) {
        power_mgr_log_status();
    } else {
        out("Unknown power subcommand: %s\r\n", argv[1]);
    }
}
