{% if has_rtc %}
static void cmd_rtc(int argc, char *argv[], cli_output_fn out)
{
    if (argc < 2) {
        out("Usage: rtc time | rtc set <HH:MM:SS>\r\n");
        return;
    }
    if (strcmp(argv[1], "time") == 0) {
        RTC_TimeTypeDef t;
        RTC_DateTypeDef d;
        HAL_RTC_GetTime(&hrtc, &t, RTC_FORMAT_BIN);
        HAL_RTC_GetDate(&hrtc, &d, RTC_FORMAT_BIN);
        out("RTC Time: %02d:%02d:%02d  Date: %02d/%02d/%02d\r\n",
            t.Hours, t.Minutes, t.Seconds,
            d.Date, d.Month, (int)d.Year + 2000);
    } else if (strcmp(argv[1], "set") == 0) {
        int hh, mm, ss;
        if (argc < 3) { out("Usage: rtc set <HH:MM:SS>\r\n"); return; }
        if (sscanf(argv[2], "%d:%d:%d", &hh, &mm, &ss) != 3) {
            out("Invalid time format. Use HH:MM:SS\r\n");
            return;
        }
        {
            /* Preserve the current date, apply the new time via the RTC
             * driver so the uptime epoch and all timer deadlines are
             * rescheduled consistently. */
            rtc_time_t now = {0};
            RTC_GetTime(&now);
            now.hour  = (uint8_t)hh;
            now.min   = (uint8_t)mm;
            now.sec   = (uint8_t)ss;
            RTC_SetTime(&now);
            out("RTC time set to %02d:%02d:%02d\r\n", hh, mm, ss);
        }
    } else {
        out("Unknown rtc subcommand: %s\r\n", argv[1]);
    }
}
{% endif %}

