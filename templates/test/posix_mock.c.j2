void i2c_mock_add_device(const char *bus_name, uint8_t addr,
                         const uint8_t *init, uint32_t len)
{
    struct i2c_dev *b = i2c_mock_alloc_bus(bus_name);
    if (b == NULL) {
        return;
    }
    for (int i = 0; i < MOCK_I2C_MAX_DEVICES; i++) {
        if (!b->devs[i].present) {
            b->devs[i].addr = addr;
            b->devs[i].present = 1;
            memset(b->devs[i].mem, 0, MOCK_I2C_MEM_SIZE);
            if (init != NULL) {
                if (len > MOCK_I2C_MEM_SIZE) {
                    len = MOCK_I2C_MEM_SIZE;
                }
                memcpy(b->devs[i].mem, init, len);
            }
            return;
        }
    }
}

void i2c_mock_set_reg(const char *bus_name, uint8_t addr, uint8_t reg, uint8_t val)
{
    struct i2c_dev *b = i2c_mock_find_bus(bus_name);
    uint8_t *mem = (b != NULL) ? i2c_mock_find_mem(b, addr) : NULL;
    if (mem != NULL && reg < MOCK_I2C_MEM_SIZE) {
        mem[reg] = val;
    }
}

uint8_t i2c_mock_get_reg(const char *bus_name, uint8_t addr, uint8_t reg)
{
    struct i2c_dev *b = i2c_mock_find_bus(bus_name);
    uint8_t *mem = (b != NULL) ? i2c_mock_find_mem(b, addr) : NULL;
    if (mem != NULL && reg < MOCK_I2C_MEM_SIZE) {
        return mem[reg];
    }
    return 0;
}

uint32_t i2c_mock_read_count(void)  { return g_i2c_read_calls; }
uint32_t i2c_mock_write_count(void) { return g_i2c_write_calls; }

void i2c_mock_reset_all(void)
{
    memset(g_i2c_buses, 0, sizeof(g_i2c_buses));
    g_i2c_read_calls  = 0;
    g_i2c_write_calls = 0;
    /* Preload a default MPU6050 so component init() succeeds */
    i2c_mock_add_device("i2c1", 0x68, NULL, 0);
    i2c_mock_set_reg("i2c1", 0x68, 0x75, 0x68);
    /* Preload an AS5600 magnetic encoder so FOC motor init() succeeds */
    i2c_mock_add_device("i2c1", 0x36, NULL, 0);
}
