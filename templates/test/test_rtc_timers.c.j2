#include "unity.h"
#include "mock_hal.h"
#include <string.h>

QueueHandle_t event_queue = NULL; /* 与 test_rtc 相同 */

/* drv_rtc.c 初始化失败时走失效安全路径；真实实现会牵连执行器驱动，
 * 故此处用测试侧的记录桩提供该符号。 */
#include "fault_trap_stub.c"

#include "../src/drivers/drv_rtc.c"

static int callback_count = 0;
static void test_timer_a_cb(void *arg) {
    (void)arg;
    callback_count++;
}

void setUp(void) {
    callback_count = 0;
    /* 初始化 RTC（使用 mock） */
    RTC_Init();
}

void tearDown(void) {}

void test_CreateMultipleTimers(void) {
    rtc_timer_handle_t t1 = RTC_TimerCreate(1, RTC_TIMER_MODE_ONE_SHOT, NULL, NULL);
    rtc_timer_handle_t t2 = RTC_TimerCreate(2, RTC_TIMER_MODE_PERIODIC_SEC, test_timer_a_cb, NULL);
    TEST_ASSERT_NOT_NULL(t1);
    TEST_ASSERT_NOT_NULL(t2);
    RTC_TimerDelete(t2);
    RTC_TimerDelete(t1);
}

void test_SortedInsertOrder(void) {
    /* Create timers with increasing deadlines and verify sorted order */
    rtc_timer_handle_t t3 = RTC_TimerCreate(3, RTC_TIMER_MODE_ONE_SHOT, NULL, NULL);
    rtc_timer_handle_t t1 = RTC_TimerCreate(1, RTC_TIMER_MODE_ONE_SHOT, NULL, NULL);
    rtc_timer_handle_t t2 = RTC_TimerCreate(2, RTC_TIMER_MODE_ONE_SHOT, NULL, NULL);

    TEST_ASSERT_NOT_NULL(t1);
    TEST_ASSERT_NOT_NULL(t2);
    TEST_ASSERT_NOT_NULL(t3);

    RTC_TimerDelete(t1);
    RTC_TimerDelete(t2);
    RTC_TimerDelete(t3);
}

int main(void) {
    UNITY_BEGIN();
    RUN_TEST(test_CreateMultipleTimers);
    RUN_TEST(test_SortedInsertOrder);
    return UNITY_END();
}
