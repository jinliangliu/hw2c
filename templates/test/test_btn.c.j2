 * -------------------------------------------------------------------------- */

void test_nvm_stub_load_of_absent_key_reports_not_found(void)
{
    uint8_t r[4] = {0};
    uint16_t n = 0;
    TEST_ASSERT_EQUAL_INT(NVM_PARAM_E_NOT_FOUND, nvm_param_load(0x1234U, r, sizeof(r), &n));
}

void test_nvm_stub_save_then_load_round_trips(void)
{
    uint8_t w[4] = {0x11, 0x22, 0x33, 0x44};
    uint8_t r[4] = {0};
    uint16_t n = 0;

    TEST_ASSERT_EQUAL_INT(NVM_PARAM_OK, nvm_param_save(0x1234U, w, sizeof(w)));
    TEST_ASSERT_EQUAL_INT(NVM_PARAM_OK, nvm_param_load(0x1234U, r, sizeof(r), &n));
    TEST_ASSERT_EQUAL_UINT16(sizeof(w), n);
    TEST_ASSERT_EQUAL_UINT8_ARRAY(w, r, sizeof(w));

    /* 同 key 覆盖写：取回的必须是后写的值 */
    uint8_t w2[4] = {0xAA, 0xBB, 0xCC, 0xDD};
    TEST_ASSERT_EQUAL_INT(NVM_PARAM_OK, nvm_param_save(0x1234U, w2, sizeof(w2)));
    TEST_ASSERT_EQUAL_INT(NVM_PARAM_OK, nvm_param_load(0x1234U, r, sizeof(r), &n));
    TEST_ASSERT_EQUAL_UINT8_ARRAY(w2, r, sizeof(w2));

    /* 另一个 key 不能读到它 */
    TEST_ASSERT_EQUAL_INT(NVM_PARAM_E_NOT_FOUND, nvm_param_load(0x5678U, r, sizeof(r), &n));
}
