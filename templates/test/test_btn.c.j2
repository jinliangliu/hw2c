/* ---- nvm_param 持久化层替身 ----
 *
 * param_registry.c 在"有 persistent 参数"时会调 nvm_param_load/save，真链是
 *     param_registry → nvm_param → spi_flash（NOR 模型）
 * 本用例只测按键手势，不测持久化，所以在这里给一个 RAM 版替身。
 * 不这么做的话，测试根本链接不过（undefined reference to 'nvm_param_load'）。
 *
 * 语义必须与真实实现一致，**不能**做成"永远 NOT_FOUND"的空壳 —— 那样
 * "存下来还能读回"这条路径在本用例里就永远没有意义（见 test_nvm_stub_*）：
 *   · 没存过的 key          → NVM_PARAM_E_NOT_FOUND（param_init 于是保持编译期默认值）
 *   · save 之后 load 同 key → 取回同样的字节
 */
#define NVM_STUB_SLOTS  16
#define NVM_STUB_MAXLEN 16

static struct {
    uint16_t key;
    uint16_t len;
    uint8_t  used;
    uint8_t  buf[NVM_STUB_MAXLEN];
} g_nvm_stub[NVM_STUB_SLOTS];

static void nvm_stub_reset(void)
{
    memset(g_nvm_stub, 0, sizeof(g_nvm_stub));
}

int nvm_param_load(uint16_t key, uint8_t *out, uint16_t max_len, uint16_t *out_len)
{
    if (out == NULL) {
        return NVM_PARAM_E_ARG;
    }
    for (uint32_t i = 0; i < NVM_STUB_SLOTS; i++) {
        if (g_nvm_stub[i].used && g_nvm_stub[i].key == key) {
            if (g_nvm_stub[i].len > max_len) {
                return NVM_PARAM_E_SIZE;
            }
            memcpy(out, g_nvm_stub[i].buf, g_nvm_stub[i].len);
            if (out_len != NULL) {
                *out_len = g_nvm_stub[i].len;
            }
            return NVM_PARAM_OK;
        }
    }
    return NVM_PARAM_E_NOT_FOUND;
}

int nvm_param_save(uint16_t key, const uint8_t *data, uint16_t len)
{
    if (data == NULL || len == 0U) {
        return NVM_PARAM_E_ARG;
    }
    if (len > NVM_STUB_MAXLEN) {
        return NVM_PARAM_E_SIZE;
    }
    uint32_t slot = NVM_STUB_SLOTS;
    for (uint32_t i = 0; i < NVM_STUB_SLOTS; i++) {
        if (g_nvm_stub[i].used && g_nvm_stub[i].key == key) {
            slot = i;            /* 同 key 覆盖写 */
            break;
        }
        if (!g_nvm_stub[i].used && slot == NVM_STUB_SLOTS) {
            slot = i;            /* 记住第一个空位，但继续找同 key */
        }
    }
    if (slot == NVM_STUB_SLOTS) {
        return NVM_PARAM_E_IO;   /* 槽位耗尽 */
    }
    g_nvm_stub[slot].key  = key;
    g_nvm_stub[slot].len  = len;
    g_nvm_stub[slot].used = 1U;
    memcpy(g_nvm_stub[slot].buf, data, len);
    return NVM_PARAM_OK;
}
