int main(void)
{
    UNITY_BEGIN();

    RUN_TEST(test_crc_helpers_match_the_standard_kat);
    RUN_TEST(test_control_bytes_follow_the_standard);
    RUN_TEST(test_block_buffer_is_exactly_the_largest_block);
    RUN_TEST(test_the_block_number_modulus_does_not_survive_a_narrowing_cast);

    RUN_TEST(test_begin_sends_one_crc_request_and_takes_over_the_uart);
    RUN_TEST(test_process_does_not_resend_the_crc_request_early);
    RUN_TEST(test_handshake_timeout_returns_the_uart_as_idle_not_error);

    RUN_TEST(test_header_block_with_an_xmodem_crc_is_acked_and_parsed);
    RUN_TEST(test_the_post_header_crc_request_is_sent_once_and_not_periodically);
    RUN_TEST(test_the_same_block_with_a_ccitt_false_crc_is_naked);
    RUN_TEST(test_a_broken_block_complement_is_naked_even_with_a_good_crc);
    RUN_TEST(test_a_data_block_before_the_header_is_naked);
    RUN_TEST(test_a_repeated_header_block_is_acked_as_a_duplicate);

    RUN_TEST(test_an_end_block_after_the_header_aborts_the_batch);
    RUN_TEST(test_one_can_is_noise_but_two_at_a_block_boundary_abort);
    RUN_TEST(test_can_bytes_inside_a_block_are_payload_not_an_abort);

    return UNITY_END();
}
