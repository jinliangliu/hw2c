/* ---- Test: pub/sub integration ---- */
{% if topics | length > 0 %}
static topic_id_t g_last_topic = TOPIC_NONE;
static uint32_t   g_last_value = 0;

static void bus_handler_stub(topic_id_t topic, uint32_t value, void *ctx)
{
    (void)ctx;
    g_last_topic = topic;
    g_last_value = value;
}

void test_bus_publish_notifies_subscriber(void)
{
    bus_init();
    g_last_topic = TOPIC_NONE;
    g_last_value = 0;

    int ret = bus_subscribe(TOPIC_{{ topics[0].name | upper }}, bus_handler_stub, NULL);
    TEST_ASSERT_EQUAL_INT(0, ret);

    int notified = bus_publish(TOPIC_{{ topics[0].name | upper }}, 42);
    TEST_ASSERT_EQUAL_INT(1, notified);
    TEST_ASSERT_EQUAL_INT(TOPIC_{{ topics[0].name | upper }}, g_last_topic);
    TEST_ASSERT_EQUAL_UINT32(42, g_last_value);
}

void test_bus_publish_ignores_unsubscribed_topics(void)
{
    bus_init();
    g_last_topic = TOPIC_NONE;

    int notified = bus_publish(TOPIC_{{ topics[0].name | upper }}, 99);
    TEST_ASSERT_EQUAL_INT(0, notified);
    TEST_ASSERT_EQUAL_INT(TOPIC_NONE, g_last_topic);
}

void test_bus_unsubscribe_stops_notifications(void)
{
    bus_init();
    g_last_value = 0;

    bus_subscribe(TOPIC_{{ topics[0].name | upper }}, bus_handler_stub, NULL);
    bus_unsubscribe(TOPIC_{{ topics[0].name | upper }}, bus_handler_stub);
    bus_publish(TOPIC_{{ topics[0].name | upper }}, 100);
    TEST_ASSERT_EQUAL_UINT32(0, g_last_value);
}
