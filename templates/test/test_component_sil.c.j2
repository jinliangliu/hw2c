{% if has_pid_ctrl %}
/* ---- Test: PID solenoid closed-loop pressure simulation ---- */
{% set pid_pressure = peripherals | selectattr('type', 'eq', 'I2C_Pressure') | first %}
{% set pid_pwm = peripherals | selectattr('type', 'eq', 'Internal_PWM') | first %}
{% set pid_comp = components | selectattr('type', 'eq', 'pid_ctrl') | first %}
static void pid_sim_set_pressure(float kpa)
{
    /* mock I2C pressure sensor: raw = kpa / scale, 24-bit big-endian */
    uint32_t raw = (uint32_t)(kpa / {{ pid_pressure.get('extra', {}).get('scale_kpa_per_lsb', 0.001) }});
    i2c_mock_set_reg("{{ pid_pressure.bus }}", {{ pid_pressure.address }},
                     {{ pid_pressure.get('extra', {}).get('reg_start', 0) }},
                     (uint8_t)((raw >> 16) & 0xFF));
    i2c_mock_set_reg("{{ pid_pressure.bus }}", {{ pid_pressure.address }},
                     {{ pid_pressure.get('extra', {}).get('reg_start', 0) }} + 1,
                     (uint8_t)((raw >> 8) & 0xFF));
    i2c_mock_set_reg("{{ pid_pressure.bus }}", {{ pid_pressure.address }},
                     {{ pid_pressure.get('extra', {}).get('reg_start', 0) }} + 2,
                     (uint8_t)(raw & 0xFF));
}

void test_pid_ctrl_closed_loop_reaches_target(void)
{
    component_t *comp = component_get("{{ pid_comp.name }}");
    float pressure = 0.0f, setpoint = 0.0f;
    uint32_t duty = 0, stage = 0, fault = 0;
    int i;
    TEST_ASSERT_NOT_NULL(comp);
    TEST_ASSERT_EQUAL_INT(0, {{ pid_pwm.name }}_init());  /* timer base first */
    TEST_ASSERT_EQUAL_INT(0, comp->init(comp, NULL));
    i2c_mock_add_device("{{ pid_pressure.bus }}", {{ pid_pressure.address }}, NULL, 0);
    pid_sim_set_pressure(0.0f);

    TEST_ASSERT_EQUAL_INT(0, {{ pid_comp.name }}_set_setpoint(100.0f));
    /* solenoid tank model: while the valve is open the pressure rises at
     * ~1 kPa/s per % duty; when duty == 0 the valve is closed and pressure
     * holds (slow leak ignored).  This reflects an ON/OFF valve modulated
     * by PWM average opening, not a proportional valve. */
    for (i = 0; i < 4000 && fault == 0; i++) {
        comp->step(comp);
        (void){{ pid_comp.name }}_get_status(&pressure, &setpoint, &duty,
                                            &stage, &fault);
        if (duty > 0) {
            pressure += (float)duty * 1.0f * 0.062f;
            if (pressure > 150.0f) {
                pressure = 150.0f;
            }
            pid_sim_set_pressure(pressure);
        }
    }
    (void){{ pid_comp.name }}_get_status(&pressure, &setpoint, &duty,
                                        &stage, &fault);
    TEST_ASSERT_EQUAL_UINT32(0, fault);
    TEST_ASSERT_EQUAL_UINT32(2, stage);          /* HOLD */
    TEST_ASSERT_FLOAT_WITHIN(5.0f, 100.0f, pressure);
}

void test_pid_ctrl_overpressure_trips_fault(void)
{
    component_t *comp = component_get("{{ pid_comp.name }}");
    float pressure = 0.0f, setpoint = 0.0f;
    uint32_t duty = 0, stage = 0, fault = 0;
    TEST_ASSERT_NOT_NULL(comp);
    TEST_ASSERT_EQUAL_INT(0, {{ pid_pwm.name }}_init());  /* timer base first */
    TEST_ASSERT_EQUAL_INT(0, comp->init(comp, NULL));
    i2c_mock_add_device("{{ pid_pressure.bus }}", {{ pid_pressure.address }}, NULL, 0);
    pid_sim_set_pressure(600.0f);                /* above pressure_max_kpa */
    comp->step(comp);
    (void){{ pid_comp.name }}_get_status(&pressure, &setpoint, &duty,
                                        &stage, &fault);
    TEST_ASSERT_EQUAL_UINT32(1, fault);          /* OVP */
    TEST_ASSERT_EQUAL_UINT32(4, stage);          /* FAULT */
    TEST_ASSERT_EQUAL_UINT32(0, duty);           /* valve forced closed */
}
