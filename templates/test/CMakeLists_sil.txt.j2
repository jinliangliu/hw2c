# SIL (Software-in-the-Loop) test build — x86 host, no cross-compilation
# Tests component init/step/terminate using mock POSIX drivers.
# Auto-generated by hw2c.

cmake_minimum_required(VERSION 3.16)
project(hw2c_sil_test C)

set(CMAKE_C_STANDARD 99)
set(CMAKE_C_STANDARD_REQUIRED ON)

# Enable TEST macro for mock driver includes
add_compile_definitions(TEST)

# Include paths
include_directories(
    .                       # posix_mock.h
    ${CMAKE_SOURCE_DIR}/..  # test/ (mock_hal.h)
    ${CMAKE_SOURCE_DIR}/../../src     # src/ (for component headers)
    ${CMAKE_SOURCE_DIR}/../../src/drivers  # src/drivers/ (for gpio_api.h etc.)
    # hw2c_diag.c（FR-15.7）在 has_log 的工程里会包含 drv_log.h，而 drv_log.h
    # 又包含 lwrb.h（日志环形缓冲）。vendor 的 lwrb 在仓库 static/ 下，不在
    # 上面任何一条路径里 —— 少了这条就是 "fatal error: lwrb.h: No such file"，
    # 而且只在**开了日志**的工程上冒出来。
    ${CMAKE_SOURCE_DIR}/../../../../static/third_party/lwrb
    unity
)

# Mock POSIX drivers (in-memory replacements for uart/gpio/adc) plus the
# shared HAL mock (HAL_GPIO/FreeRTOS stubs used by component sources).
add_library(posix_mock STATIC
    posix_mock.c
    ${CMAKE_SOURCE_DIR}/../mock_hal.c
)

# Main SIL test — includes all component .c files directly
add_executable(test_component_sil
    test_component_sil.c
    unity/unity.c
    ${CMAKE_SOURCE_DIR}/../../src/event_mgr.c
    # hw2c_fault.c is always generated and event_mgr.c takes its fail-safe path
    # on a failed queue allocation, so it has to be linked here (P2-3).
    ${CMAKE_SOURCE_DIR}/../../src/hw2c_fault.c
    # 诊断快照：hw2c_fault 把记录委托给它，event_mgr 也在派发前后登记 tag
    # （FR-15.7）。两者必须一起编。
    ${CMAKE_SOURCE_DIR}/../../src/hw2c_diag.c
    # hw2c_safe_state() forces every PWM actuator inactive, so every PWM driver
    # in the build is reachable from it - not just the PID one.
{% for p in peripherals | selectattr('type', 'eq', 'Internal_PWM') | list %}
    ${CMAKE_SOURCE_DIR}/../../src/drivers/drv_{{ p.name }}.c
{% endfor %}
{% if has_mpu6050 %}
    ${CMAKE_SOURCE_DIR}/../../src/attitude.c
    ${CMAKE_SOURCE_DIR}/../../src/drivers/drv_mpu6050.c
{% endif %}
{% if has_fall_detect %}
    ${CMAKE_SOURCE_DIR}/../../src/fall_detect.c
{% endif %}
{% if has_foc %}
    ${CMAKE_SOURCE_DIR}/../../src/foc_math.c
    ${CMAKE_SOURCE_DIR}/../../src/drivers/drv_{{ (peripherals | selectattr('type', 'eq', 'FOC_Motor') | first).name }}.c
{% endif %}
{% if has_pid_ctrl %}
{% set pid_sensor = peripherals | selectattr('type', 'in', ['I2C_Pressure', 'I2C_TempSensor']) | first %}
{% set pid_ntc = peripherals | selectattr('type', 'eq', 'NTC_TempSensor') | first %}
    ${CMAKE_SOURCE_DIR}/../../src/pid_math.c
    ${CMAKE_SOURCE_DIR}/../../src/pid_autotune.c
    ${CMAKE_SOURCE_DIR}/../../src/pid_steptune.c
{% if pid_sensor %}
    ${CMAKE_SOURCE_DIR}/../../src/drivers/drv_{{ pid_sensor.name }}.c
{% endif %}
{% if pid_ntc %}
    ${CMAKE_SOURCE_DIR}/../../src/drivers/drv_{{ pid_ntc.name }}.c
{% endif %}
{% endif %}
{% if has_modbus_component %}
    ${CMAKE_SOURCE_DIR}/../../src/drivers/drv_modbus.c
{% endif %}
)

target_link_libraries(test_component_sil posix_mock)

# Test runner
enable_testing()
add_test(NAME sil_component_test COMMAND test_component_sil)
