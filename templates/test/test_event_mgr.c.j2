#include "unity.h"
#include "mock_hal.h"
#include <string.h>

/* event_mgr.c takes the fail-safe path on a failed queue allocation.  The real
 * primitive drags in the actuator drivers, so use the host stand-in and assert
 * on the code it recorded (P2-3 / P1-3). */
#include "fault_trap_stub.c"

/* event_mgr.c 在每个事件派发前后登记诊断 tag（FR-15.7），所以快照模块也要
 * 进这个编译单元。 */
#include "../src/hw2c_diag.c"

#include "../src/event_mgr.c"

void setUp(void) {
    /* Keep the failure-injection knob from leaking between tests. */
    mock_xQueueCreate_fail_next(0);
    host_fault_trap_reset();
}
void tearDown(void) {}

void test_EventMgr_Init_should_create_queue(void) {
    EventMgr_Init();
    TEST_ASSERT_NOT_NULL(event_queue);
}

/* A failed allocation must take the fail-safe path: a NULL event_queue is
 * dereferenced from interrupt context (xQueueSendFromISR), which corrupts the
 * heap instead of failing cleanly (P2-3). */
void test_EventMgr_Init_should_trap_when_queue_alloc_fails(void)
{
    mock_xQueueCreate_fail_next(1);

    EventMgr_Init();

    TEST_ASSERT_EQUAL_UINT32(HW2C_FAULT_RTOS_OBJECT,
                             host_fault_trap_last_code());
    /* The trap must be taken at least once; whether the second queue creation
     * is also attempted depends on the failure mode injected. */
    TEST_ASSERT_TRUE(host_fault_trap_call_count() >= 1U);
}

void test_EventMgr_should_receive_sent_event(void) {
    EventMgr_Init();
    event_t evt = { .id = EVENT_BUTTON_PRESS, .param = 0 };
    BaseType_t ret = xQueueSend(event_queue, &evt, 0);
    TEST_ASSERT_EQUAL(pdPASS, ret);
}

void test_EventMgr_should_dispatch_button_event(void)
{
    EventMgr_Init();
    event_t evt = { .id = EVENT_BUTTON_PRESS, .param = 0 };
    xQueueSend(event_queue, &evt, 0);
    /* 由于我们无法直接验证任务内部回调，但可以验证队列非空 */
    /* 这里简单确保发送成功 */
    TEST_ASSERT_EQUAL(pdPASS, xQueueSend(event_queue, &evt, 0));
}

int main(void) {
    UNITY_BEGIN();
    RUN_TEST(test_EventMgr_Init_should_create_queue);
    RUN_TEST(test_EventMgr_Init_should_trap_when_queue_alloc_fails);
    RUN_TEST(test_EventMgr_should_receive_sent_event);
    RUN_TEST(test_EventMgr_should_dispatch_button_event);
    return UNITY_END();
}