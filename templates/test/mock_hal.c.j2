static uint32_t mock_tim_channel_index(uint32_t Channel)
{
    return (Channel >> 2U) & 0x3U;   /* TIM_CHANNEL_x -> 0..3 */
}

uint32_t mock_tim_get_compare(uint8_t channel)
{
    return (channel >= 1 && channel <= 4) ? mock_tim2_dev.CCR[channel - 1] : 0;
}

