 * 入口
 * =========================================================================== */

int main(void)
{
    UNITY_BEGIN();

    /* 1. 冷启动 */
    RUN_TEST(test_init_starts_idle_with_empty_accounting);
    RUN_TEST(test_init_does_not_claim_the_cli_stream);

    /* 2. 帧常量与缓冲 */
    RUN_TEST(test_frame_markers_are_pairwise_distinct);
    RUN_TEST(test_start_frame_holds_marker_envelope_and_crc);
    RUN_TEST(test_rx_buffer_fits_the_longest_frame);
    RUN_TEST(test_idle_timeout_is_not_zero);

    /* 3. 记录布局自洽 */
    RUN_TEST(test_record_layout_is_doubleword_programmable);
    RUN_TEST(test_slot_zero_means_none);
    RUN_TEST(test_magic_spells_fotm);
    RUN_TEST(test_state_values_are_distinct);

    /* 4. 日志式存储的语义 */
    RUN_TEST(test_empty_page_has_no_record);
    RUN_TEST(test_append_then_load_roundtrip);
    RUN_TEST(test_newest_record_wins_regardless_of_position);
    RUN_TEST(test_torn_record_is_skipped_and_the_previous_one_still_holds);
    RUN_TEST(test_a_record_with_a_broken_magic_is_skipped);
    RUN_TEST(test_page_full_erases_and_keeps_sequence_monotonic);
    RUN_TEST(test_consume_clears_the_pending_state);

    /* 5. fota_init 的状态映射表 */
    RUN_TEST(test_init_maps_receiving_to_idle);
    RUN_TEST(test_init_restores_ready_so_the_patch_can_still_be_applied);
    RUN_TEST(test_init_refuses_ready_when_the_staging_envelope_is_unreadable);
    RUN_TEST(test_init_refuses_ready_when_the_record_does_not_match_the_envelope);
    RUN_TEST(test_init_adopts_done_kind_of_record_and_consumes_it);
    RUN_TEST(test_init_reports_rollback_when_done_points_at_another_slot);
    RUN_TEST(test_init_maps_error_to_error);

    /* 6. UART 接管 / 交还 */
    RUN_TEST(test_receive_begin_takes_over_the_uart);
    RUN_TEST(test_receive_begin_twice_is_rejected_as_busy);
    RUN_TEST(test_receive_begin_is_refused_while_a_patch_waits);
    RUN_TEST(test_error_state_does_not_lock_the_device_out);
    RUN_TEST(test_abort_returns_the_uart_and_keeps_staging);
    RUN_TEST(test_abort_is_safe_without_a_session);

    /* 7. 空闲超时 */
    RUN_TEST(test_no_timeout_before_the_deadline);
    RUN_TEST(test_idle_timeout_returns_the_uart);

    /* 8. 非法时序 */
    RUN_TEST(test_apply_request_requires_ready_state);
    RUN_TEST(test_process_does_nothing_when_idle);

    return UNITY_END();
}
