/* --- TAMP --- */
typedef struct {
    __IO uint32_t CR1;
    __IO uint32_t CR2;
    uint32_t _reserved0;
    __IO uint32_t FLTCR;
    uint32_t _reserved1[3];
    __IO uint32_t SCR;
    uint32_t _reserved2;
    __IO uint32_t IER;
    __IO uint32_t SR;
    __IO uint32_t MISR;
    uint32_t _reserved3;
    __IO uint32_t SCR2;
    uint32_t _reserved4[16];
    /* BKP0R..BKP4R —— **只有 5 个**，与真实硅片一致。
     *
     * RM0444 §31.1: "5 backup registers"；§31.6.8: 偏移 0x100 + 4*x, x = 0..4。
     * vendored 的 `stm32g0b1xx.h` 里 `TAMP_TypeDef` 也正好止于 BKP4R。
     *
     * ⚠️ 这里**曾经**开满到 BKP31R，并附了一段"开满更安全"的理由 —— 那段
     * 理由方向搞反了：mock 凭空造出硅片上不存在的寄存器，等于让被测代码
     * 与替身共享同一个错误假设。P3 的 `drv_fota` 往 BKP5R..BKP9R 写元数据，
     * 主机上全绿（字段齐全、读写都对），目标上直接编不过；若绕过编译，
     * 这些地址落在保留区，写入**静默不生效**，只有跨复位才看得出来。
     * 这正是 A9（mock 让测试失效）最贵的一种：它让"测试通过"与"能用"
     * 彻底脱钩。开满不设防，只把缺陷推后。
     *
     * 护栏：`generator/tests/test_bootloader_host_tests.py` 的
     * `test_mock_tamp_matches_vendored_cmsis` 会解析两侧头文件，
     * 断言备份寄存器数量一致。 */
    __IO uint32_t BKP0R;
    __IO uint32_t BKP1R;
    __IO uint32_t BKP2R;
    __IO uint32_t BKP3R;
    __IO uint32_t BKP4R;
} TAMP_TypeDef;

#define TAMP_BASE   (0x4000B000UL)
extern volatile TAMP_TypeDef *TAMP;

