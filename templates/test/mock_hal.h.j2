/** 复位：镜像整片 0xFF、计数器归零、重新上锁、DBANK 回默认、容量回 512 KB。 */
void mock_flash_reset(void);

/**
 * @brief 把 512 KB Flash 存储建立**在它真实的地址上**（0x08000000）。
 *
 * 真机上 Flash 是内存映射的，所以生成码里 `memcpy(dst, (const void*)addr, n)`
 * 是正确写法（`drv_fota` 的读回路径正是如此）。主机上那块地址默认没有东西，
 * 同一行代码会直接段错误。把模型的存储放到真实地址，生成码就一行都不用为
 * 测试改 —— 这是"替身只替换介质、不改语义"的要求。
 *
 * 惰性调用：任何一次 `mock_flash_*` 访问都会先建立它，因此多数测试不需要
 * 显式调用。**依赖"按地址直接取 Flash"的测试必须显式调用并检查返回值** ——
 * 失败时访问器仍可用（退回内部数组），但直接按地址取会崩。
 *
 * @return 1 = 已映射到真实地址；0 = 该地址不可用（退回了内部数组）。
 */
int mock_flash_map(void);

/** @brief 存储是否真的位于 0x08000000（见 mock_flash_map）。 */
int mock_flash_is_mapped(void);

/** 512 KB 镜像起点（直接读写，用于逐字节比对）。 */
uint8_t *mock_flash_base(void);

/** 读一个字节（越界返回 0xFF）。 */
uint8_t mock_flash_peek(uint32_t addr);

/** 绕过 Flash 语义直接埋数据 —— 用来构造"非擦除态"等前置条件。 */
void mock_flash_poke(uint32_t addr, uint8_t val);

/** 设置 DBANK 选项位（1 = 双 bank 布局，0 = 单 bank）。 */
void mock_flash_set_dbank(uint32_t enabled);

/** 当前 DBANK 状态。 */
uint32_t mock_flash_get_dbank(void);

/** 覆盖器件容量（KB），用于模拟非 512 KB 的型号。 */
