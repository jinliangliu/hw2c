/* 下面 UART 段里还有一组同名宏（多一个 HAL_BUSY）。这里全部用 `#ifndef`
 * 兜住：同一个头文件把同一个常量定义两遍时，只有一个值生效，而**哪个生效
 * 取决于先后顺序** —— 改一次段落顺序就会静默改掉 HAL_TIMEOUT 的值
 * （两处原本就写着 2 和 3）。让它们显式地从属于上面那一份，顺序就不再
 * 决定语义。 */
#ifndef HAL_MAX_DELAY
#define HAL_MAX_DELAY        0xFFFFFFFFUL
#endif
#ifndef HAL_OK
#define HAL_OK               0x00
#endif
#ifndef HAL_ERROR
#define HAL_ERROR            0x01
#endif
#ifndef HAL_BUSY
#define HAL_BUSY             0x02
#endif
#ifndef HAL_TIMEOUT
#define HAL_TIMEOUT          0x03
#endif

