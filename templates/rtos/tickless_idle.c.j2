/**
 * tickless_idle.c.j2 - FreeRTOS Tickless Idle implementation for STM32G0
 *
 * Generated when: has_tickless is True (FreeRTOS + RTC) and sleep.mode != RUN
 *
 * Low-power strategy:
 *   - The RTC keeps running on LSE through SLEEP / STOP0 / STOP1, so the
 *     calendar + SSR are used as the authoritative timebase across sleep.
 *   - The RTC wakeup timer stays at its fixed 1 Hz heartbeat (it drives the
 *     whole RTC timer service), so the longest sleep is one second.  Idle
 *     windows shorter than that are left to the normal SysTick tick.
 *   - USART2 start-bit wakeup (UESM + HSI16 keeper) and the EXTI button
 *     can both wake the core from STOP at any time.
 *   - On wakeup the elapsed time measured from the RTC is applied to both
 *     the FreeRTOS tick (vTaskStepTick) and the HAL tick (uwTick), so no
 *     wall-clock drift accumulates.
 *
 * RTC and RAM are retained in all three modes (LSE + backup domain, SRAM
 * stays powered), satisfying the low-power demo requirements.
 */
#include "stm32g0xx_hal.h"
#include "FreeRTOS.h"
#include "task.h"

#include "power_mgr.h"
#include "drv_rtc.h"
#include "drv_log.h"

#ifndef TEST

/* HAL timebase timer handle (defined in stm32g0xx_hal_timebase_tim.c) */
extern TIM_HandleTypeDef TimHandle;

/* One full day in milliseconds (midnight wrap for elapsed calculation) */
#define RTC_MS_PER_DAY     (86400000UL)

/* FreeRTOS tick frequency in Hz (also the SysTick 1 ms reload) */
#define TICKLESS_TICK_HZ   (configTICK_RATE_HZ)

/* Stop the HAL 1 ms tick (TIM14) around low-power entry so it neither
 * wakes the core every ms in SLEEP mode nor leaves uwTick behind. */
static void hal_tick_disable(void)
{
    HAL_NVIC_DisableIRQ(TIM14_IRQn);
}

static void hal_tick_enable(void)
{
    /* Clear any pending TIM14 update interrupt before re-enabling */
    __HAL_TIM_CLEAR_IT(&TimHandle, TIM_IT_UPDATE);
    HAL_NVIC_EnableIRQ(TIM14_IRQn);
}

/**
 * @brief  Enter one low-power mode and return after wakeup.
 * @param  mode  POWER_MODE_SLEEP / STOP0 / STOP1 (RUN returns immediately)
 * @return elapsed time in ms spent sleeping (RTC-measured), 0 if skipped
 *
 * Wake sources while sleeping:
 *   - RTC wakeup timer: 1 Hz heartbeat (always armed, NVIC priority 0)
 *   - USART2 start-bit wakeup (STOP0/STOP1 via UESM + HSI16 keeper)
 *   - EXTI button (PC13)
 *
 * Usable from the idle task (tickless) or from a CLI command (explicit
 * "power sleep" debug path); both compensate the HAL tick identically.
 */
uint32_t power_sleep_now(power_mode_t mode)
{
    uint32_t t0, elapsed, reload, ctrl;

    if (mode == POWER_MODE_RUN) {
        return POWER_SLEEP_SKIPPED;   /* nothing to do, and nothing was slept */
    }

    /* Drain pending log/CLI ring bytes and let the last TX byte finish
     * shifting out before the clocks stop. */
    log_flush();
    while (!(USART2->ISR & USART_ISR_TC)) {}

    hal_tick_disable();                     /* freeze HAL timebase */

    /* Stop the FreeRTOS SysTick so it neither wakes SLEEP every ms nor
     * accumulates time while frozen in STOP. */
    ctrl   = SysTick->CTRL;
    reload = SysTick->LOAD;
    SysTick->CTRL = 0;
    SysTick->VAL  = 0;
    SCB->ICSR = SCB_ICSR_PENDSTCLR_Msk;     /* clear pending SysTick */

    /* RTC ms-of-day keeps counting on LSE through every sleep mode */
    t0 = rtc_get_time_ms();

    if (mode >= POWER_MODE_STOP0) {
        log_uart_stop_wakeup_enable();      /* USART2 can wake from STOP */
    }

    switch (mode) {
    case POWER_MODE_SLEEP:
        HAL_PWR_EnterSLEEPMode(PWR_MAINREGULATOR_ON, PWR_SLEEPENTRY_WFI);
        break;
    case POWER_MODE_STOP0:
        HAL_PWR_EnterSTOPMode(PWR_MAINREGULATOR_ON, PWR_STOPENTRY_WFI);
        break;
    case POWER_MODE_STOP1:
        HAL_PWR_EnterSTOPMode(PWR_LOWPOWERREGULATOR_ON, PWR_STOPENTRY_WFI);
        break;
    default:
        /* Mode not implemented on this MCU: restore the timebase and let the
         * caller report that no sleep happened. */
        hal_tick_enable();
        return POWER_SLEEP_SKIPPED;
    }

    /* -------- Wakeup path -------- */
    if (mode >= POWER_MODE_STOP0) {
        log_uart_stop_wakeup_clear();
    }

    elapsed = rtc_get_time_ms() - t0;
    if (rtc_get_time_ms() < t0) {
        elapsed += RTC_MS_PER_DAY;          /* crossed midnight */
    }

    /* TIM14 was stopped (SLEEP: IRQ disabled; STOP: clock off), so advance
     * the HAL tick by the RTC-measured sleep duration. */
    {
        extern volatile uint32_t uwTick;
        uwTick += elapsed;
    }
    hal_tick_enable();

    /* Restart SysTick with the standard 1 ms reload */
    SysTick->LOAD = reload;
    SysTick->VAL  = 0;
    SysTick->CTRL = (ctrl & SysTick_CTRL_CLKSOURCE_Msk)
                    | SysTick_CTRL_TICKINT_Msk
                    | SysTick_CTRL_ENABLE_Msk;

    return elapsed;
}

/**
 * @brief  FreeRTOS tickless idle hook (configUSE_TICKLESS_IDLE == 2).
 *
 * Sleeps only when the RTC can guarantee wakeup before xExpectedIdleTime:
 * the RTC wakeup source is a fixed 1 Hz heartbeat, so the longest sleep is
 * one second (TICKLESS_TICK_HZ ticks).  Shorter idle windows are left to
 * the normal SysTick tick.
 */
void vPortSuppressTicksAndSleep(TickType_t xExpectedIdleTime)
{
    power_mode_t mode = power_mgr_allowed_depth();

    if (mode == POWER_MODE_RUN) {
        return;
    }
    if (xExpectedIdleTime < (TickType_t)TICKLESS_TICK_HZ) {
        return;                             /* RTC only wakes at 1 Hz */
    }

    /* Mirror the ARM_CM0 port: mask interrupts so sleep is entered
     * atomically; pending wakeup interrupts still exit WFI. */
    __asm volatile ("cpsid i" ::: "memory");
    __asm volatile ("dsb");
    __asm volatile ("isb");

    if (eTaskConfirmSleepModeStatus() == eAbortSleep) {
        __asm volatile ("cpsie i" ::: "memory");
        return;
    }

    {
        /* Tickless context: elapsed is at most one second, which is <= the
         * xExpectedIdleTime we gated on, so vTaskStepTick() is valid here. */
        uint32_t elapsed = power_sleep_now(mode);
        vTaskStepTick((TickType_t)(elapsed / (uint32_t)portTICK_PERIOD_MS));
    }

    __asm volatile ("cpsie i" ::: "memory");
    __asm volatile ("dsb");
    __asm volatile ("isb");
}

#else /* TEST */

/* Test stub: never sleep */
uint32_t power_sleep_now(power_mode_t mode)
{
    (void)mode;
    return 0;
}

void vPortSuppressTicksAndSleep(TickType_t xExpectedIdleTime)
{
    (void)xExpectedIdleTime;
}

#endif /* TEST */
