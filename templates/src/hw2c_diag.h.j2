/**
 * @file  hw2c_diag.h
 * @brief 异常诊断：故障发生时的"在跑什么" + "在哪一行地址"（generated by hw2c）
 *
 * FR-15.7。`hw2c_fault_trap()` 之前只往 `.noinit` 里留一个错误码，于是现场
 * 看到"设备反复重启"时只剩一个数字：看不出是初始化失败还是跑飞、看不出是
 * 哪个模块、更看不出在哪条指令上。复位会擦掉全部现场，没有地址就只能靠
 * "删代码二分法"定位。
 *
 * 本模块补上两件事：
 *
 *  1. **当前在跑什么** —— 由生成器在关键分发点自动登记的 tag（CLI 命令、
 *     事件派发、FOTA 阶段），加上 FreeRTOS 任务切换 hook 缓存的任务名。
 *  2. **故障点地址** —— HardFault 取异常栈帧里的 PC / LR / PSR；
 *     非异常路径（`hw2c_fault_trap()`）取 trap 的返回地址。
 *
 * 记录落在 `.noinit`，跨 NVIC_SystemReset() 与看门狗复位可读，因此"故障当
 * 时来不及打完的日志"仍能在**下次开机**的横幅里看到。
 *
 * 注意：Cortex-M0+ 的 SCB 只定义到 SHCSR，没有 CFSR / HFSR / BFAR / MMFAR
 * （见 static/stm32g0/CMSIS/Core/core_cm0plus.h），所以这里没有"总线故障
 * 地址"这类字段 —— 照抄 M3/M4 的 HardFault 打印代码在本工程编译不过。
 *
 * Auto-generated -- do not edit manually.
 */

#ifndef __HW2C_DIAG_H
#define __HW2C_DIAG_H

#include <stdint.h>
#include <stddef.h>

/* tag 文本的最大长度（含结尾 '\0'）。tag 会被**复制**进 .noinit 记录。 */
#define HW2C_DIAG_TAG_LEN   24
/* 任务名最大长度，与 FreeRTOS 的 configMAX_TASK_NAME_LEN 对齐。 */
#define HW2C_DIAG_TASK_LEN  16
/* hw2c_diag_format_last() 输出缓冲区建议大小。 */
#define HW2C_DIAG_LINE_LEN  160

/*
 * 走日志接口（log_output）时，单条日志**正文**的上限。
 *
 * drv_log 的行缓冲是 LOG_MSG_BUF_SIZE(128) 字节，其中时间戳 + 级别前缀占
 * 32 B（"[YYYY-MM-DD HH:MM:SS.mmm] [ERR] "），行尾 CRLF 占 2 B ⇒ 正文只剩
 * 94 B。完整诊断行最长 149 B，直接交给日志会被 drv_log 的 msg_len 钳位
 * **静默截断**：不报错、不打点，现场只看到 "count=" / "tag=cli:dia" 这种
 * 半截尾巴（真机取证见 docs/reviews/onboard-capture-2026-09-23-diag.txt）。
 *
 * 所以交给日志的文本必须**按这个上限拆行**：故障点一行、上下文一行。
 * 拆开后每行都远小于 94 B，任何字段取值下都不会触发钳位。
 */
#define HW2C_DIAG_LOG_LINE_LEN  94

/*
 * 取"调用者地址"依赖 __builtin_return_address(0)，函数一旦被内联，取到的就是
 * 调用者的调用者 —— 那是一个**看起来合理但指错了地方**的地址，比不取更糟。
 */
#if defined(__GNUC__)
#define HW2C_DIAG_NOINLINE __attribute__((noinline))
#else
#define HW2C_DIAG_NOINLINE
#endif

/**
 * @brief 登记"当前运行的接口/模块"。
 * @param tag    模块名。**必须指向静态存储期**（字符串字面量或 static 数组）；
 *               故障瞬间不做任何解析，只做一次拷进 .noinit 的复制，因此栈上
 *               缓冲区的指针在复位前就可能已经失效。
 * @param detail 模块自带的编号（事件 id / FOTA 状态码 / CLI 参数索引），
 *               没有就传 0。
 */
void hw2c_diag_enter(const char *tag, uint32_t detail);

/**
 * @brief 退出最近一次 hw2c_diag_enter() 的作用域，恢复上一层 tag。
 */
void hw2c_diag_leave(void);

/**
 * @brief 记录"当前任务名"。由 FreeRTOS 任务切换 hook 自动调用，业务代码
 *        也可以直接调用（例如给一个不是 FreeRTOS 任务的主循环命名）。
 */
void hw2c_diag_task_note(const char *name);

/**
 * @brief FreeRTOS 任务切换 hook 的实现体（traceTASK_SWITCHED_IN()）。
 * @note  只在非 TEST 构建里存在 —— 主机侧单测没有 FreeRTOS。
 */
void hw2c_diag_task_switched_in(void);

/**
 * @brief 记录一次**不复位**的事件（例如主动软件复位前登记"是谁要求复位的"）。
 * @note  调用者地址由本函数自身取，所以调用点不需要传地址。
 */
void hw2c_diag_note(uint32_t code) HW2C_DIAG_NOINLINE;

/**
 * @brief 记录一次故障：写 .noinit（**无条件**）+ 打日志（只有日志已就绪时）。
 * @param code HW2C_FAULT_* 错误码。
 * @param pc   故障点地址：异常路径取异常栈帧里的 PC，非异常路径传 0。
 * @param lr   返回地址：异常路径取栈帧 LR，非异常路径取 trap 的返回地址。
 * @param psr  异常栈帧的 xPSR，非异常路径传 0。
 * @note  pc / lr 取不到时**照原样把 0 存下来并打出来**，不得省略字段。
 *        日志不可用时（故障发生在 log_init() 之前）仍然写 .noinit —— 那种
 *        情况下下次开机的横幅是唯一能看见证据的地方，而往一个还没
 *        lwrb_init() 的环形缓冲里写字节只会二次 HardFault。
 */
void hw2c_diag_on_fault(uint32_t code, uint32_t pc, uint32_t lr, uint32_t psr);

uint32_t    hw2c_diag_last_code(void);
uint32_t    hw2c_diag_last_pc(void);
uint32_t    hw2c_diag_last_lr(void);
uint32_t    hw2c_diag_last_psr(void);
uint32_t    hw2c_diag_last_detail(void);
uint32_t    hw2c_diag_reset_count(void);
const char *hw2c_diag_last_tag(void);
const char *hw2c_diag_last_task(void);

/**
 * @brief 只清除"原因"，保留发生次数，这样复位循环不会被隐藏。
 */
void hw2c_diag_clear(void);

/**
 * @brief 把上次记录格式化成一行文本（纯函数，主机侧可测）。
 * @return 写入长度（不含结尾 '\0'）。缓冲区太小时按 snprintf 语义截断。
 */
size_t hw2c_diag_format_last(char *buf, size_t n);

/**
 * @brief 格式化"故障点"一行：fault / pc / lr / psr。
 * @note  给日志用。长度上界 65 B，在 HW2C_DIAG_LOG_LINE_LEN 之内。
 */
size_t hw2c_diag_format_fault(char *buf, size_t n);

/**
 * @brief 格式化"上下文"一行：task / tag / detail / count。
 * @note  给日志用。长度上界 89 B，在 HW2C_DIAG_LOG_LINE_LEN 之内。
 *        调用方不要再往前面拼前缀 —— 89 + "previous reset: "(16) 会顶穿
 *        drv_log 的正文上限。
 */
size_t hw2c_diag_format_ctx(char *buf, size_t n);

/**
 * @brief 开机上报：把上次复位前的快照打进日志。无记录时什么都不做。
 */
void hw2c_diag_report_last(void);

#endif /* __HW2C_DIAG_H */
