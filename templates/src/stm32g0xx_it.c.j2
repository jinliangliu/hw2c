/*
 * NMI / HardFault
 *
 * Both used to spin in "while (1)".  That is not a safe state: interrupts stay
 * enabled and, more importantly, the PWM peripheral keeps driving whatever
 * duty was last programmed, so an actuator stays energised forever with no
 * recovery.  hw2c_fault_trap() de-energises the outputs, records the reason
 * and resets the MCU instead.
 *
 * 地址怎么拿到（FR-15.7）
 * ----------------------
 * 异常一进来，硬件已经把 R0/R1/R2/R3/R12/LR/PC/xPSR 八个字压进了栈（MSP 或
 * PSP）。其中 **PC 就是出错的那条指令**，是定位故障最有用的一个数。它只能
 * 在编译器还没动过任何寄存器时读，所以入口必须是 naked 汇编：函数体里第一
 * 条 C 语句之前，编译器可能已经压栈/改栈指针，"栈帧在哪"就说不清了。
 *
 * 判 MSP 还是 PSP 看 EXC_RETURN 的 bit2：为 1 表示异常前跑在任务里（PSP），
 * 为 0 表示跑在主栈（MSP）。
 *
 * 栈帧偏移（从栈指针起）：R0=0  R1=4  R2=8  R3=12  R12=16  LR=20  PC=24
 *                         xPSR=28
 *
 * ⚠️ 不要照抄 Cortex-M3/M4 的 HardFault 打印代码：M0+ 的 SCB 只定义到
 *    SHCSR，**没有 CFSR / HFSR / BFAR / MMFAR**（见
 *    static/stm32g0/CMSIS/Core/core_cm0plus.h 的 SCB_Type），读它们的源码
 *    在本工程根本编译不过。所以这里的"故障点内存地址"只有 PC / LR（外加
 *    xPSR），没有总线故障地址 —— M0+ 上它本来就不可得。
 */

/* 汇编段：r0=PC, r1=LR, r2=xPSR，然后尾跳到下面对应的 C 入口。 */
#define HW2C_EXC_ENTRY_ASM(_c_entry)              \
    __asm volatile (                              \
        "movs r0, #4\n\t"                         \
        "mov  r1, lr\n\t"                         \
        "tst  r0, r1\n\t"          /* bit2: 1=PSP */ \
        "beq  1f\n\t"                             \
        "mrs  r0, psp\n\t"                        \
        "b    2f\n\t"                             \
        "1:\n\t"                                  \
        "mrs  r0, msp\n\t"                        \
        "2:\n\t"                                  \
        "ldr  r1, [r0, #20]\n\t"   /* LR   */     \
        "ldr  r2, [r0, #28]\n\t"   /* xPSR */     \
        "ldr  r0, [r0, #24]\n\t"   /* PC   */     \
        "b    " #_c_entry "\n\t"                  \
    )

void hw2c_hardfault_entry(uint32_t pc, uint32_t lr, uint32_t psr)
{
    hw2c_fault_trap_ctx(HW2C_FAULT_HARDFAULT, pc, lr, psr);
}

void hw2c_nmi_entry(uint32_t pc, uint32_t lr, uint32_t psr)
{
    hw2c_fault_trap_ctx(HW2C_FAULT_NMI, pc, lr, psr);
}

__attribute__((naked)) void NMI_Handler(void)
{
    HW2C_EXC_ENTRY_ASM(hw2c_nmi_entry);
}

__attribute__((naked)) void HardFault_Handler(void)
{
    HW2C_EXC_ENTRY_ASM(hw2c_hardfault_entry);
}

/* EXTI interrupt handlers */
{% for handler, pin_list in exti_handler_groups.items() %}
void {{ handler }}(void)
{
    {% for pin in pin_list %}
    HAL_GPIO_EXTI_IRQHandler( GPIO_PIN_{{ pin.id[2:] }} );
    {% if pin.label == 'BUTTON' %}
    if (xTaskGetSchedulerState() != taskSCHEDULER_NOT_STARTED)
    {
        BaseType_t xHigherPriorityTaskWoken = pdFALSE;
        /* Read pin level: pull-up + active-low → LOW = pressed, HIGH = released */
        event_t evt;
        if (HAL_GPIO_ReadPin(GPIO{{ pin.id | pin_port }}, GPIO_PIN_{{ pin.id | pin_number }}) == GPIO_PIN_RESET) {
            evt.id = EVENT_BUTTON_PRESS;
        } else {
            evt.id = EVENT_BUTTON_RELEASE;
        }
        evt.param = GPIO_PIN_{{ pin.id | pin_number }};
{% if has_btn_task or has_btn_component %}
        extern QueueHandle_t btn_queue;
        xQueueSendFromISR(btn_queue, &evt, &xHigherPriorityTaskWoken);
{% else %}
        xQueueSendFromISR(event_queue, &evt, &xHigherPriorityTaskWoken);
{% endif %}
        portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
    }
    {% endif %}
    {% endfor %}
}
{% endfor %}

/* TIM14 used as HAL timebase — HAL_TIM_IRQHandler →
   HAL_TIM_PeriodElapsedCallback → HAL_IncTick() */
extern TIM_HandleTypeDef TimHandle;

void TIM14_IRQHandler(void)
{
    HAL_TIM_IRQHandler(&TimHandle);
}

{% if has_log or has_cli %}
/* USART2 interrupt — TXE forwarded to log, RXNE forwarded to CLI */
{% if has_log %}
extern void log_uart_irq_handler(void);
{% endif %}
{% if has_cli %}
extern void cli_uart_irq_handler(void);
{% endif %}

void USART2_LPUART2_IRQHandler(void)
{
{% if has_log %}
    log_uart_irq_handler();
{% endif %}
{% if has_cli %}
    cli_uart_irq_handler();
{% endif %}
}
{% endif %}

{% if has_modbus_component %}
/* USART1 interrupt — RXNE forwarded to the Modbus component ring buffer */
extern void modbus_component_uart_isr(void);

void USART1_IRQHandler(void)
{
    modbus_component_uart_isr();
}
{% endif %}
