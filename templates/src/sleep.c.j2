/**
 * sleep.c.j2 - Low power management
 *
 * When has_tickless is True: full tickless idle with RTC wakeup + STOP mode.
 * When has_tickless is False: debug stub that never enters sleep.
 *
 * Power manager integration: when has_power_mgr is True, the sleep depth
 * is dynamically selected based on active component sleep_compat limits.
 */
{% if has_tickless and sleep.mode != 'RUN' %}
{%   include 'rtos/tickless_idle.c.j2' %}
{% else %}
#include "stm32g0xx_hal.h"
#include "FreeRTOS.h"
#include "task.h"
#include "power_mgr.h"

void vPortSuppressTicksAndSleep( TickType_t xExpectedIdleTime )
{
    /* DEBUG mode: never enter low power, keep debugger and peripherals running */
    (void)xExpectedIdleTime;
    return;
}

/*
 * This build has no low-power entry path: it was generated with tickless
 * idle disabled (or sleep.mode == RUN), so the core never enters WFI/STOP.
 *
 * Returning 0 here used to make the CLI print "Woke up after 0 ms", i.e. a
 * successful STOP1 entry, for a sleep that never happened.  Report
 * POWER_SLEEP_SKIPPED instead so the caller can say so.
 *
 * To get real low power, enable tickless idle for the project (see
 * templates/rtos/tickless_idle.c.j2) — this stub is the honest signal that
 * nothing was implemented, not a working sleep path.
 */
uint32_t power_sleep_now(power_mode_t mode)
{
    (void)mode;
    return POWER_SLEEP_SKIPPED;
}
{% endif %}
