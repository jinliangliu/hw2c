/**
 * @file  power_mgr.h
 * @brief Low-power management — dynamic sleep depth selection (generated by hw2c)
 *
 * Each component declares its STOP/STANDBY compatibility. The power
 * manager selects the deepest allowed sleep mode based on currently
 * active components. This prevents entering a sleep level that would
 * disrupt a running component.
 *
 * Sleep depth hierarchy (shallow → deep):
 *   SLEEP_MODE_RUN   = 0  (no sleep, all components active)
 *   SLEEP_MODE_SLEEP = 1  (WFI, CPU clock gated, peripherals running)
 *   SLEEP_MODE_STOP0 = 2  (main regulator on, HSI16 available)
 *   SLEEP_MODE_STOP1 = 3  (main regulator on, HSI16 off)
 *   SLEEP_MODE_STOP2 = 4  (low-power regulator, HSI16 off)
 *   SLEEP_MODE_STANDBY = 5 (deepest, RAM lost, RTC only)
 *
 * Configuration in components.yaml:
 *   sleep_compat: STOP2  (component tolerates up to STOP2)
 *
 * Auto-generated — do not edit manually.
 */

#ifndef __POWER_MGR_H
#define __POWER_MGR_H

#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

/**
 * @brief Sleep mode enumeration (depth order: 0=run, 5=deepest)
 */
typedef enum {
    POWER_MODE_RUN     = 0,  /**< Full run, no sleep */
    POWER_MODE_SLEEP   = 1,  /**< CPU sleep (WFI), peripherals running */
    POWER_MODE_STOP0   = 2,  /**< STOP0: main regulator, HSI16 on */
    POWER_MODE_STOP1   = 3,  /**< STOP1: main regulator, HSI16 off */
    POWER_MODE_STOP2   = 4,  /**< STOP2: lp regulator, HSI16 off */
    POWER_MODE_STANDBY = 5,  /**< STANDBY: deepest, RAM lost */
    POWER_MODE_MAX     = 6,
} power_mode_t;

/**
 * @brief Convert a power mode enum to a readable string
 * @param  mode  Power mode value
 * @return String representation (e.g., "STOP1")
 */
const char *power_mode_name(power_mode_t mode);

/**
 * @brief  Initialize the power manager
 * @param  default_mode  Fallback sleep mode when no components registered
 *
 * Must be called after component_init_all() so that per-component
 * sleep_compat values are available.
 */
void power_mgr_init(power_mode_t default_mode);

/**
 * @brief  Set the default / allowed sleep mode (e.g. from CLI "power mode")
 * @param  mode  Desired mode (RUN/SLEEP/STOP0/STOP1/...)
 */
void power_mgr_set_default(power_mode_t mode);

/**
 * @brief  Get the current default / explicitly selected mode
 * @return The mode last set via power_mgr_set_default() or power_mgr_init()
 */
power_mode_t power_mgr_get_default(void);

/**
 * @brief  Get the allowed sleep depth based on active components
 * @return The deepest power_mode_t that all active components tolerate
 *
 * Iterates all components in RUNNING state, finds their sleep_compat
 * limit, and returns the minimum (shallowest) of those. Components
 * in STOPPED or ERROR state are excluded.
 *
 * Call before entering sleep to determine the appropriate mode.
 */
power_mode_t power_mgr_allowed_depth(void);

/**
 * @brief Enter one low-power mode immediately and return after wakeup.
 * @param  mode  POWER_MODE_SLEEP / STOP0 / STOP1
 * @return Elapsed ms spent sleeping (RTC-measured), or POWER_SLEEP_SKIPPED
 *         when the core did NOT sleep at all.
 *
 * The two outcomes must be distinguishable: a build compiled without tickless
 * idle has only a stub, and reporting "slept 0 ms" from it is a lie that hides
 * the missing implementation.  Callers must therefore test for
 * POWER_SLEEP_SKIPPED before reporting a sleep (see the CLI "power sleep"
 * command).
 *
 * RTC keeps counting on LSE; USART2 start-bit and EXTI wake the core from
 * STOP. HAL tick and FreeRTOS tick are compensated so time stays exact.
 * Implemented in tickless_idle.c (or sleep.c stub).
 */
uint32_t power_sleep_now(power_mode_t mode);

/** @brief Return value of power_sleep_now() when no sleep was entered. */
#define POWER_SLEEP_SKIPPED  0xFFFFFFFFUL

/**
 * @brief  Check if a target sleep mode is compatible with active components
 * @param  target  Desired sleep depth
 * @return true if all active components tolerate the target depth
 */
bool power_mgr_is_mode_allowed(power_mode_t target);

/**
 * @brief  Get the number of components blocking a specific sleep mode
 * @param  mode  Sleep mode to check
 * @return Number of active components that do NOT tolerate this depth
 */
uint32_t power_mgr_blocking_count(power_mode_t mode);

/**
 * @brief  Log current power management status at INFO level
 *
 * Reports: allowed depth, blocking components, each component's compat.
 */
void power_mgr_log_status(void);

#ifdef __cplusplus
}
#endif

#endif /* __POWER_MGR_H */
