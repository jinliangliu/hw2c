/* ------- Main ------- */
/*
 * Task creation with an explicit failure path.
 *
 * xTaskCreate() returns pdFAIL when the heap cannot supply the TCB + stack.
 * Ignoring that left the firmware "running" without the task that does the
 * work - e.g. no component step task, so the control loops never execute while
 * the CLI still answers.  Before the scheduler starts there is no task to
 * report to, so take the fail-safe path instead.
 */
static void create_task_checked(TaskFunction_t fn, const char *name,
                                configSTACK_DEPTH_TYPE stack_words,
                                void *params, UBaseType_t priority,
                                TaskHandle_t *out_handle)
{
    if (xTaskCreate(fn, name, stack_words, params, priority,
                    out_handle) != pdPASS) {
        hw2c_fault_trap(HW2C_FAULT_RTOS_OBJECT);
    }
}

int main(void)
{
    HAL_Init();

    /* 使能调试模块在 STOP 模式下的时钟，保持 SWD 连接 */
    DBG->CR |= DBG_CR_DBG_STOP;

    SystemClock_Config();

    /* 系统时钟配置完成后，重新初始化 HAL 时基（TIM14），
       确保 HAL_GetTick() 使用正确的时钟频率。
       RTC_WakeUp_Config 内部调用 HAL_RTCEx_SetWakeUpTimer_IT 会用到 HAL_GetTick */
{% if has_log %}
    /* Clear all NVIC interrupt enables to prevent stale IRQs from
     * previous runs (NVIC ISER persists across system reset).
     * Must be done BEFORE HAL_InitTick() so TIM14 NVIC gets re-enabled. */
    for (int irq = 0; irq < 8; irq++) {
        NVIC->ICER[irq] = 0xFFFFFFFF;
    }
{% endif %}
    HAL_InitTick(TICK_INT_PRIORITY);

{% if has_log %}
    /* Enable global interrupts early so HAL_Delay (TIM14 tick ISR)
       and USART2 TXE ISR (log ring-buffer drain) can fire. */
    __enable_irq();

{% if has_led %}
    /* Quick LED heartbeat to confirm main() entry */
    __HAL_RCC_GPIOC_CLK_ENABLE();
    {
        GPIO_InitTypeDef led_cfg = {0};
        led_cfg.Pin = LED_GPIO_Pin;
        led_cfg.Mode = GPIO_MODE_OUTPUT_PP;
        led_cfg.Pull = GPIO_NOPULL;
        led_cfg.Speed = GPIO_SPEED_FREQ_LOW;
        HAL_GPIO_Init(LED_GPIO_Port, &led_cfg);
        /* 3 quick blinks: main() alive before log_init */
        for (int i = 0; i < 3; i++) {
            HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_RESET);
            HAL_Delay(50);
            HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_SET);
            HAL_Delay(50);
        }
    }
{% endif %}
    /* Initialize logging subsystem — USART2 @ 115200, ring buffer, TXE IRQ */
    log_init();
    log_flush();  /* Ensure banner is fully transmitted before proceeding */
    /* hw2c boot banner: ASCII logo (raw, no timestamp) + project info */
    log_raw(
            "\t    _/    _/  _/          _/    _/_/      _/_/_/\n"  
            "\t   _/    _/  _/          _/  _/    _/  _/\n"          
            "\t  _/_/_/_/  _/    _/    _/      _/    _/\n"           
            "\t _/    _/    _/  _/  _/      _/      _/\n"            
            "\t_/    _/      _/  _/      _/_/_/_/    _/_/_/\r\n"
    );
    log_info("{{ project_name }} v1.0 — Hardware2Code | {{ mcu.part }} @ {{ (mcu.clock_freq_hz / 1000000) | int }} MHz");

    /*
     * Report a fault trapped before the previous reset.  Without this the
     * reset reason never leaves the device, because the log itself is lost
     * on reset (see docs/reviews/code-review-2026-09-15-misra-c99.md P1-3).
     */
    {
        uint32_t prev_fault = hw2c_fault_last();
        if (prev_fault != HW2C_FAULT_NONE) {
            log_error("previous reset: fault %lu (occurrence %lu) — outputs were forced safe",
                      (unsigned long)prev_fault,
                      (unsigned long)hw2c_fault_reset_count());
            /* The reason has been reported; keep the counter so a reset loop
             * stays visible, but drop the latch so it cannot be re-reported
             * as if it were new. */
            hw2c_fault_clear();
        }
    }
    log_flush();  /* Drain ring buffer completely */
    HAL_Delay(500);  /* Let UART finish all pending transmissions */
{% endif %}

    /* Initialize all configured peripherals */
    MX_GPIO_Init();
{% if has_log %}
    log_info("MX_GPIO_Init() OK");
{% endif %}

{% if has_bootloader %}
    /*
     * App alive heartbeat: 2 quick blinks (100ms on/off each) to confirm App startup.
     * Distinct from Bootloader's 3 slow blinks (200ms). If you see 2 quick blinks after
     * the Bootloader's pattern, the App has started successfully.
     */
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_RESET); /* LED on */
    HAL_Delay(100);
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_SET);   /* LED off */
    HAL_Delay(100);
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_RESET); /* LED on */
    HAL_Delay(100);
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_GPIO_Pin, GPIO_PIN_SET);   /* LED off */
    HAL_Delay(100);
{% endif %}

    /* Initialize the event manager */
    EventMgr_Init();
{% if has_log %}
    log_info("EventMgr_Init() OK");
{% endif %}

{% if has_behavior %}
    statemachine_init();
{% if has_log %}
    log_info("statemachine_init() OK");
{% endif %}
{% endif %}
    /*
     * ------------------------------------------------------------------
     *  Interrupt-state repair — must stay immediately after EventMgr_Init()
     * ------------------------------------------------------------------
     *  EventMgr_Init() calls xQueueCreate(), whose heap path runs a
     *  pre-scheduler critical section.  On the upstream ARMv6-M port that
     *  leaves PRIMASK set, because ulCriticalNesting starts at the poison
     *  value 0xAAAAAAAA and cannot reach 0 (see the block comment above
     *  cli_init()/xTaskCreate() near the end of main()).
     *
     *  The vendored FreeRTOS sources are not modified, so interrupts are
     *  re-enabled explicitly here.  No critical section is active at this
     *  point, and every remaining pre-scheduler RTOS object creation is
     *  deferred to the last block of main(), so this single repair lasts
     *  until xPortStartScheduler() re-arms the port.
     *
     *  Without it every HAL_GetTick()-based wait below (LSE startup, I2C
     *  registration and probe timeouts, SPI flash busy polls, IWDG init)
     *  would spin forever because TIM14 never ticks.
     * ------------------------------------------------------------------
     */
    __enable_irq();

    /* Initialize I2C and internal peripherals */
{% for bus in i2c_buses %}
    MX_I2C{{ bus[-1] }}_Init();
{% endfor %}
{% for bus in spi_buses %}
    MX_SPI{{ bus[-1] }}_Init();
{% endfor %}
{% for p in peripherals %}
{% if 'I2C' in p.model.interface %}
    {{ p.name }}_init(i2c_open("{{ p.bus | lower }}", NULL), {{ '0x%02X' | format(p.get('address', p.model.get('address', p.model.get('i2c_addr', 0x68)))) }});
{% elif 'SPI' in p.model.interface %}
{% if p.is_spi_flash %}
    spi_flash_init(&hspi{{ p.bus[-1] }});
{% else %}
{% set spi_cs_id = p.get('cs_pin', p.get('extra', {}).get('chip_select_pin', '')) %}
{% set spi_cs_obj = pins | selectattr('id', 'eq', spi_cs_id) | first %}
{% set spi_cs_label = (spi_cs_obj.get('label', spi_cs_id) | lower) if spi_cs_obj else (spi_cs_id | lower) %}
    {{ p.name }}_init(spi_open("{{ p.bus | lower }}", NULL), "{{ spi_cs_label }}");
{% endif %}
{% elif p.type == 'Internal_RTC' %}
    RTC_Init();
{% elif p.type == 'Internal_TempSensor' %}
    temp_sensor_init();
    log_info("temp_sensor_init() OK");
{% elif p.type == 'Internal_PWM' %}
    {{ p.name }}_init();
    log_info("{{ p.name }}_init() OK");
{% elif p.type == 'UART_Serial' %}
{% if not (has_log and p.instance == 'USART2') %}
    MX_{{ p.instance }}_UART_Init();
{% else %}
    /* USART2 already initialized by log system (drv_log.c),
     * skip duplicate HAL_UART_Init to avoid clearing TXEIE. */
{% endif %}
{% endif %}
{% endfor %}

{% if has_rtc %}
    RTC_Start();
{% endif %}
{% if has_log %}
    log_info("RTC_Init() OK");
{% endif %}

{% if has_fota_receive %}
    /* Initialize FOTA subsystem (receive state machine + staging metadata).
     * Application of a staged patch is driven by fota_process() from the
     * dedicated low-priority fota task, never from the CLI or an ISR. */
    fota_init();
{% if has_log %}
    log_info("FOTA subsystem initialized");
{% endif %}
{% endif %}

{% if has_components %}
    /*
     * Initialize all registered components.
     *
     * This must run BEFORE any RTOS object is created.  A component probe
     * drives I2C/SPI transfers whose timeouts are measured with
     * HAL_GetTick(), and the upstream ARMv6-M FreeRTOS port keeps
     * interrupts masked across pre-scheduler critical sections (see the
     * note above cli_init()/xTaskCreate() further down) — a tick-dependent
     * wait placed after the first xQueueCreate/xTaskCreate would spin
     * forever.  hw2c does not patch the vendored FreeRTOS sources, so the
     * ordering carries the guarantee instead.
     */
    {
        uint32_t comp_ok = component_init_all();
{% if has_log %}
        log_info("component_init_all: %lu/%lu OK", comp_ok, component_count());
{% endif %}
    }
{% endif %}

{% if has_topics %}
    /* Initialize inter-component message bus */
    bus_init();
{% if has_log %}
    log_info("component_bus initialized (%lu topics)", {{ topics | length }}UL);
{% endif %}
{% endif %}

{% if has_params %}
    /* Initialize runtime parameter registry */
    param_init();
{% if has_log %}
    log_info("param_registry initialized (%lu params)", {{ params | length }}UL);
{% endif %}
{% endif %}

{% if has_power_mgr %}
    /* Initialize power manager (dynamic sleep depth) */
    power_mgr_init(POWER_MODE_{{ sleep.mode | default('STOP1') | upper }});
{% if has_log %}
    log_info("power_mgr initialized (default: %s)", power_mode_name(POWER_MODE_{{ sleep.mode | default('STOP1') | upper }}));
{% endif %}
{% endif %}

{% if iwdg_enabled %}
    /*
     * Arm the independent watchdog.  From this point the MCU is reset unless
     * the single appointed refresh site (see component_step_task) keeps
     * running — a hung control loop can no longer leave an actuator energised.
     */
    IWDG_Init();
{% if has_log %}
    log_info("IWDG armed (timeout %lu ms)", (unsigned long)IWDG_TIMEOUT_MS);
{% endif %}
{% endif %}

{% if has_bootloader %}
{% if has_log %}
    /* Flush all pending logs before touching sensitive TAMP registers */
    log_flush();
{% endif %}

    /* 标记启动成功 — Bootloader 在下次上电时检测此标志 */
    boot_app_mark_ok();
{% endif %}

{% if has_log %}
    /* Boot complete summary */
{% if has_components %}
    log_info("System ready — %lu components, %lu B heap free, starting scheduler",
             (unsigned long)component_count(),
             (unsigned long)xPortGetFreeHeapSize());
{% else %}
    log_info("System ready — %lu B heap free, starting scheduler",
             (unsigned long)xPortGetFreeHeapSize());
{% endif %}
    log_flush();
{% endif %}

{% if sleep %}
    /* Enable DBGMCU clock and keep debug interface active during STOP mode */
    __HAL_RCC_DBGMCU_CLK_ENABLE();
    HAL_DBGMCU_EnableDBGStopMode();
{% endif %}

    /*
     * ==================================================================
     *  Pre-scheduler RTOS object creation — this block must stay LAST.
     * ==================================================================
     *  The upstream FreeRTOS ARMv6-M port
     *  (portable/GCC/ARM_CM0/port.c) initialises ulCriticalNesting to the
     *  poison value 0xAAAAAAAA.  Before xPortStartScheduler() runs, the
     *  first taskEXIT_CRITICAL() therefore decrements 0xAAAAAAAA back to
     *  0xAAAAAAAA and never takes the "== 0" branch that restores PRIMASK:
     *  interrupts stay masked until vPortStartFirstTask() executes
     *  "cpsie i".
     *
     *  hw2c does not modify the vendored FreeRTOS / STM32 HAL / CMSIS
     *  sources, so the generated code is ordered to respect the port
     *  instead of patching it:
     *
     *    - every pre-scheduler FreeRTOS object creation
     *      (xQueueCreate in EventMgr_Init, xSemaphoreCreateBinary in
     *      cli_init, xTaskCreate in telemetry_init and the task
     *      creations below) is confined to this block, and
     *    - nothing in this block waits on the tick or on an interrupt.
     *      All HAL_GetTick()-based waits (I2C probes, flash, IWDG) and all
     *      interrupt-driven logging therefore happen above this block;
     *      log_flush() is a polling drain and is safe anywhere.
     *
     *  EventMgr_Init() above is the only exception: it must run before
     *  RTC_Start() because the RTC ISR posts to its queue, so it is
     *  immediately followed by the __enable_irq() repair.
     *
     *  xPortStartScheduler() then resets ulCriticalNesting to 0 and
     *  re-enables interrupts, so the state is well defined from the first
     *  task onwards.
     * ==================================================================
     */
{% if has_cli %}
{% if has_log and cli_uart_name == 'usart2' %}
    /* USART2 shared with log — reuse log's initialized handle */
    cli_init(log_get_huart());
{% else %}
    cli_init(&huart_{{ cli_uart_name }});
{% endif %}
{% endif %}

{% if has_telemetry %}
    /* Initialize telemetry subsystem (heartbeat, stack, heap monitoring) */
    telemetry_init();
{% endif %}

    /* Create application tasks (user-defined) */
{% for task in app_tasks %}
{% if not (has_fota_receive and task.name == 'fota_task') %}
    create_task_checked( {{ task.name }}, "{{ task.name }}", {{ task.stack_size | default(128) }}, NULL, {{ task.priority }}, &{{ task.name }}_handle );
{% endif %}
{% endfor %}

{% if has_cli %}
    create_task_checked(cli_task, "cli", {{ cli_stack_size|default(512) }}, NULL, {{ cli_priority|default(4) }}, NULL);
{% endif %}

    /* Create the central event manager task (highest priority) */
    create_task_checked(EventMgr_Task, "event_mgr", 512, NULL, configMAX_PRIORITIES - 1, NULL);

{% if has_fota_receive %}
    create_task_checked(fota_task, "fota", 512, NULL, 1, NULL);
{% endif %}

{% if has_components %}
    /* Create component step task (sole IWDG refresh site) */
    create_task_checked(component_step_task, "comp_step", 512, NULL, 2, NULL);
{% endif %}

    vTaskStartScheduler();

    /*
     * vTaskStartScheduler() only returns if the scheduler could not be
     * started (no heap, idle task creation failed).  There is no system to
     * fall back on, so take the fail-safe path rather than spin with the
     * outputs at their last state.
     */
    hw2c_fault_trap(HW2C_FAULT_SCHEDULER);
}

/* ------- Task implementations ------- */
{% for task in app_tasks %}
{% if not (has_fota_receive and task.name == 'fota_task') %}
void {{ task.name }}(void *pvParameters)
{
    {% if task.name == 'mpu6050_alert_task' %}
    {{ peripherals[0].name }}_data_t sensor_data;
    while(1) {
        {{ peripherals[0].name }}_read(&sensor_data);
        if (sensor_data.accel_x > 1.0f || sensor_data.accel_x < -1.0f) {
            event_t evt = { .id = EVENT_MPU6050_ALERT, .param = 0 };
            xQueueSend(event_queue, &evt, 0);
        }
        vTaskDelay(pdMS_TO_TICKS({{ peripherals[0].extra.update_interval_ms | default(1000) }}));
    }
    {% elif task.name == 'rtc_demo_task' %}
    /*
     * RTC tick events are generated by HAL_RTCEx_WakeUpTimerEventCallback (ISR).
     * RTC_ProcessTimers() is called by EventMgr_Task when processing each EVENT_RTC_TICK.
     * rtc_demo_task only handles periodic IWDG refresh — do NOT duplicate tick/processing here.
     */
    while(1) {
{% if iwdg_enabled and not has_components %}
        IWDG_Refresh();      /* no component task in this build: this loop owns the refresh */
{% endif %}
        vTaskDelay(pdMS_TO_TICKS(100));
    }
    {% else %}
    while(1) {
        vTaskDelay(1000);
    }
    {% endif %}
}
{% endif %}
{% endfor %}

{% if has_components %}
/*
 * Component step task: periodically calls component_step_all()
 * which iterates all running components and invokes their step() fn
 * when their period has elapsed.
 */
void component_step_task(void *arg)
{
    (void)arg;
    for (;;) {
        component_step_all();
{% if iwdg_enabled %}
        /*
         * THE watchdog refresh site: reached only after every component step
         * for this cycle has returned.  A step that blocks (stuck I2C bus,
         * HAL timeout, deadlock) skips the refresh and the MCU resets.
         */
        IWDG_Refresh();
{% endif %}
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}
{% endif %}

{% if has_fota_receive and not test_mode %}
/*
 * FOTA task: polls the protocol state machine.
 * When a FOTA START command is received via UART interrupt,
 * the state machine transitions IDLE → RECEIVING and processes
 * incoming chunks automatically.
 */
void fota_task(void *arg) {
    (void)arg;
    for (;;) {
        fota_process();
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}
{% endif %}
