/** @file  main.c
 *  @brief Application entry point (generated by hw2c)
 *
 *  Initialization order:
 *    1. HAL / SystemClock / GPIO
 *    2. Peripherals (I2C, SPI, UART, RTC, TempSensor...)
 *    3. EventMgr + StateMachine
 *    4. Drivers (CLI, FOTA...)
 *    5. Components (init_all + bus + params + telemetry + power_mgr)
 *    6. FreeRTOS tasks + scheduler start
 *
 *  Auto-generated -- do not edit manually.
 */
