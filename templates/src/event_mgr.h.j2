/**
 * @file  event_mgr.h
 * @brief Central event manager — FreeRTOS queue-based event dispatch (generated by hw2c)
 *
 * Events include:
 *   - Built-in: MINUTE_TICK, HOUR_TICK, BUTTON_PRESS, RTC_TICK, RTC_ALARM
 *   - Timer-driven: EVENT_TIMER_EXPIRED_*  (from YAML start_timer / after)
 *   - Published:  EVENT_*  (from YAML publish / publish_async / send_to)
 *   - Transition: EVENT_*  (from YAML transition event fields)
 *
 * The event queue is consumed by EventMgr_Task and dispatched to
 * the state machine (if has_behavior) or legacy handlers.
 *
 * Auto-generated -- do not edit manually.
 */

#ifndef __EVENT_MGR_H
#define __EVENT_MGR_H

#ifdef TEST
#include "mock_hal.h"
#else
#include "FreeRTOS.h"
#include "queue.h"
#endif

/** @brief Event type enumeration */
typedef enum {
    EVENT_NONE = 0,
    /** 1-minute periodic tick (from RTC alarm) */
    EVENT_MINUTE_TICK,
    /** 1-hour periodic tick (from RTC alarm) */
    EVENT_HOUR_TICK,
    /** Button press detected (EXTI interrupt) */
    EVENT_BUTTON_PRESS,
    /** Button release detected (EXTI interrupt) */
    EVENT_BUTTON_RELEASE,
{% for alarm in rtc_alarms %}
    EVENT_{{ alarm.event }},
{% endfor %}
    /** RTC alarm fired */
    EVENT_RTC_ALARM,
    /** RTC WakeUp timer tick (ISR-driven) */
    EVENT_RTC_TICK,
{% for p in peripherals %}
{% if p.type == 'I2C_Sensor_MPU6050' %}
    /** MPU6050 motion alert interrupt */
    EVENT_MPU6050_ALERT,
{% endif %}
{% endfor %}
    /** Sub-state machine return event */
    EVENT_RETURN,

/* ---- Dynamic timer events (pre-computed by context builder) ---- */
{% for evt in timer_events %}
    {{ evt }},
{% endfor %}

/* ---- Dynamic publish events (pre-computed by context builder) ---- */
{% for evt in published_events %}
    EVENT_{{ evt }},
{% endfor %}

/* ---- Business flow transition events (from YAML transitions event field) ---- */
{% for evt in transition_events %}
    EVENT_{{ evt }},
{% endfor %}

    /** Sentinel value for event array sizing */
    EVENT_MAX
} event_id_t;

/** @brief Event payload structure */
typedef struct {
    event_id_t id;      /**< Event type identifier */
    uint32_t   param;   /**< Optional event parameter (legacy raw) */
    union {
        uint32_t raw;   /**< typed raw payload (events contract) */
        float    f;     /**< typed float payload (events contract) */
    } payload;
} event_t;

/* ---- Typed event post functions (from behavior.events contract) ---- */
{% for evt in events %}
{% if evt.payload and evt.payload.type in ('float', 'uint32') %}
/* Posts EVENT_{{ evt.name }} with a typed payload
 * ({{ evt.payload.type }}{% if evt.payload.unit %}, {{ evt.payload.unit }}{% endif %}). */
int event_post_{{ evt.name | lower }}({{ 'float' if evt.payload.type == 'float' else 'uint32_t' }} value);
{% endif %}
{% endfor %}

/** @brief Global FreeRTOS event queue handle */
extern QueueHandle_t event_queue;

/** @brief Initialize the event queue (call before scheduler starts) */
void EventMgr_Init(void);

/** @brief Event manager task — blocks on queue, dispatches to state machine */
void EventMgr_Task(void *pvParameters);

#endif /* __EVENT_MGR_H */
