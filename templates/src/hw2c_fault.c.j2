{#
    hw2c_fault.c.j2 - fail-safe fault handling (see hw2c_fault.h)

    Context used: `peripherals` (to enumerate PWM actuator outputs).
#}
#ifdef TEST
#include "mock_hal.h"
#else
#include "stm32g0xx_hal.h"
#endif

#include "hw2c_fault.h"
/*
 * 故障快照（tag / 任务名 / 故障点地址 / 发生次数）住在 hw2c_diag。hw2c_fault
 * 只负责"失效安全动作"，不再自己持有一份 .noinit 记录 —— 两份 magic 就是
 * 两份真源，迟早出现"一个说有故障、一个说没有"。
 */
#include "hw2c_diag.h"

{% set pwm_peris = peripherals | selectattr('type', 'eq', 'Internal_PWM') | list %}
{% for p in pwm_peris %}
#include "drv_{{ p.name }}.h"
{% endfor %}

/* ---------------------------------------------------------------------------
 * Reset-surviving fault record — 委托给 hw2c_diag
 *
 * 这里只保留 hw2c_fault 的对外契约（last / reset_count / clear），实体在
 * hw2c_diag 的 .noinit 快照里（FR-15.7）。
 * ------------------------------------------------------------------------ */

uint32_t hw2c_fault_last(void)
{
    return hw2c_diag_last_code();
}

uint32_t hw2c_fault_reset_count(void)
{
    return hw2c_diag_reset_count();
}

void hw2c_fault_clear(void)
{
    hw2c_diag_clear();
}

/* ---------------------------------------------------------------------------
 * Safe state
 * ------------------------------------------------------------------------ */
void hw2c_safe_state(void)
{
{% if pwm_peris | length == 0 %}
    /* No PWM actuator in this build: nothing to force inactive. */
    ;
{% endif %}
{% for p in pwm_peris %}
{%- set _pe = p.get('extra', {}) %}
{%- set _model = p.get('model', {}) %}
{%- set _chans = _pe.get('channels')
        if _pe.get('channels')
        else (_model.get('channels')
              if _model.get('channels')
              else [{'channel': _pe.get('channel', _model.get('channel', 1))}]) %}
{% for ch in _chans %}
    /* {{ p.name }} ch{{ ch.get('channel', 1) }}: duty 0 % then stop, so the
     * output pin cannot remain driven even for one PWM period. */
    (void){{ p.name }}_set_duty((uint8_t){{ ch.get('channel', 1) }}, 0U);
    (void){{ p.name }}_stop((uint8_t){{ ch.get('channel', 1) }});
{% endfor %}
{% endfor %}
}

/* ---------------------------------------------------------------------------
 * Trap
 * ------------------------------------------------------------------------ */
/*
 * 公共实现。code 之外还要记"在跑什么 + 在哪条指令上"（FR-15.7）：
 *
 *   · 非异常路径（本文件里所有 hw2c_fault_trap() 的调用点）取 trap 自己的
 *     返回地址 —— 那就是"调用 trap 的那条指令之后"，是能拿到的最精确位置；
 *   · 异常路径（HardFault / NMI）由 hw2c_fault_trap_ctx() 把栈帧里的
 *     PC / LR / PSR 传进来，因为那时"调用者"是 HardFault_Handler 自己。
 *
 * 记账在 hw2c_diag 里无条件发生；日志打不出来（故障发生在 log_init() 之前）
 * 时只是不打，证据仍留在 .noinit 里等下次开机。
 */
static void fault_trap_impl(uint32_t code, uint32_t pc, uint32_t lr, uint32_t psr)
{
    /* 1) Nothing else may act on the system while it is being shut down. */
    __disable_irq();

    /* 2) De-energise the outputs before anything else — this is the step that
     *    actually protects the plant. */
    hw2c_safe_state();

    /* 3) Record why (and where), so the next boot can report it. */
    hw2c_diag_on_fault(code, pc, lr, psr);

    /* 4) Restart under supervision rather than hanging with live outputs. */
    NVIC_SystemReset();
}

void hw2c_fault_trap_ctx(uint32_t code, uint32_t pc, uint32_t lr, uint32_t psr)
{
    fault_trap_impl(code, pc, lr, psr);
}

HW2C_NOINLINE void hw2c_fault_trap(uint32_t code)
{
    /* __builtin_return_address(0) = 本函数的返回地址 = 调用 hw2c_fault_trap()
     * 的那条指令之后。本函数带 HW2C_NOINLINE：一旦被内联，这个地址就变成
     * "调用者的调用者"，一个指错地方却看不出错的读数。 */
    uint32_t lr = (uint32_t)(uintptr_t)__builtin_return_address(0);

    fault_trap_impl(code, 0U, lr, 0U);
}
