/**
 * @file  component_bus.h
 * @brief Inter-component publish/subscribe message bus (generated by hw2c)
 *
 * Topics are defined in pubsub.yaml. Components publish data to topics;
 * other components subscribe to receive notifications.
 *
 * Static allocation — max subscribers fixed at generation time.
 *
 * Auto-generated — do not edit manually.
 */

#ifndef __COMPONENT_BUS_H
#define __COMPONENT_BUS_H

#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

/* ---- Topic IDs ---- */
typedef enum {
    TOPIC_NONE = 0,
{% for t in topics %}
    TOPIC_{{ t.name | upper }},
{% endfor %}
    TOPIC_MAX
} topic_id_t;

/* ---- Subscriber callback type ---- */
typedef void (*bus_handler_t)(topic_id_t topic, uint32_t value, void *ctx);

/* ---- Bus API ---- */

/**
 * @brief  Initialize the message bus
 */
void bus_init(void);

/**
 * @brief  Publish a value to a topic
 * @param  topic  Topic ID
 * @param  value  Data value (32-bit payload)
 * @return Number of subscribers notified, -1 on error
 */
int bus_publish(topic_id_t topic, uint32_t value);

/**
 * @brief  Subscribe to a topic
 * @param  topic    Topic ID to subscribe to
 * @param  handler  Callback function
 * @param  ctx      User context pointer (passed to handler)
 * @return 0 on success, -1 if no free subscriber slots
 */
int bus_subscribe(topic_id_t topic, bus_handler_t handler, void *ctx);

/**
 * @brief  Unsubscribe from a topic
 * @param  topic    Topic ID
 * @param  handler  Same handler pointer used during subscribe
 * @return 0 on success, -1 if not found
 */
int bus_unsubscribe(topic_id_t topic, bus_handler_t handler);

/**
 * @brief  Get the name string for a topic ID
 */
const char *bus_topic_name(topic_id_t topic);

/* ---- Typed publish wrappers (from pubsub.yaml value declarations) ---- */
{% for t in topics %}
{% if t.value and t.value.get('type') %}
{% if t.value.type == 'float' %}{% set ctype = 'float' %}
{% elif t.value.type == 'int32' %}{% set ctype = 'int32_t' %}
{% elif t.value.type == 'bool' %}{% set ctype = 'bool' %}
{% else %}{% set ctype = 'uint32_t' %}
{% endif %}
/**
 * @brief  Publish to {{ t.name }} ({{ t.value.type }}{% if t.value.unit %}, unit={{ t.value.unit }}{% endif %})
 */
int bus_publish_{{ t.name }}({{ ctype }} value);

{% endif %}
{% endfor %}
#ifdef __cplusplus
}
#endif

#endif /* __COMPONENT_BUS_H */
