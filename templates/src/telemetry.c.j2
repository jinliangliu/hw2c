}

void telemetry_inc_error(const char *comp_name)
{
    if (comp_name == NULL) return;
{% if has_components %}
    component_t *c = component_get(comp_name);
    if (c != NULL) {
        c->error_count++;
    }
{% else %}
    (void)comp_name;
{% endif %}
}

void telemetry_heartbeat(const char *comp_name)
{
    if (comp_name == NULL) return;
{% if has_components %}
    component_t *c = component_get(comp_name);
    if (c != NULL) {
        c->heartbeat++;
    }
{% else %}
    (void)comp_name;
{% endif %}
}
