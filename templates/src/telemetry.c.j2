#ifndef TEST
/*
 * Allocated stack size (in words) per task, captured at generation time.
 *
 * FreeRTOS only exposes uxTaskGetStackHighWaterMark() = words *remaining at
 * the worst point*; it never reports the allocation size.  Without the
 * denominator "words used" cannot be computed, and the previous revision
 * silently emitted a constant 0 for peak_usage (plus a "(void)" suppression)
 * so the NFR-4 stack metric looked implemented while reporting nothing.
 *
 * The generator knows every xTaskCreate() depth, so it emits that table here
 * and peak usage becomes  peak = total - remaining.
 * Tasks not listed (FreeRTOS IDLE / Tmr Svc) report total_stack = 0 and are
 * excluded from the peak/minimum computation.
 */
static const struct {
    const char *name;
    uint16_t    stack_words;
} g_task_stack_table[] = {
{% for task in app_tasks %}
{% if not (has_fota_receive and task.name == 'fota_task') %}
    { "{{ task.name }}", {{ task.stack_size | default(128) }} },
{% endif %}
{% endfor %}
{% if has_cli %}
    { "cli", {{ cli_stack_size | default(512) }} },
{% endif %}
    { "event_mgr", 512 },
{% if has_fota_receive %}
    { "fota", 512 },
{% endif %}
{% if has_components %}
    { "comp_step", 512 },
{% endif %}
};

#define TASK_STACK_TABLE_LEN \
    ((uint32_t)(sizeof(g_task_stack_table) / sizeof(g_task_stack_table[0])))

static uint16_t task_stack_alloc_words(const char *name)
{
    if (name == NULL) {
        return 0;
    }
    for (uint32_t i = 0; i < TASK_STACK_TABLE_LEN; i++) {
        if (strcmp(g_task_stack_table[i].name, name) == 0) {
            return g_task_stack_table[i].stack_words;
        }
    }
    return 0;
}
#endif /* !TEST */

int telemetry_collect(telemetry_snapshot_t *snap)
{
    if (snap == NULL) return -1;

    memset(snap, 0, sizeof(*snap));

#ifndef TEST
    /* ---- Uptime ---- */
    extern uint32_t rtc_uptime_sec;
    snap->uptime_sec = rtc_uptime_sec;

    /* ---- Heartbeat ---- */
    g_telemetry.heartbeat_count++;
    snap->heartbeat_count = g_telemetry.heartbeat_count;

    /* ---- Heap ---- */
    snap->heap_free = xPortGetFreeHeapSize();
    snap->heap_size = configTOTAL_HEAP_SIZE;

    /* Update minimum free heap */
    if (snap->heap_free < g_telemetry.heap_min_free) {
        g_telemetry.heap_min_free = snap->heap_free;
    }
    snap->heap_min_free = g_telemetry.heap_min_free;

    /* ---- Task enumeration ---- */
    {
        TaskStatus_t *task_stats = NULL;
        uint32_t total_run_time;
        uint32_t task_cnt = uxTaskGetNumberOfTasks();

        /* Allocate task status array from stack, clamped to safe size */
        uint32_t count = task_cnt;
        if (count > TELEMETRY_MAX_TASKS) {
            count = TELEMETRY_MAX_TASKS;
        }

        /* Use stack-allocated array (safe up to TELEMETRY_MAX_TASKS * sizeof(TaskStatus_t)) */
        TaskStatus_t stats[TELEMETRY_MAX_TASKS];
        task_stats = stats;

        task_cnt = uxTaskGetSystemState(task_stats, count, &total_run_time);
        if (task_cnt > TELEMETRY_MAX_TASKS) {
            task_cnt = TELEMETRY_MAX_TASKS;
        }
        snap->task_count = task_cnt;

        uint32_t min_watermark = (uint32_t)(-1);

        for (uint32_t i = 0; i < task_cnt; i++) {
            snap->tasks[i].name = task_stats[i].pcTaskName;

            /* Words *remaining* at the worst point measured so far. */
            TaskHandle_t handle = xTaskGetHandle(task_stats[i].pcTaskName);
            uint32_t remaining = 0;
            uint32_t have_measurement = 0;
            if (handle != NULL) {
                remaining = (uint32_t)uxTaskGetStackHighWaterMark(handle);
                have_measurement = 1;
            }

            uint32_t alloc_words =
                (uint32_t)task_stack_alloc_words(task_stats[i].pcTaskName);
            snap->tasks[i].total_stack = (uint16_t)alloc_words;
            snap->tasks[i].watermark   = (uint16_t)remaining;

            /* Peak usage needs both the measurement and the allocation.
             * The "remaining <= alloc" guard rejects an impossible reading
             * rather than underflowing to a huge "used" figure. */
            if (have_measurement != 0U && alloc_words > 0U &&
                remaining <= alloc_words) {
                snap->tasks[i].peak_usage = (uint16_t)(alloc_words - remaining);
            } else {
                snap->tasks[i].peak_usage = 0;
            }

            if (have_measurement != 0U && remaining < min_watermark) {
                min_watermark = remaining;
            }

            snap->tasks[i].cpu_ticks = task_stats[i].ulRunTimeCounter;
        }

        /* "minimum free stack" = the task with the least remaining stack */
        if (min_watermark != (uint32_t)(-1)) {
            snap->min_stack_free = min_watermark;
        } else {
            snap->min_stack_free = 0;
        }
    }
#else
    /* Test mode: fill with dummy data */
    snap->uptime_sec = 0;
    snap->heartbeat_count = 1;
    snap->heap_free = 1024;
    snap->heap_size = 8192;
    snap->heap_min_free = 1024;
    snap->task_count = 1;
    snap->min_stack_free = 128;
#endif

    /* ---- Component stats ---- */
{% if has_components %}
    {
        snap->comp_total = g_telemetry.comp_total;
        uint32_t running = 0;
        uint32_t errors = 0;
        for (uint32_t i = 0; i < g_telemetry.comp_total && i < component_count(); i++) {
            component_t *c = component_get_by_index(i);
            if (c == NULL) continue;
            if (c->state == COMPONENT_RUNNING) {
                running++;
            } else if (c->state == COMPONENT_ERROR) {
                errors++;
            }
        }
        snap->comp_running = running;
        snap->comp_error = errors;
        snap->total_errors = 0;
        for (uint32_t i = 0; i < g_telemetry.comp_total && i < component_count(); i++) {
            component_t *c = component_get_by_index(i);
            if (c != NULL) {
                snap->total_errors += c->error_count;
            }
        }
    }
{% else %}
    snap->comp_total = 0;
    snap->comp_running = 0;
    snap->comp_error = 0;
    snap->total_errors = 0;
{% endif %}

    /* ---- Notify callbacks ---- */
    for (uint32_t i = 0; i < g_cb_count; i++) {
        if (g_cb[i] != NULL) {
            g_cb[i](snap, g_cb_ctx[i]);
        }
    }

    return 0;
}

void telemetry_log_snapshot(void)
{
    telemetry_snapshot_t snap;
    char buf[640];
    int  len = 0;

{% if has_log %}
    if (!g_snapshot_log_enabled) {
        return;
    }
    telemetry_collect(&snap);

    len += snprintf(buf + len, sizeof(buf) - (size_t)len,
                    "=== Telemetry Snapshot ===\r\n");
    len += snprintf(buf + len, sizeof(buf) - (size_t)len,
                    "  Uptime: %lu s   Heartbeat: %lu\r\n",
                    (unsigned long)snap.uptime_sec,
                    (unsigned long)snap.heartbeat_count);
    len += snprintf(buf + len, sizeof(buf) - (size_t)len,
                    "  Heap:   %lu / %lu bytes (min free %lu)\r\n",
                    (unsigned long)snap.heap_free,
                    (unsigned long)snap.heap_size,
                    (unsigned long)snap.heap_min_free);
    len += snprintf(buf + len, sizeof(buf) - (size_t)len,
                    "  Tasks(%lu):\r\n", (unsigned long)snap.task_count);
    for (uint32_t i = 0; i < snap.task_count && i < TELEMETRY_MAX_TASKS; i++) {
        if (len >= (int)sizeof(buf) - 96) break;
        len += snprintf(buf + len, sizeof(buf) - (size_t)len,
                        "    %-16s stack %u used=%u free=%u run=%lu\r\n",
                        snap.tasks[i].name,
                        (unsigned int)snap.tasks[i].total_stack,
                        (unsigned int)snap.tasks[i].peak_usage,
                        (unsigned int)snap.tasks[i].watermark,
                        (unsigned long)snap.tasks[i].cpu_ticks);
    }
    len += snprintf(buf + len, sizeof(buf) - (size_t)len,
                    "  Min stack free: %lu words\r\n",
                    (unsigned long)snap.min_stack_free);
    len += snprintf(buf + len, sizeof(buf) - (size_t)len,
                    "  Components: %lu total, %lu running, %lu error, %lu total-errors\r\n",
                    (unsigned long)snap.comp_total,
                    (unsigned long)snap.comp_running,
                    (unsigned long)snap.comp_error,
                    (unsigned long)snap.total_errors);
    if (len < 0) len = 0;
    if (len >= (int)sizeof(buf)) len = (int)sizeof(buf) - 1;
    buf[len] = '\0';

    /* Single timestamp header, one block — no per-line timestamps */
    log_block(LOG_LEVEL_INFO, buf);
{% else %}
    telemetry_collect(&snap);
    (void)snap;
{% endif %}
}

