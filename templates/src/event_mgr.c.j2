                 * directly from WakeUp/Alarm callbacks). EVENT_RTC_TICK
                 * preserved for external consumers if needed. */
            }
            statemachine_process(&evt);
{% if has_log %}
{% for pe in periodic_events %}
            if (evt.id == EVENT_{{ pe.event }}) {
{% for action in pe.actions %}
{% if action.startswith('log ') %}
                log_info("{{ action[4:].strip().strip('\"') }}");
{% elif action == 'telemetry_snapshot' %}
                telemetry_log_snapshot();
{% elif action == 'power_status' %}
                power_mgr_log_status();
{% endif %}
{% endfor %}
            }
{% endfor %}
{% endif %}
{% else %}
            switch(evt.id) {
                case EVENT_MINUTE_TICK:
                    handle_minute_tick();
                    break;
                case EVENT_HOUR_TICK:
                    handle_hour_tick();
                    break;
                case EVENT_BUTTON_PRESS:
                    handle_button_press();
                    break;
                case EVENT_BUTTON_RELEASE:
                    handle_button_release();
                    break;
{% for p in peripherals %}
{% if p.type == 'I2C_Sensor_MPU6050' %}
                case EVENT_MPU6050_ALERT:
                    handle_mpu6050_alert();
                    break;
{% endif %}
{% endfor %}
                case EVENT_RTC_TICK:
                    /* ISR-driven now; preserved for external consumers */
                    break;
                default:
                    break;
            }
{% endif %}
#else
