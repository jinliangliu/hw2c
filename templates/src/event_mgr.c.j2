void EventMgr_Task(void *pvParameters)
{
    event_t evt;
    while(1) {
        if( xQueueReceive(event_queue, &evt, portMAX_DELAY) == pdTRUE ) {
#ifndef TEST
{% if has_behavior %}
{% if has_log %}
            log_debug("EventMgr: dispatching event #%d", (int)evt.id);
{% endif %}
            if (evt.id == EVENT_RTC_TICK) {
