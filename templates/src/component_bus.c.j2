{% endif %}

/* ---- bus_init ---- */
void bus_init(void)
{
    for (uint32_t i = 0; i < g_bus_slot_count; i++) {
        g_bus_slots[i].active = false;
        g_bus_slots[i].handler = NULL;
        g_bus_slots[i].ctx = NULL;
        g_bus_slots[i].topic = TOPIC_NONE;
    }
}

/* ---- bus_publish ---- */
int bus_publish(topic_id_t topic, uint32_t value)
{
    if (topic <= TOPIC_NONE || topic >= TOPIC_MAX) {
        return -1;
    }

    int notified = 0;
    for (uint32_t i = 0; i < g_bus_slot_count; i++) {
        bus_slot_t *s = &g_bus_slots[i];
        if (s->active && s->topic == topic && s->handler != NULL) {
            s->handler(topic, value, s->ctx);
            notified++;
        }
    }
    return notified;
}

/* ---- bus_subscribe ---- */
int bus_subscribe(topic_id_t topic, bus_handler_t handler, void *ctx)
{
    if (topic <= TOPIC_NONE || topic >= TOPIC_MAX || handler == NULL) {
        return -1;
    }

    /* Find free slot */
    for (uint32_t i = 0; i < g_bus_slot_count; i++) {
        bus_slot_t *s = &g_bus_slots[i];
        if (!s->active) {
            s->topic   = topic;
            s->handler = handler;
            s->ctx     = ctx;
            s->active  = true;
            return 0;
        }
    }
    return -1;  /* no free slots */
}

/* ---- bus_unsubscribe ---- */
int bus_unsubscribe(topic_id_t topic, bus_handler_t handler)
{
    if (topic <= TOPIC_NONE || topic >= TOPIC_MAX || handler == NULL) {
        return -1;
    }

    for (uint32_t i = 0; i < g_bus_slot_count; i++) {
        bus_slot_t *s = &g_bus_slots[i];
        if (s->active && s->topic == topic && s->handler == handler) {
            s->active  = false;
            s->handler = NULL;
            s->ctx     = NULL;
            s->topic   = TOPIC_NONE;
            return 0;
        }
    }
    return -1;  /* not found */
}

