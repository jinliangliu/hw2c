/**
 * @file  param_registry.h
 * @brief Runtime parameter registry (generated by hw2c)
 *
 * Parameters are typed, bounded values that can be read/written at runtime.
 * Each parameter has: name, type, min/max, readonly flag, persist flag.
 *
 * Static allocation — parameter count fixed at generation time.
 *
 * Auto-generated — do not edit manually.
 */

#ifndef __PARAM_REGISTRY_H
#define __PARAM_REGISTRY_H

#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

/* ---- Parameter type ---- */
typedef enum {
    PARAM_TYPE_INT32  = 0,
    PARAM_TYPE_UINT32 = 1,
    PARAM_TYPE_FLOAT  = 2,
    PARAM_TYPE_BOOL   = 3,
} param_type_t;

/* ---- Parameter error codes ---- */
typedef enum {
    PARAM_OK          =  0,
    PARAM_ERR_NAME    = -1,   /* parameter not found */
    PARAM_ERR_READONLY  = -2,   /* write to readonly parameter */
    PARAM_ERR_RANGE   = -3,   /* value out of range */
    PARAM_ERR_TYPE    = -4,   /* type mismatch */
} param_err_t;

/* ---- Parameter descriptor ---- */
typedef struct {
    const char   *name;
    const char   *component;
    param_type_t  type;
    void         *value_ptr;      /* pointer to runtime value */
    int32_t       min_i32;
    int32_t       max_i32;
    uint32_t      min_u32;
    uint32_t      max_u32;
    float         min_f32;
    float         max_f32;
    bool          readonly;
    bool          persistent;
} param_t;

/* ---- Registry API ---- */

/**
 * @brief  Initialize all parameters to their default values
 */
void param_init(void);

/**
 * @brief  Look up a parameter by name
 * @return Pointer to param descriptor, or NULL if not found
 */
param_t *param_get(const char *name);

/**
 * @brief  Get parameter count
 */
uint32_t param_count(void);

/**
 * @brief  Get parameter value as int32
 * @return 0 on success, negative on error
 */
int param_get_int32(param_t *p, int32_t *out);

/**
 * @brief  Set parameter value as int32 (range check)
 * @return 0 on success, PARAM_ERR_* on error
 */
int param_set_int32(param_t *p, int32_t val);

/**
 * @brief  Get parameter value as uint32
 * @return 0 on success, negative on error
 */
int param_get_uint32(param_t *p, uint32_t *out);

/**
 * @brief  Set parameter value as uint32 (range check)
 * @return 0 on success, PARAM_ERR_* on error
 */
int param_set_uint32(param_t *p, uint32_t val);

/**
 * @brief  Get parameter value as float
 * @return 0 on success, negative on error
 */
int param_get_float(param_t *p, float *out);

/**
 * @brief  Set parameter value as float (range check)
 * @return 0 on success, PARAM_ERR_* on error
 */
int param_set_float(param_t *p, float val);

/**
 * @brief  Get parameter value as bool
 * @return 0 on success, negative on error
 */
int param_get_bool(param_t *p, bool *out);

/**
 * @brief  Set parameter value as bool
 * @return 0 on success, PARAM_ERR_* on error
 */
int param_set_bool(param_t *p, bool val);

#ifdef __cplusplus
}
#endif

