{#
  app_slot_b.ld.j2 - App Slot B linker script
  Generates: linker/app_slot_b.ld
  App Slot B occupies {{ boot_config._app_b_size // 1024 }}KB at {{ "0x%08X" % boot_config._app_b_start }}.
  This is the OTA target slot — new firmware is written here, then booted.
  VTOR must be set to {{ "0x%08X" % boot_config._app_b_start }} in SystemInit() or startup.

  ⚠️ 这里原先把 Bank2 起点 0x08040000 与 256KB **写成了字面量**，与
  app_slot_a.ld.j2 从 boot_config 取值的做法不一致 —— 一旦 YAML 改了
  app_b_offset，A 槽会跟着动、B 槽不会。现在两者都从 boot_config 取值。
#}

/**
 ******************************************************************************
 * @file      app_slot_b.ld
 * @brief     Linker script for App Slot B (STM32G0B1RET6, {{ boot_config._app_b_size // 1024 }}KB Flash)
 *            Vector table at {{ "0x%08X" % boot_config._app_b_start }}, runs after Bootloader.
 *            Auto-generated by Hardware2Code
 ******************************************************************************
 */

ENTRY(Reset_Handler)

_estack = ORIGIN(RAM) + LENGTH(RAM);

_Min_Heap_Size = {{ heap_size | default('0x200') }};
_Min_Stack_Size = {{ stack_size | default('0x400') }};

/* VTOR 偏移量（C 代码中设置 SCB->VTOR 时使用） */
__vtor_offset__ = 0x{{ "%08X" % boot_config.app_b_offset }};

MEMORY
{
  RAM    (xrw)    : ORIGIN = 0x20000000,   LENGTH = 144K
  FLASH  (rx)     : ORIGIN = {{ boot_config._app_b_start }},   LENGTH = {{ boot_config._app_b_size }}
}

SECTIONS
{
  .isr_vector :
  {
    . = ALIGN(4);
    KEEP(*(.isr_vector))

    /* ⚠️ 把位置计数器**推进到槽内偏移 {{ fota_fmt.img_hdr_off }}**，让镜像头恰好落在那里。
       绝不能依赖"向量表自然就是那么长"：实测 `.isr_vector` 只有 47 项
       = 188 B = 0xBC，头部会落到 0xBC，而引导器按 `slot_base + {{ fota_fmt.img_hdr_off }}`
       读 magic ⇒ **所有镜像都被判无效**，且生成与编译全都不报错。
       若将来向量表超过该偏移，链接器会报 "cannot move location counter
       backwards"，是 fail-closed 的。 */
    . = ORIGIN(FLASH) + {{ fota_fmt.img_hdr_off }};
  } >FLASH

  /* 固件镜像头部（槽内偏移 {{ fota_fmt.img_hdr_off }}，共 {{ fota_fmt.img_hdr_size }} 字节）
     Bootloader 与 fota_delta 都从 `slot_base + {{ fota_fmt.img_hdr_off }}` 读取此头部。
     字段偏移的真源是 generator/data/fota_format.json（这里按它展开，不写死字面量）：
       +{{ fota_fmt.img_off_image_size }}  image_size (u32)  payload 字节数
       +{{ fota_fmt.img_off_crc32 }}  crc32      (u32)  CRC-32/ISO-HDLC（≡ zlib.crc32，**不是** MPEG-2）
       +{{ fota_fmt.img_off_magic }}  magic      (u32)  {{ "0x%08X" % fota_fmt.img_magic }}（内存中呈现为 'kCAH'，勿"顺手"改成 ASCII）
       +{{ fota_fmt.img_off_fw_version }}  fw_version (u32)  24-bit 有效
     编译后由 patch_crc.py **原位回填**（不插入字节；插入会使镜像位移而
     向量表/字面量池中的绝对地址失配 —— B1）。 */
  .app_header :
  {
    . = ALIGN(4);
    LONG(0xFFFFFFFF);                      /* +{{ fota_fmt.img_off_image_size }}  image_size  占位，编译后回填 */
    LONG(0xFFFFFFFF);                      /* +{{ fota_fmt.img_off_crc32 }}  crc32       占位，编译后回填 */
    LONG({{ "0x%08X" % fota_fmt.img_magic }});                      /* +{{ fota_fmt.img_off_magic }}  magic       标识有效头部（数值真源：fota_format.json） */
    LONG(0xFFFFFFFF);                      /* +{{ fota_fmt.img_off_fw_version }}  fw_version  占位，编译后回填 */
  } >FLASH

  /* 链接期断言：头部的**位置**与**大小**是两个必须成立的不变量。
     任一被破坏，机器上的症状都是"引导器拒掉所有镜像"，且不会在任何
     编译产物里留下痕迹 —— 所以放在这里，让它变成链接错误。 */
  ASSERT(ADDR(.app_header) - ORIGIN(FLASH) == {{ fota_fmt.img_hdr_off }},
         "镜像头不在槽内偏移 {{ fota_fmt.img_hdr_off }} 上：向量表填充被破坏")
  ASSERT(SIZEOF(.app_header) == {{ fota_fmt.img_hdr_size }},
         "镜像头段大小与 fota_format.json 不一致")

  .text :
  {
    . = ALIGN(4);
    *(.text)
    *(.text*)
    *(.glue_7)
    *(.glue_7t)
    *(.eh_frame)

    KEEP (*(.init))
    KEEP (*(.fini))

    . = ALIGN(4);
    _etext = .;
  } >FLASH

  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)
    *(.rodata*)
    . = ALIGN(4);
  } >FLASH

  .ARM.extab (READONLY) :
  {
    . = ALIGN(4);
    *(.ARM.extab* .gnu.linkonce.armextab.*)
    . = ALIGN(4);
  } >FLASH

  .ARM (READONLY) :
  {
    . = ALIGN(4);
    __exidx_start = .;
    *(.ARM.exidx*)
    __exidx_end = .;
    . = ALIGN(4);
  } >FLASH

  .preinit_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__preinit_array_start = .);
    KEEP (*(.preinit_array*))
    PROVIDE_HIDDEN (__preinit_array_end = .);
    . = ALIGN(4);
  } >FLASH

  .init_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__init_array_start = .);
    KEEP (*(SORT(.init_array.*)))
    KEEP (*(.init_array*))
    PROVIDE_HIDDEN (__init_array_end = .);
    . = ALIGN(4);
  } >FLASH

  .fini_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__fini_array_start = .);
    KEEP (*(SORT(.fini_array.*)))
    KEEP (*(.fini_array*))
    PROVIDE_HIDDEN (__fini_array_end = .);
    . = ALIGN(4);
  } >FLASH

  _sidata = LOADADDR(.data);

  .data :
  {
    . = ALIGN(4);
    _sdata = .;
    *(.data)
    *(.data*)
    . = ALIGN(4);
    _edata = .;
  } >RAM AT> FLASH

  /*
   * Reset-surviving variables (hw2c_fault.c).  Deliberately NOT initialised by
   * the start-up code, so a fault reason stored here survives
   * NVIC_SystemReset() and a watchdog reset.  Must precede .bss, because the
   * "*(.bss*)" pattern would otherwise swallow this input section.
   */
  .noinit (NOLOAD) :
  {
    . = ALIGN(4);
    _snoinit = .;
    KEEP(*(.noinit))
    . = ALIGN(4);
    _enoinit = .;
  } >RAM

  . = ALIGN(4);
  .bss :
  {
    _sbss = .;
    __bss_start__ = _sbss;
    *(.bss)
    *(.bss*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = .;
    __bss_end__ = _ebss;
  } >RAM

  ._user_heap_stack :
  {
    . = ALIGN(8);
    PROVIDE ( end = . );
    PROVIDE ( _end = . );
    . = . + _Min_Heap_Size;
    . = . + _Min_Stack_Size;
    . = ALIGN(8);
  } >RAM

  /DISCARD/ :
  {
    libc.a ( * )
    libm.a ( * )
    libgcc.a ( * )
  }

  .ARM.attributes 0 : { *(.ARM.attributes) }
}
