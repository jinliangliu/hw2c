{#
  bootloader.ld.j2 - Bootloader linker script
  Generates: linker/bootloader.ld
  Bootloader occupies first {{ boot_config.size_kb }}KB of Bank1 Flash.
  Defines symbols for App Slot A/B locations used by bootloader code.
#}

/**
 ******************************************************************************
 * @file      bootloader.ld
 * @brief     Linker script for Bootloader (STM32G0B1RET6, {{ boot_config.size_kb }}KB Flash)
 *            Auto-generated by Hardware2Code
 ******************************************************************************
 */

/* Entry Point */
ENTRY(Reset_Handler)

/* Highest address of the user mode stack */
_estack = ORIGIN(RAM) + LENGTH(RAM);

_Min_Heap_Size = {{ heap_size | default('0x0') }};
_Min_Stack_Size = {{ stack_size | default('0x200') }};

/*
 * Memories definition
 *
 * ⚠️ FLASH 的 LENGTH 是 **`boot_config.size_kb` 减去元数据页**，不是 size_kb。
 * 引导器区的最后一页归 FOTA 元数据（`fota_meta.{c,h}`），不是可执行区。
 *
 * 如果这里写 `size_kb*1024`，引导器代码一旦涨到最后一页，链接器会**痛快地**
 * 把代码放进去 —— 元数据页在运行期被 `fota_meta_append()` 擦掉时，
 * 擦的是引导器正在执行的代码。症状是"升级到一半设备再也不启动"，
 * 而且只在代码恰好涨过一页时才出现。
 *
 * 现在改成：越界 = **链接失败**（下面的 ASSERT 给出可读的原因）。
 */
MEMORY
{
  RAM    (xrw)    : ORIGIN = 0x20000000,   LENGTH = 144K
  FLASH  (rx)     : ORIGIN = 0x08000000,   LENGTH = {{ boot_config._boot_code_size }}
}
__app_slot_a_start__ = {{ boot_config._app_a_start }};
__app_slot_a_end__   = {{ boot_config._app_a_end }};
__app_slot_b_start__ = {{ boot_config._app_b_start }};
__app_slot_b_end__   = {{ boot_config._app_b_end }};

/* Sections */
SECTIONS
{
  .isr_vector :
  {
    . = ALIGN(4);
    KEEP(*(.isr_vector))
    . = ALIGN(4);
  } >FLASH

  .text :
  {
    . = ALIGN(4);
    *(.text)
    *(.text*)
    *(.glue_7)
    *(.glue_7t)
    *(.eh_frame)

    KEEP (*(.init))
    KEEP (*(.fini))

    . = ALIGN(4);
    _etext = .;
  } >FLASH

  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)
    *(.rodata*)
    . = ALIGN(4);
  } >FLASH

  .ARM.extab (READONLY) :
  {
    . = ALIGN(4);
    *(.ARM.extab* .gnu.linkonce.armextab.*)
    . = ALIGN(4);
  } >FLASH

  .ARM (READONLY) :
  {
    . = ALIGN(4);
    __exidx_start = .;
    *(.ARM.exidx*)
    __exidx_end = .;
    . = ALIGN(4);
  } >FLASH

  .preinit_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__preinit_array_start = .);
    KEEP (*(.preinit_array*))
    PROVIDE_HIDDEN (__preinit_array_end = .);
    . = ALIGN(4);
  } >FLASH

  .init_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__init_array_start = .);
    KEEP (*(SORT(.init_array.*)))
    KEEP (*(.init_array*))
    PROVIDE_HIDDEN (__init_array_end = .);
    . = ALIGN(4);
  } >FLASH

  .fini_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__fini_array_start = .);
    KEEP (*(SORT(.fini_array.*)))
    KEEP (*(.fini_array*))
    PROVIDE_HIDDEN (__fini_array_end = .);
    . = ALIGN(4);
  } >FLASH

  /* Bootloader 代码结束标记 */
  .bootloader_end :
  {
    . = ALIGN(4);
    __bootloader_end__ = .;
  } >FLASH

  /* 元数据页基址（绝对符号，不占空间）。App 侧不链接本脚本，它从
   * fota_meta.h 的 FOTA_META_PAGE_BASE 拿同一个值 —— 两者都由
   * `bootloader_context.py` 从 `bootloader.size_kb` 算出，只有一处真源。 */
  __fota_meta_page__ = {{ '0x%08X' | format(boot_config._meta_page_base) }};

  _sidata = LOADADDR(.data);

  .data :
  {
    . = ALIGN(4);
    _sdata = .;
    *(.data)
    *(.data*)
    . = ALIGN(4);
    _edata = .;
  } >RAM AT> FLASH

  /*
   * Reset-surviving variables (hw2c_fault.c).  Deliberately NOT initialised by
   * the start-up code, so a fault reason stored here survives
   * NVIC_SystemReset() and a watchdog reset.  Must precede .bss, because the
   * "*(.bss*)" pattern would otherwise swallow this input section.
   */
  .noinit (NOLOAD) :
  {
    . = ALIGN(4);
    _snoinit = .;
    KEEP(*(.noinit))
    . = ALIGN(4);
    _enoinit = .;
  } >RAM

  . = ALIGN(4);
  .bss :
  {
    _sbss = .;
    __bss_start__ = _sbss;
    *(.bss)
    *(.bss*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = .;
    __bss_end__ = _ebss;
  } >RAM

  ._user_heap_stack :
  {
    . = ALIGN(8);
    PROVIDE ( end = . );
    PROVIDE ( _end = . );
    . = . + _Min_Heap_Size;
    . = . + _Min_Stack_Size;
    . = ALIGN(8);
  } >RAM

  /DISCARD/ :
  {
    libc.a ( * )
    libm.a ( * )
    libgcc.a ( * )
  }

  .ARM.attributes 0 : { *(.ARM.attributes) }
}

/*
 * 引导器代码不得越过元数据页 —— 越过就是"运行期自己擦掉自己"。
 *
 * FLASH 区域的 LENGTH 已经扣掉了这一页，所以越界本来就会以
 * "region FLASH overflowed" 的形式失败；这条 ASSERT 的价值在于把
 * **为什么**写进链接错误里。溢出报错只说明"放不下"，不说明"放不下"
 * 是因为元数据页占了地方，而最容易的错误修法是去调大 size_kb ——
 * 那会把元数据页一起搬走，让已经写进去的升级状态凭空消失。
 */
ASSERT(__bootloader_end__ <= {{ '0x%08X' | format(boot_config._meta_page_base) }},
       "FATAL: bootloader code overlaps the FOTA metadata page at {{ '0x%08X' | format(boot_config._meta_page_base) }}. Shrink the bootloader or raise bootloader.size_kb.")
