cmake_minimum_required(VERSION 3.20)

# ═══════════════════════════════════════════════════════════════════════════════
# {{ project_name | default('hw2code') }} — generated by Hardware2Code
# MCU: {{ mcu.part }} ({{ mcu.core | default('Cortex-M0+') }})
# Core Clock: {{ mcu.core_clock_mhz }} MHz
{% if hil_mode %}
# ** HIL TEST FIRMWARE **
{% else %}
# FreeRTOS Kernel: included from static
{% endif %}
# Build: cmake -B build -DCMAKE_TOOLCHAIN_FILE=toolchain.cmake && cmake --build build
# ═══════════════════════════════════════════════════════════════════════════════

project({{ project_name | default('hw2code') }} C ASM)

# ── MCU compile definitions ──────────────────────────────────────────────────
add_compile_definitions(
    {{ mcu.part | upper }}
    STM32G0B1xx
    USE_HAL_DRIVER
    HSI_VALUE=16000000
    HCLK_FREQ=16000000
{% if has_bootloader %}
    VECT_TAB_OFFSET={{ boot_config.app_a_offset | default(0x2000) }}U
{% endif %}
)

# ── Static library path (HAL + CMSIS + FreeRTOS + Unity) ────────────────────
set(HARDWARE2CODE_STATIC "$ENV{HARDWARE2CODE_STATIC}" CACHE PATH
    "Path to hw2c static/ directory")
if(NOT HARDWARE2CODE_STATIC)
    set(HARDWARE2CODE_STATIC "{{ static_dir_absolute | replace('\\', '/') }}")
endif()

set(HAL_DIR           "${HARDWARE2CODE_STATIC}/HAL")
set(CMSIS_DEVICE_DIR  "${HARDWARE2CODE_STATIC}/CMSIS/Device/ST/STM32G0xx")
set(CMSIS_CORE_DIR    "${HARDWARE2CODE_STATIC}/CMSIS/Core")
set(STARTUP_DIR       "${CMSIS_DEVICE_DIR}/Source/Templates/gcc")
{% if not hil_mode %}
set(FREERTOS_DIR      "${HARDWARE2CODE_STATIC}/FreeRTOS-Kernel")
{% endif %}
get_filename_component(HW2C_ROOT "${HARDWARE2CODE_STATIC}" DIRECTORY)
set(LWRB_DIR          "${HW2C_ROOT}/third_party/lwrb")
set(HW2C_CLI_DIR      "${HW2C_ROOT}/hw2c_cli")

# ── Linker script ────────────────────────────────────────────────────────────
set(LINKER_SCRIPT "${CMAKE_SOURCE_DIR}/linker/{{ 'app_slot_a.ld' if has_bootloader else 'STM32G0B1RETx_FLASH.ld' }}")
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -T${LINKER_SCRIPT}")

# ── Global include directories ──────────────────────────────────────────────
set(COMMON_INCLUDES
    ${HAL_DIR}/Inc
    ${CMSIS_DEVICE_DIR}/Include
    ${CMSIS_CORE_DIR}
    ${CMAKE_SOURCE_DIR}/config
)
{% if not hil_mode %}
list(APPEND COMMON_INCLUDES
    ${FREERTOS_DIR}/include
    ${FREERTOS_DIR}/portable/GCC/ARM_CM0
    ${LWRB_DIR}
    ${HW2C_CLI_DIR}
)
{% endif %}

# ── HAL library (object library, shared) ─────────────────────────────────────
add_library(hal OBJECT
{% for src in hal_sources %}
    ${HAL_DIR}/Src/{{ src }}
{% endfor %}
{% if has_foc and not has_adc %}
    ${HAL_DIR}/Src/stm32g0xx_hal_adc.c
{% endif %}
{% if has_log %}
{% if not has_uart %}
    ${HAL_DIR}/Src/stm32g0xx_hal_uart.c
{% endif %}
    ${HAL_DIR}/Src/stm32g0xx_hal_uart_ex.c
{% endif %}
    ${CMSIS_DEVICE_DIR}/Source/Templates/system_stm32g0xx.c
    ${STARTUP_DIR}/startup_stm32g0b1xx.s
)
target_include_directories(hal PRIVATE ${COMMON_INCLUDES})
target_compile_options(hal PRIVATE
{% if hil_mode %}
    -Og -g3
{% else %}
    -Og -g3
{% endif %}
)

{% if not hil_mode %}
# ── FreeRTOS library ─────────────────────────────────────────────────────────
add_library(freertos OBJECT
    ${FREERTOS_DIR}/tasks.c
    ${FREERTOS_DIR}/queue.c
    ${FREERTOS_DIR}/list.c
    ${FREERTOS_DIR}/timers.c
    ${FREERTOS_DIR}/event_groups.c
    ${FREERTOS_DIR}/stream_buffer.c
    ${FREERTOS_DIR}/portable/MemMang/heap_4.c
    ${FREERTOS_DIR}/portable/GCC/ARM_CM0/port.c
    ${FREERTOS_DIR}/portable/GCC/ARM_CM0/portasm.c
)
target_include_directories(freertos PRIVATE ${COMMON_INCLUDES})
{% endif %}

# ── User application executable ──────────────────────────────────────────────
set(APP_SOURCES
    src/main.c
    src/gpio.c
    src/sleep.c
    src/stm32g0xx_it.c
    src/event_mgr.c
    src/stm32g0xx_hal_timebase_tim.c
{% if has_behavior %}
    src/statemachine.c
{% endif %}
{% if has_bootloader %}
    src/boot_app.c
{% endif %}
{% for drv in drivers if drv.template or drv.header_template %}
    src/drivers/drv_{{ drv.name }}.c
{% endfor %}
{% if has_log %}
    src/drivers/drv_log.c
{% endif %}
{% if not hil_mode %}
    ${LWRB_DIR}/lwrb.c
    ${HW2C_CLI_DIR}/hw2c_cli.c
{% endif %}
{% if has_uart %}
    src/drivers/uart_api.c
{% endif %}
{% if has_adc %}
    src/drivers/adc_api.c
{% endif %}
{% if has_i2c %}
    src/drivers/i2c_api.c
{% endif %}
{% if has_spi %}
    src/drivers/spi_api.c
{% endif %}
    src/drivers/gpio_api.c
{% if has_mpu6050 %}
    src/attitude.c
{% endif %}
{% if has_fall_detect %}
    src/fall_detect.c
{% endif %}
{% if has_foc %}
    src/foc_math.c
{% endif %}
{% if has_pid_ctrl %}
    src/pid_math.c
    src/pid_autotune.c
{% endif %}
{% if has_components %}
    src/component_registry.c
{% for comp in components %}
    src/{{ comp.name }}_component.c
{% endfor %}
{% endif %}
{% if has_topics %}
    src/component_bus.c
{% endif %}
{% if has_params %}
    src/param_registry.c
{% endif %}
{% if has_telemetry %}
    src/telemetry.c
{% endif %}
{% if has_power_mgr %}
    src/power_mgr.c
{% endif %}
)

# Per-driver includes (each driver may need its own headers)
{% for drv in drivers %}
{% if drv.get('includes') %}
{% for inc in drv.includes %}
target_include_directories(${PROJECT_NAME} PRIVATE {{ inc | replace('$(HARDWARE2CODE_STATIC)', '${HARDWARE2CODE_STATIC}') }})
{% endfor %}
{% endif %}
{% endfor %}

add_executable(${PROJECT_NAME} ${APP_SOURCES})
target_compile_definitions(${PROJECT_NAME} PRIVATE LWRB_DISABLE_ATOMIC)
target_include_directories(${PROJECT_NAME} PRIVATE
    ${COMMON_INCLUDES}
    ${CMAKE_SOURCE_DIR}/src
    ${CMAKE_SOURCE_DIR}/src/drivers
)
{% if has_bootloader %}
# Driver lib for app (shared with bootloader)
{% if has_log %}
target_include_directories(${PROJECT_NAME} PRIVATE ${CMAKE_SOURCE_DIR}/tools)
{% endif %}
{% endif %}

# Link HAL + FreeRTOS to main executable
target_link_libraries(${PROJECT_NAME} PRIVATE hal{% if not hil_mode %} freertos{% endif %} m)

# Disable linking step try-compile (bare-metal)
set_target_properties(${PROJECT_NAME} PROPERTIES
    SUFFIX ".elf"
    LINK_DEPENDS ${LINKER_SCRIPT}
)

# ── Post-build: generate .bin and .hex ──────────────────────────────────────
add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
    COMMAND ${CMAKE_OBJCOPY} -O binary $<TARGET_FILE:${PROJECT_NAME}>
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin
    COMMAND ${CMAKE_OBJCOPY} -O ihex $<TARGET_FILE:${PROJECT_NAME}>
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.hex
    COMMAND ${CMAKE_SIZE_UTIL} $<TARGET_FILE:${PROJECT_NAME}>
    COMMENT "Generating .bin and .hex..."
)

# ── Flash targets ───────────────────────────────────────────────────────────
# STM32_Programmer_CLI (ST-Link) — set STM32_PROG_CLI in env or cmake cache
set(STM32_PROG_CLI "$ENV{STM32_PROG_CLI}" CACHE FILEPATH "Path to STM32_Programmer_CLI")
if(NOT STM32_PROG_CLI)
    find_program(STM32_PROG_CLI STM32_Programmer_CLI)
endif()

{% if has_bootloader %}
# With bootloader: flash combined image
# Build bootloader first, then run CRC patch, then flash
add_custom_target(flash
    COMMAND ${CMAKE_COMMAND} -E echo "Flashing combined image..."
    COMMENT "Flash via STM32_Programmer_CLI"
)
{% else %}
add_custom_target(flash
    COMMAND "${STM32_PROG_CLI}" -c port=SWD -w ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin 0x08000000 -rst
    DEPENDS ${PROJECT_NAME}
    COMMENT "Flashing ${PROJECT_NAME}.bin via STM32_Programmer_CLI"
)
{% endif %}

# OpenOCD / DAP-Link flash
add_custom_target(flash-daplink
    COMMAND openocd -f interface/cmsis-dap.cfg -f target/stm32g0x.cfg
            -c "program ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin 0x08000000 verify reset exit"
    DEPENDS ${PROJECT_NAME}
    COMMENT "Flashing via OpenOCD (CMSIS-DAP)"
)

{% if hil_mode %}
# ── HIL test runner ──────────────────────────────────────────────────────────
add_custom_target(hil-flash
    COMMAND ${CMAKE_COMMAND} -E echo "HIL test firmware flashed. Run 'python hil_runner.py'."
    DEPENDS flash
)
{% endif %}

{% if not hil_mode %}
# ── Unit tests ───────────────────────────────────────────────────────────────
add_custom_target(test
    COMMAND python test/run_tests.py
    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
    COMMENT "Running unit tests..."
)

add_custom_target(coverage
    COMMAND python test/run_tests.py --coverage
    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
    COMMENT "Running unit tests with coverage..."
)

{% if has_bootloader %}
# ── Bootloader ───────────────────────────────────────────────────────────────
# Build via external process (bootloader uses bare-metal, separate linker script)
add_custom_target(bootloader
    COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_BINARY_DIR}/bootloader
    COMMAND ${CMAKE_COMMAND} -S ${CMAKE_SOURCE_DIR}/bootloader
            -B ${CMAKE_BINARY_DIR}/bootloader
            -DCMAKE_TOOLCHAIN_FILE=${CMAKE_SOURCE_DIR}/toolchain.cmake
            -DHARDWARE2CODE_STATIC=${HARDWARE2CODE_STATIC}
    COMMAND ${CMAKE_COMMAND} --build ${CMAKE_BINARY_DIR}/bootloader
    COMMENT "Building bootloader..."
)

# ── App image (with CRC) ─────────────────────────────────────────────────────
add_custom_target(app
    COMMAND ${CMAKE_COMMAND} -E echo "Patching CRC32 into App firmware..."
    COMMAND python ${CMAKE_SOURCE_DIR}/patch_crc.py
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin
            --version $ENV{FOTA_VERSION}
            -o ${CMAKE_BINARY_DIR}/${PROJECT_NAME}_crc.bin
    DEPENDS ${PROJECT_NAME}
    COMMENT "Creating CRC-patched app image..."
)

# ── Combined image: Bootloader + App Slot A ──────────────────────────────────
add_custom_target(combined
    COMMAND ${CMAKE_COMMAND} -E echo "Merging bootloader + app..."
    COMMAND python -c
            "import sys; bl=open('${CMAKE_BINARY_DIR}/bootloader/bootloader.bin','rb').read(); bl_padded=bl+b'\xFF'*({{ boot_size_bytes }}-len(bl)); app=open('${CMAKE_BINARY_DIR}/${PROJECT_NAME}_crc.bin','rb').read(); open('${CMAKE_BINARY_DIR}/combined.bin','wb').write(bl_padded+app)"
    DEPENDS bootloader app
    COMMENT "Creating combined image..."
)

{% if has_fota %}
# ── FOTA diff generation ─────────────────────────────────────────────────────
add_custom_target(fota-diff
    COMMAND ${CMAKE_COMMAND} -E echo "Generating BSDIFF patch..."
    COMMAND python ${CMAKE_SOURCE_DIR}/generator/bsdiff_tool.py
            $ENV{FOTA_PREV_FW}
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}_crc.bin
            -o ${CMAKE_BINARY_DIR}/${PROJECT_NAME}_diff.patch
    DEPENDS app
    COMMENT "Creating FOTA diff..."
)

add_custom_target(fota-send
    COMMAND python ${CMAKE_SOURCE_DIR}/generator/fota_sender.py
            $ENV{FOTA_PORT}
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}_diff.patch
            --baud $ENV{FOTA_BAUD}
    COMMENT "Sending FOTA update..."
)
{% endif %}
{% endif %}
{% endif %}

# ── Clean helper ─────────────────────────────────────────────────────────────
set_directory_properties(PROPERTIES
    ADDITIONAL_CLEAN_FILES "${CMAKE_BINARY_DIR}/*.bin;${CMAKE_BINARY_DIR}/*.hex;${CMAKE_BINARY_DIR}/*.map"
)
