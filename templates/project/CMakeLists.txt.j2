{% endif %}
{% for drv in drivers if drv.template or drv.header_template %}
    src/drivers/drv_{{ drv.name }}.c
{% endfor %}
{% if has_log %}
    src/drivers/drv_log.c
{% endif %}
{% if not hil_mode %}
    ${LWRB_DIR}/lwrb.c
    ${HW2C_CLI_DIR}/hw2c_cli.c
{% endif %}
{% if has_uart %}
    src/drivers/uart_api.c
{% endif %}
{% if has_adc %}
    src/drivers/adc_api.c
{% endif %}
{% if has_i2c %}
    src/drivers/i2c_api.c
{% endif %}
{% if has_spi %}
    src/drivers/spi_api.c
{% endif %}
{% if has_persistent_params %}
    src/drivers/nvm_param.c
{% endif %}
    src/drivers/gpio_api.c
{% if has_mpu6050 %}
    src/attitude.c
{% endif %}
{% if has_fall_detect %}
    src/fall_detect.c
{% endif %}
{% if has_foc %}
    src/foc_math.c
{% endif %}
{% if has_pid_ctrl %}
    src/pid_math.c
    src/pid_autotune.c
    src/pid_steptune.c
{% endif %}
{% if has_components %}
    src/component_registry.c
{% for comp in components %}
    src/{{ comp.name }}_component.c
{% endfor %}
{% endif %}
{% if has_topics %}
    src/component_bus.c
{% endif %}
{% if has_params %}
    src/param_registry.c
{% endif %}
{% if has_telemetry %}
    src/telemetry.c
{% endif %}
{% if has_power_mgr %}
    src/power_mgr.c
{% endif %}
{% if has_bootloader %}
    # ── 差分 OTA：vendored 解码器 ─────────────────────────────────────────────
    # HPatchLite 负责 lite 流的 apply，tinyuz 负责压缩正文的解压。
    # 两者都**不因 TEST 构建而被替换成空桩**（A9 的教训）：主机侧的掉电注入
    # 测试编译的是**同一份** .c，只是把 Flash 后端换成内存实现。
    # 供应商源码只读，见 AGENTS.md 与各自目录下的 PROVENANCE.json。
    #
    # 门控用 has_bootloader 而不是 has_fota：解码器的唯一消费者是
    # drv_fota_delta，而它的注入条件就是 has_bootloader（差分应用要往
    # **另一个槽**写 Flash，没有引导器就没有第二个槽）。若门控写成
    # has_fota（= bootloader **and** uart），一个"有引导器但没串口"的工程会
    # 生成 drv_fota_delta.c 却不链解码器 → 链接期未定义符号。
    ${HW2C_ROOT}/third_party/hpatch_lite/hpatch_lite.c
    ${HW2C_ROOT}/third_party/tinyuz/decompress/tuz_dec.c
{% endif %}
)

# Per-driver includes (each driver may need its own headers)
#
# ⚠️ 顺序是硬约束：`target_include_directories` 必须先有 target。
# 这段曾位于 add_executable 之前，一直没暴露 —— 因为此前没有任何驱动带
# `includes` 字段，循环体渲染为空。fota_delta 是第一个（需要 vendored
# 解码器的头目录），于是 cmake configure 直接报
# "Cannot specify include directories for target ... which is not built by this project"。
add_executable(${PROJECT_NAME} ${APP_SOURCES})
{% for drv in drivers %}
{% if drv.get('includes') %}
{% for inc in drv.includes %}
target_include_directories(${PROJECT_NAME} PRIVATE {{ inc | replace('$(HARDWARE2CODE_STATIC)', '${HARDWARE2CODE_STATIC}') }})
{% endfor %}
{% endif %}
{% endfor %}
target_compile_definitions(${PROJECT_NAME} PRIVATE LWRB_DISABLE_ATOMIC)
target_include_directories(${PROJECT_NAME} PRIVATE
    ${COMMON_INCLUDES}
    ${CMAKE_SOURCE_DIR}/src
    ${CMAKE_SOURCE_DIR}/src/drivers
)
{% if has_bootloader %}
# Driver lib for app (shared with bootloader)
{% if has_log %}
target_include_directories(${PROJECT_NAME} PRIVATE ${CMAKE_SOURCE_DIR}/tools)
{% endif %}
{% endif %}

# Link HAL + FreeRTOS to main executable
target_link_libraries(${PROJECT_NAME} PRIVATE hal{% if not hil_mode %} freertos{% endif %} m)

# Disable linking step try-compile (bare-metal)
set_target_properties(${PROJECT_NAME} PROPERTIES
    SUFFIX ".elf"
    LINK_DEPENDS ${LINKER_SCRIPT}
)

# ── Post-build: generate .bin and .hex ──────────────────────────────────────
add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
    COMMAND ${CMAKE_OBJCOPY} -O binary $<TARGET_FILE:${PROJECT_NAME}>
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin
    COMMAND ${CMAKE_OBJCOPY} -O ihex $<TARGET_FILE:${PROJECT_NAME}>
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.hex
    COMMAND ${CMAKE_SIZE_UTIL} $<TARGET_FILE:${PROJECT_NAME}>
    COMMENT "Generating .bin and .hex..."
)

# ── Flash targets ───────────────────────────────────────────────────────────
# STM32_Programmer_CLI (ST-Link) — set STM32_PROG_CLI in env or cmake cache
set(STM32_PROG_CLI "$ENV{STM32_PROG_CLI}" CACHE FILEPATH "Path to STM32_Programmer_CLI")
if(NOT STM32_PROG_CLI)
    find_program(STM32_PROG_CLI STM32_Programmer_CLI)
endif()

{% if has_bootloader %}
# ── 有引导器时的烧录 ─────────────────────────────────────────────────────────
#
# ⚠️ 这两个目标此前是**错的**，而且错得很危险（fota_demo 之前从未暴露，
#    因为没有示例开启过 bootloader）：
#   · `flash` 只是一个 `echo "Flashing combined image..."` 的**空壳**，
#     什么都不烧，却打印得像成功了；
#   · `flash-daplink` 把 `${PROJECT_NAME}.bin`（**应用镜像，未打镜像头，
#     且按 Slot A 的 0x08002000 链接**）写到 **0x08000000** —— 正好覆盖
#     引导器，板子变砖。
#
# 正确做法：烧 `combined.bin`（引导器 + Slot A 应用镜像）到 0x08000000。
# 它由 `combined` 目标产出，依赖链是 bootloader → app → combined。
set(_HW2C_FLASH_IMG ${CMAKE_BINARY_DIR}/combined.bin)

add_custom_target(flash
    COMMAND "${STM32_PROG_CLI}" -c port=SWD -w ${_HW2C_FLASH_IMG} 0x08000000 -rst
    DEPENDS combined
    COMMENT "Flashing combined.bin (bootloader + slot A) via STM32_Programmer_CLI"
)

add_custom_target(flash-daplink
    COMMAND openocd -f interface/cmsis-dap.cfg -f target/stm32g0x.cfg
            -c "program ${_HW2C_FLASH_IMG} 0x08000000 verify reset exit"
    DEPENDS combined
    COMMENT "Flashing combined.bin (bootloader + slot A) via OpenOCD (CMSIS-DAP)"
)
{% else %}
add_custom_target(flash
    COMMAND "${STM32_PROG_CLI}" -c port=SWD -w ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin 0x08000000 -rst
    DEPENDS ${PROJECT_NAME}
    COMMENT "Flashing ${PROJECT_NAME}.bin via STM32_Programmer_CLI"
)

# OpenOCD / DAP-Link flash
add_custom_target(flash-daplink
    COMMAND openocd -f interface/cmsis-dap.cfg -f target/stm32g0x.cfg
            -c "program ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin 0x08000000 verify reset exit"
    DEPENDS ${PROJECT_NAME}
    COMMENT "Flashing via OpenOCD (CMSIS-DAP)"
)
{% endif %}

{% if hil_mode %}
# ── HIL test runner ──────────────────────────────────────────────────────────
add_custom_target(hil-flash
    COMMAND ${CMAKE_COMMAND} -E echo "HIL test firmware flashed. Run 'python hil_runner.py'."
    DEPENDS flash
)
{% endif %}

{% if not hil_mode %}
# ── Unit tests ───────────────────────────────────────────────────────────────
add_custom_target(test
    COMMAND python test/run_tests.py
    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
    COMMENT "Running unit tests..."
)

add_custom_target(coverage
    COMMAND python test/run_tests.py --coverage
    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
    COMMENT "Running unit tests with coverage..."
)

{% if has_bootloader %}
# ── 固件版本号（写入槽内镜像头的 fw_version 字段，24-bit）──────────────────────
#
# 这个数同时出现在**两个**地方，而两者必须一致（FR-14.7）：
#   · 镜像头 +0x0C —— 由这里写进去，引导器用它比较"哪个槽更新"
#   · 固件 banner / `version` 命令打印的 project.version —— 编译期常量
# 一旦分叉，"升级后设备报的版本号"就不再能证明镜像头里装的是哪一版；这与
# `delta_envelope.fw_version` 与镜像头不一致那次真机 E_CRC(-19) 是同源的失效
# 模式（`docs/reviews/onboard-capture-2026-09-17.txt` §7.3）。
#
# 所以默认值**派生自 task.yaml 的 project.version**（major<<16|minor<<8|patch），
# 不是常量。原先的常量 1 有两个后果：每个工程的每个版本都是 1，
# `boot_read_fw_version()` 那句"按版本挑更新的槽"永远不触发；而且升级成功也
# 看不出任何版本变化（v1.0.0 → v1.0.1 在镜像头里无法区分）。
#
# 默认值也**不写进 CMake cache**：cache 一旦写入就粘住 —— 改完 task.yaml 重新
# configure 时旧值仍会写进镜像头，而 banner / `version` 打的是新渲染出的
# project.version，于是同一块板子上出现两个版本号。
{% if project_version_packed is not defined %}
# 渲染期契约：project_version_packed 必须进入模板上下文（generator/context/builder.py）。
# 它缺失时 `--version` 会展开为空，`patch_crc.py` 的 argparse 报
# "argument --version: expected one argument"，指向完全无关的地方。
# 派生值缺失要在**生成期**就炸，别生成一个坏工程（FR-14.7）。
message(FATAL_ERROR
    "hw2c: project_version_packed 未进入模板上下文，拒绝生成 —— "
    "镜像头 fw_version 无法从 project.version 派生（见 FR-14.7）")
set(HW2C_FW_VERSION_DERIVED 0)
{% else %}
set(HW2C_FW_VERSION_DERIVED {{ project_version_packed }})
{% endif %}

# 覆盖顺序（1、2 是刻意保留的逃生口）：
#   1) 环境变量 FOTA_VERSION
#   2) 命令行 -DFW_VERSION=…
#   3) 全都缺席 → 派生自 project.version
#
# ⚠️ 判据是「值」，不是「cache 里有没有这个变量」。原因：旧模板用
#    `set(FW_VERSION "1" CACHE STRING …)` 把常量 1 写进了 cache，而 CMake 在
#    命令行给 -D 时**保留既有 cache 条目的类型**（AddCacheEntry 对 UNINITIALIZED
#    的入参沿用旧类型），所以"类型是不是 UNINITIALIZED"区分不出"用户显式指定"
#    与"旧模板留下的陈旧值"：真那样写，旧构建目录里 -DFW_VERSION=9 会被静默忽略。
#    改按值判断：1 既是旧模板的自动默认值、也正是本次要淘汰的取值，一律视为陈旧
#    并清除，其余取值照常当作显式覆盖。代价是"显式要 1"也被当作陈旧 —— 可接受，
#    因为 1 正是要消除的那个常量。覆盖来源会打进下面的 STATUS 日志，不静默。
if(DEFINED ENV{FOTA_VERSION} AND NOT "$ENV{FOTA_VERSION}" STREQUAL "")
    set(FW_VERSION "$ENV{FOTA_VERSION}")
    set(HW2C_FW_VERSION_SOURCE "环境变量 FOTA_VERSION")
elseif(DEFINED FW_VERSION AND NOT FW_VERSION STREQUAL "" AND NOT FW_VERSION STREQUAL "1")
    set(HW2C_FW_VERSION_SOURCE "命令行 -DFW_VERSION")
else()
    set(FW_VERSION "${HW2C_FW_VERSION_DERIVED}")
    set(HW2C_FW_VERSION_SOURCE "派生自 project.version = {{ project_version }}")
endif()
message(STATUS "hw2c: firmware version (image header fw_version) = ${FW_VERSION} [${HW2C_FW_VERSION_SOURCE}]")

# ── Bootloader ───────────────────────────────────────────────────────────────
# Build via external process (bootloader uses bare-metal, separate linker script)
add_custom_target(bootloader
    COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_BINARY_DIR}/bootloader
    COMMAND ${CMAKE_COMMAND} -S ${CMAKE_SOURCE_DIR}/bootloader
            -B ${CMAKE_BINARY_DIR}/bootloader
            -DCMAKE_TOOLCHAIN_FILE=${CMAKE_SOURCE_DIR}/toolchain.cmake
            -DHARDWARE2CODE_STATIC=${HARDWARE2CODE_STATIC}
            # 引导器不做任何浮点格式化：关掉 -u _printf_float/-u _scanf_float，
            # 否则 newlib 的 printf/scanf 机器会被链进来，8 KB 区域直接溢出 23 KB。
            -DHW2C_FLOAT_PRINTF=OFF
    COMMAND ${CMAKE_COMMAND} --build ${CMAKE_BINARY_DIR}/bootloader
    COMMENT "Building bootloader..."
)

# ── App image (slot A, header patched in place) ──────────────────────────────
add_custom_target(app
    COMMAND ${CMAKE_COMMAND} -E echo "Patching CRC32 + version into Slot A image..."
    COMMAND python ${CMAKE_SOURCE_DIR}/patch_crc.py
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin
            --version ${FW_VERSION}
            -o ${CMAKE_BINARY_DIR}/${PROJECT_NAME}_crc.bin
    DEPENDS ${PROJECT_NAME}
    COMMENT "Creating CRC-patched app image..."
)

# ── Combined image: Bootloader + App Slot A ──────────────────────────────────
# ── Combined image: Bootloader + App Slot A ──────────────────────────────────
# ⚠️ 填充字节写成 `bytes([255])` 而**不是** `b'\xFF'`：CMake 的双引号字符串里
#    `\x` 是非法转义序列，会让 `add_custom_target` 直接报
#    "Invalid character escape '\x'" 并导致 configure 失败。
#    这个缺陷在 fota_demo 出现之前一直存在 —— 因为此前**没有任何示例开启
#    bootloader**，整个 `has_bootloader` 分支从未被渲染过。
add_custom_target(combined
    COMMAND ${CMAKE_COMMAND} -E echo "Merging bootloader + app..."
    COMMAND python -c
            "import sys; bl=open('${CMAKE_BINARY_DIR}/bootloader/bootloader.bin','rb').read(); bl_padded=bl+bytes([255])*({{ boot_size_bytes }}-len(bl)); app=open('${CMAKE_BINARY_DIR}/${PROJECT_NAME}_crc.bin','rb').read(); open('${CMAKE_BINARY_DIR}/combined.bin','wb').write(bl_padded+app)"
    DEPENDS bootloader app
    COMMENT "Creating combined image..."
)

# ── 差分 OTA 补丁 ────────────────────────────────────────────────────────────
# 这里**故意不建** `fota-diff` / `fota-send` 目标。此前有一对，但它们是坏的：
# 调用的 `${CMAKE_SOURCE_DIR}/generator/bsdiff_tool.py` 在生成产物里根本不存在
# （生成器只把 `patch_crc.py` / `fota_format.json` 拷到产物根目录），而且
# `bsdiff_tool.py` 按规划 §11.1 已被 `delta_tool.py` 取代。
#
# `delta_tool.py` 是 Python **包内模块**（用相对导入取 `patch_crc` / `tinyuz_enc`），
# 不能像 `patch_crc.py` 那样单独拷贝出来执行。所以补丁生成走主机侧：
#
#     python -m generator.delta_tool build \
#         --old <上一版 slot 镜像> --new ${CMAKE_BINARY_DIR}/${PROJECT_NAME}_crc.bin \
#         -o ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.h2cd --version <版本号>
#
# P5（端到端）再把这一步接进 CMake —— 那时会把调用方式一并定下来，
# 而不是现在留一个从不执行、也无法执行的目标。
{% endif %}
{% endif %}

# ── Clean helper ─────────────────────────────────────────────────────────────
set_directory_properties(PROPERTIES
    ADDITIONAL_CLEAN_FILES "${CMAKE_BINARY_DIR}/*.bin;${CMAKE_BINARY_DIR}/*.hex;${CMAKE_BINARY_DIR}/*.map"
)
