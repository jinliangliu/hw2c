cmake_minimum_required(VERSION 3.20)

# ═══════════════════════════════════════════════════════════════════════════════
# Bootloader — generated by Hardware2Code
# MCU: {{ mcu.part }} (Cortex-M0+), bare-metal (no FreeRTOS)
# Size: {{ boot_config.size_kb }}KB
# ═══════════════════════════════════════════════════════════════════════════════

project(bootloader C ASM)

# ── MCU compile definitions ──────────────────────────────────────────────────
add_compile_definitions(
    {{ mcu.part | upper }}
    STM32G0B1xx
)

# ── Directories (HARDWARE2CODE_STATIC passed from parent or set here) ────────
if(NOT DEFINED HARDWARE2CODE_STATIC)
    set(HARDWARE2CODE_STATIC "{{ static_dir_absolute | replace('\\', '/') }}" CACHE PATH
        "Path to hw2c static/ directory")
endif()

set(HAL_DIR           "${HARDWARE2CODE_STATIC}/HAL")
set(CMSIS_DEVICE_DIR  "${HARDWARE2CODE_STATIC}/CMSIS/Device/ST/STM32G0xx")
set(CMSIS_CORE_DIR    "${HARDWARE2CODE_STATIC}/CMSIS/Core")
set(STARTUP_DIR       "${CMSIS_DEVICE_DIR}/Source/Templates/gcc")

set(LINKER_SCRIPT "${CMAKE_SOURCE_DIR}/../linker/bootloader.ld")
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -T${LINKER_SCRIPT}")

# ── Bootloader sources (bare-metal) ──────────────────────────────────────────
set(BOOT_SOURCES
    main.c
    boot_nvm.c
    boot_crc.c
    boot_jump.c
    ${CMSIS_DEVICE_DIR}/Source/Templates/system_stm32g0xx.c
    ${STARTUP_DIR}/startup_stm32g0b1xx.s
)

add_executable(${PROJECT_NAME} ${BOOT_SOURCES})

target_include_directories(${PROJECT_NAME} PRIVATE
    ${HAL_DIR}/Inc
    ${CMSIS_DEVICE_DIR}/Include
    ${CMSIS_CORE_DIR}
    ${CMAKE_SOURCE_DIR}
)

target_compile_options(${PROJECT_NAME} PRIVATE
    -Os -g0 -Wall
)

# ⚠️ 这里**不要**再写 `$<$<COMPILE_LANGUAGE:ASM>:${CMAKE_ASM_FLAGS}>`。
#
# CMAKE_ASM_FLAGS_INIT 是**带空格的一个字符串**（"-mcpu=cortex-m0plus -mthumb"），
# 而生成器表达式的内容不做空格切分 —— 整串会作为**单个 argv 元素**传给编译器：
#     arm-none-eabi-gcc ... "-mcpu=cortex-m0plus -mthumb" ...
# 于是 GCC 报
#     error: unrecognized -mcpu target: cortex-m0plus -mthumb
#     error: missing argument to '-march='
# 而且它只影响启动汇编 startup_stm32g0b1xx.s —— 所有 .c 都编得过，
# 错误看起来毫无头绪。
#
# 正确做法是**什么都不写**：CMAKE_ASM_FLAGS 由 CMake 自动应用于所有 target，
# 这一行既冗余又有害。根工程 CMakeLists 从不写它，所以一直没暴露。

set_target_properties(${PROJECT_NAME} PROPERTIES
    SUFFIX ".elf"
    LINK_DEPENDS ${LINKER_SCRIPT}
)

# ── Post-build: binary + size ────────────────────────────────────────────────
add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
    COMMAND ${CMAKE_OBJCOPY} -O binary $<TARGET_FILE:${PROJECT_NAME}>
            ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin
    COMMAND ${CMAKE_SIZE_UTIL} $<TARGET_FILE:${PROJECT_NAME}>
    COMMENT "Bootloader binary ready"
)

# ── Flash targets ────────────────────────────────────────────────────────────
find_program(STM32_PROG_CLI STM32_Programmer_CLI)

add_custom_target(flash
    COMMAND "${STM32_PROG_CLI}" -c port=SWD -w ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin 0x08000000 -rst
    DEPENDS ${PROJECT_NAME}
)

add_custom_target(flash-daplink
    COMMAND openocd -f interface/cmsis-dap.cfg -f target/stm32g0x.cfg
            -c "program ${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin 0x08000000 verify reset exit"
    DEPENDS ${PROJECT_NAME}
)
